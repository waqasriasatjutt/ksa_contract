<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_commission" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.commission</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Commission" string="Commission" name="way4tech_commission">
                    <block title="Commission Defaults" name="commission_setting_container">
                        <setting string="Default Commission Rate" help="Default commission rate applied to new receipts">
                            <field name="commission_default_rate"/>
                        </setting>
                        <setting string="Receipt Journal" help="Journal for receipt entries">
                            <field name="commission_receipt_journal_id" options="{'no_create': True}"/>
                        </setting>
                        <setting string="Customer Deposit Account" help="Customer deposit / trust account (Cr on receipt)">
                            <field name="commission_liability_account_id" options="{'no_create': True}"/>
                        </setting>
                        <setting string="Cash/Bank Account" help="Cash/Bank account (Dr on receipt)">
                            <field name="commission_cash_account_id" options="{'no_create': True}"/>
                        </setting>
                        <setting string="Commission Income Account" help="Revenue account for commission income">
                            <field name="commission_income_account_id" options="{'no_create': True}"/>
                        </setting>
                        <setting string="Subcontractor Payable Account" help="Payable account for subcontractors">
                            <field name="commission_subcontractor_payable_account_id" options="{'no_create': True}"/>
                        </setting>
                        <setting string="Default VAT Tax" help="VAT tax applied to commission only (KSA: 15%)">
                            <field name="commission_default_tax_id" options="{'no_create': True}"/>
                        </setting>
                        <setting string="Commission Product" help="Product used on commission invoices">
                            <field name="commission_default_product_id" options="{'no_create': True}"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
