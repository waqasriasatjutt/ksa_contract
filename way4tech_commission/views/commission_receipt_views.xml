<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_commission_receipt_form" model="ir.ui.view">
        <field name="name">commission.receipt.form</field>
        <field name="model">commission.receipt</field>
        <field name="arch" type="xml">
            <form string="Commission Receipt">
                <header>
                    <button name="action_confirm" string="Confirm &amp; Record Receipt" type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"
                            groups="way4tech_commission.group_commission_user"
                            confirm="This will create a journal entry recording the full amount as a liability. Continue?"/>

                    <button name="action_generate_commission_invoice" string="Generate Commission Invoice"
                            type="object" class="btn-primary"
                            invisible="state != 'confirmed'"
                            groups="way4tech_commission.group_commission_user"/>
                    <button name="action_settle" string="Settle" type="object"
                            class="btn-primary"
                            invisible="state != 'invoiced'"
                            groups="way4tech_commission.group_commission_manager"
                            confirm="This will create the settlement entry clearing the liability. Continue?"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('settled', 'cancelled')"
                            groups="way4tech_commission.group_commission_manager"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,invoiced,settled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_receipt_entry" type="object"
                                class="oe_stat_button" icon="fa-book"
                                invisible="not receipt_move_id">
                            <span class="o_stat_text">Receipt Entry</span>
                        </button>
                        <button name="action_view_commission_invoice" type="object"
                                class="oe_stat_button" icon="fa-file-text-o"
                                invisible="not commission_invoice_id">
                            <span class="o_stat_text">Commission Invoice</span>
                        </button>
                        <button name="action_view_settlement_entry" type="object"
                                class="oe_stat_button" icon="fa-check-circle"
                                invisible="not settlement_move_id">
                            <span class="o_stat_text">Settlement</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="General">
                            <field name="date"/>
                            <field name="partner_id" options="{'no_create': True}"/>
                            <field name="subcontractor_id" options="{'no_create': True}"/>
                            <field name="analytic_account_id" options="{'no_create': True}"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Financial">
                            <field name="total_amount"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="vat_included"/>
                            <field name="vat_rate"/>
                            <field name="vat_amount" readonly="1"/>
                            <field name="amount_excl_vat" readonly="1"/>
                            <field name="commission_rate"/>
                        </group>
                    </group>

                    <!-- Commission Calculation Summary -->
                    <div class="o_group">
                        <div class="o_wrap_field o_field_widget">
                            <table class="table table-sm table-bordered" style="max-width: 500px;">
                                <tr class="table-light">
                                    <td colspan="2">
                                        <strong>Commission Summary</strong>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Total Received:</td>
                                    <td class="text-end">
                                        <field name="total_amount" readonly="1"
                                               options='{"no_open": true}'/>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Amount (Excl. VAT):</td>
                                    <td class="text-end">
                                        <field name="amount_excl_vat" readonly="1"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Commission (<field name="commission_rate" readonly="1" nolabel="1"/>%):
                                    </td>
                                    <td class="text-end">
                                        <field name="commission_amount" readonly="1"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td>VAT on Commission:</td>
                                    <td class="text-end">
                                        <field name="commission_vat_amount" readonly="1"/>
                                    </td>
                                </tr>
                                <tr class="table-info">
                                    <td>
                                        <strong>Commission + VAT:</strong>
                                    </td>
                                    <td class="text-end">
                                        <strong>
                                            <field name="commission_total" readonly="1"/>
                                        </strong>
                                    </td>
                                </tr>
                                <tr class="table-success">
                                    <td>
                                        <strong>Subcontractor Payable:</strong>
                                    </td>
                                    <td class="text-end">
                                        <strong>
                                            <field name="subcontractor_payable" readonly="1"/>
                                        </strong>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <notebook>
                        <page string="Accounting" name="accounting">
                            <group>
                                <group string="Receipt">
                                    <field name="receipt_journal_id" options="{'no_create': True}"/>
                                    <field name="cash_account_id" options="{'no_create': True}"/>
                                    <field name="liability_account_id" options="{'no_create': True}"/>
                                </group>
                                <group string="Commission">
                                    <field name="commission_income_account_id" options="{'no_create': True}"/>
                                    <field name="commission_tax_id" options="{'no_create': True}"/>
                                    <field name="commission_product_id" options="{'no_create': True}"/>
                                    <field name="subcontractor_payable_account_id" options="{'no_create': True}"/>
                                </group>
                            </group>
                        </page>
                        <page string="Breakdown" name="breakdown">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="description"/>
                                    <field name="amount"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Internal notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_commission_receipt_list" model="ir.ui.view">
        <field name="name">commission.receipt.list</field>
        <field name="model">commission.receipt</field>
        <field name="arch" type="xml">
            <list string="Commission Receipts"
                  decoration-success="state == 'settled'"
                  decoration-info="state == 'invoiced'"
                  decoration-warning="state == 'confirmed'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="subcontractor_id" optional="show"/>
                <field name="total_amount" sum="Total"/>
                <field name="commission_rate"/>
                <field name="commission_amount" sum="Total Commission"/>
                <field name="commission_total" sum="Total Commission + VAT"/>
                <field name="subcontractor_payable" sum="Total Payable"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'settled'"
                       decoration-info="state == 'invoiced'"
                       decoration-warning="state == 'confirmed'"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_commission_receipt_search" model="ir.ui.view">
        <field name="name">commission.receipt.search</field>
        <field name="model">commission.receipt</field>
        <field name="arch" type="xml">
            <search string="Commission Receipts">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="subcontractor_id"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Invoiced" name="invoiced" domain="[('state', '=', 'invoiced')]"/>
                <filter string="Settled" name="settled" domain="[('state', '=', 'settled')]"/>
                <separator/>

<!--                <group expand="0" string="Group By">-->
<!--                    <filter string="Customer" name="group_partner" context="{'group_by': 'partner_id'}"/>-->
<!--                    <filter string="Subcontractor" name="group_sub" context="{'group_by': 'subcontractor_id'}"/>-->
<!--                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>-->
<!--                    <filter string="Month" name="group_month" context="{'group_by': 'date:month'}"/>-->
<!--                    <filter string="Year" name="group_year" context="{'group_by': 'date:year'}"/>-->
<!--                </group>-->
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_commission_receipt" model="ir.actions.act_window">
        <field name="name">Commission Receipts</field>
        <field name="res_model">commission.receipt</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Commission Receipt
            </p>
            <p>
                Record full customer receipts as liability, automatically calculate
                your commission, generate invoices with VAT on commission only,
                and track subcontractor payables.
            </p>
        </field>
    </record>
</odoo>
