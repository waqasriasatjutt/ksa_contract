<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- PDF Report per receipt -->
    <record id="action_report_commission_receipt" model="ir.actions.report">
        <field name="name">Commission Statement</field>
        <field name="model">commission.receipt</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">way4tech_commission.report_commission_receipt</field>
        <field name="report_file">way4tech_commission.report_commission_receipt</field>
        <field name="print_report_name">'Commission - %s' % object.name</field>
        <field name="binding_model_id" ref="model_commission_receipt"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

    <!-- Summary report action (wizard-based) -->
    <record id="action_commission_report" model="ir.actions.act_window">
        <field name="name">Commission Report</field>
        <field name="res_model">commission.receipt</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_this_month': 1}</field>
    </record>
</odoo>
