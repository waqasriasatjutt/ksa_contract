<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_commission_receipt">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <!-- Header -->
                        <div class="row mb-4">
                            <div class="col-7">
                                <h2>Commission Statement</h2>
                                <h4 t-field="o.name"/>
                            </div>
                            <div class="col-5 text-end">
                                <table class="table table-sm table-borderless">
                                    <tr>
                                        <td><strong>Date:</strong></td>
                                        <td t-field="o.date"/>
                                    </tr>
                                    <tr>
                                        <td><strong>Status:</strong></td>
                                        <td><span t-field="o.state"/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Parties -->
                        <div class="row mb-4">
                            <div class="col-6">
                                <strong>Customer:</strong>
                                <address t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["name", "address"]}'/>
                            </div>
                            <div class="col-6" t-if="o.subcontractor_id">
                                <strong>Subcontractor:</strong>
                                <address t-field="o.subcontractor_id" t-options='{"widget": "contact", "fields": ["name", "address"]}'/>
                            </div>
                        </div>

                        <!-- Breakdown lines if any -->
                        <t t-if="o.line_ids">
                            <table class="table table-sm table-bordered mb-4">
                                <thead class="table-light">
                                    <tr>
                                        <th>Description</th>
                                        <th class="text-end">Amount</th>
                                        <th>Note</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="o.line_ids" t-as="line">
                                        <tr>
                                            <td t-field="line.description"/>
                                            <td class="text-end" t-field="line.amount"
                                                t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                            <td t-field="line.note"/>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>

                        <!-- Financial Summary -->
                        <div class="row">
                            <div class="col-6 offset-6">
                                <table class="table table-sm table-bordered">
                                    <tr>
                                        <td>Total Amount Received:</td>
                                        <td class="text-end" t-field="o.total_amount"
                                            t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </tr>
                                    <tr t-if="o.vat_included">
                                        <td>VAT (<span t-out="o.vat_rate"/>%):</td>
                                        <td class="text-end" t-field="o.vat_amount"
                                            t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </tr>
                                    <tr>
                                        <td>Amount (Excl. VAT):</td>
                                        <td class="text-end" t-field="o.amount_excl_vat"
                                            t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </tr>
                                    <tr class="table-warning">
                                        <td>Commission (<span t-out="o.commission_rate"/>%):</td>
                                        <td class="text-end" t-field="o.commission_amount"
                                            t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </tr>
                                    <tr t-if="o.commission_vat_amount">
                                        <td>VAT on Commission:</td>
                                        <td class="text-end" t-field="o.commission_vat_amount"
                                            t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </tr>
                                    <tr class="table-info">
                                        <td><strong>Total Commission + VAT:</strong></td>
                                        <td class="text-end fw-bold" t-field="o.commission_total"
                                            t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </tr>
                                    <tr class="table-success">
                                        <td><strong>Subcontractor Payable:</strong></td>
                                        <td class="text-end fw-bold" t-field="o.subcontractor_payable"
                                            t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Document References -->
                        <div class="row mt-3" t-if="o.receipt_move_id or o.commission_invoice_id or o.settlement_move_id">
                            <div class="col-12">
                                <strong>Accounting Documents:</strong>
                                <ul>
                                    <li t-if="o.receipt_move_id">
                                        Receipt Entry: <span t-field="o.receipt_move_id.name"/>
                                    </li>
                                    <li t-if="o.commission_invoice_id">
                                        Commission Invoice: <span t-field="o.commission_invoice_id.name"/>
                                    </li>
                                    <li t-if="o.settlement_move_id">
                                        Settlement Entry: <span t-field="o.settlement_move_id.name"/>
                                    </li>
                                </ul>
                            </div>
                        </div>

                        <t t-if="o.notes">
                            <div class="mt-3">
                                <strong>Notes:</strong>
                                <p t-field="o.notes"/>
                            </div>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
