<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View for standalone access -->
    <record id="view_rider_payroll_line_list" model="ir.ui.view">
        <field name="name">rider.payroll.line.list</field>
        <field name="model">rider.payroll.line</field>
        <field name="arch" type="xml">
            <list string="Rider Lines"
                  decoration-danger="net_payable &lt; 0"
                  decoration-muted="state == 'posted'">
                <field name="batch_id"/>
                <field name="name"/>
                <field name="rider_type" widget="badge"
                       decoration-info="rider_type == 'employee'"
                       decoration-warning="rider_type == 'freelancer'"/>
                <field name="fixed_salary"/>
                <field name="order_earnings"/>
                <field name="bonus" optional="show"/>
                <field name="petrol" optional="show"/>
                <field name="deduction" optional="show"/>
                <field name="advance_deduction" optional="show"/>
                <field name="fine" optional="show"/>
                <field name="net_payable" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'posted'"
                       decoration-warning="state == 'validated'"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_rider_payroll_line_search" model="ir.ui.view">
        <field name="name">rider.payroll.line.search</field>
        <field name="model">rider.payroll.line</field>
        <field name="arch" type="xml">
            <search string="Rider Lines">
                <field name="name"/>
                <field name="batch_id"/>
                <separator/>
                <filter string="Company Riders" name="employees"
                        domain="[('rider_type', '=', 'employee')]"/>
                <filter string="Freelancers" name="freelancers"
                        domain="[('rider_type', '=', 'freelancer')]"/>
                <group expand="0" string="Group By">
                    <filter string="Batch" name="group_batch" context="{'group_by': 'batch_id'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'rider_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_rider_payroll_line" model="ir.actions.act_window">
        <field name="name">All Rider Lines</field>
        <field name="res_model">rider.payroll.line</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
