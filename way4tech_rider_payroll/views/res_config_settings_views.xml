<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_rider_payroll" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.rider.payroll</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Rider Payroll" string="Rider Payroll" name="way4tech_rider_payroll">
                    <block title="Rider Payroll Defaults" name="rider_payroll_setting_container">
                        <setting string="Payroll Journal" help="Default journal for payroll batches">
                            <field name="rider_payroll_journal_id" options="{'no_create': True}"/>
                        </setting>
                        <setting string="Salary Expense Account" help="Default expense account (Dr) for company rider salaries">
                            <field name="rider_payroll_salary_account_id" options="{'no_create': True}"/>
                        </setting>
                        <setting string="Salary Payable Account" help="Default payable account (Cr) for salaries payable">
                            <field name="rider_payroll_salary_payable_account_id" options="{'no_create': True}"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
