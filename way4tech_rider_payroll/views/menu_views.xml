<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Top-level app menu -->
    <menuitem id="menu_rider_payroll_root"
              name="Rider Payroll"
              sequence="80"
              groups="way4tech_rider_payroll.group_rider_payroll_user"/>

    <!-- Main sections -->
    <menuitem id="menu_rider_payroll_main"
              name="Payroll"
              parent="menu_rider_payroll_root"
              sequence="10"/>

    <menuitem id="menu_rider_payroll_batch"
              name="Payroll Batches"
              parent="menu_rider_payroll_main"
              action="action_rider_payroll_batch"
              sequence="10"/>

    <menuitem id="menu_rider_payroll_import"
              name="Import from Excel"
              parent="menu_rider_payroll_main"
              action="action_rider_import_wizard"
              sequence="20"
              groups="way4tech_rider_payroll.group_rider_payroll_user"/>

    <menuitem id="menu_rider_payroll_lines"
              name="All Rider Lines"
              parent="menu_rider_payroll_main"
              action="action_rider_payroll_line"
              sequence="30"/>

    <!-- Configuration -->
    <menuitem id="menu_rider_payroll_config"
              name="Configuration"
              parent="menu_rider_payroll_root"
              sequence="90"
              groups="way4tech_rider_payroll.group_rider_payroll_manager"/>

    <menuitem id="menu_rider_payroll_settings"
              name="Settings"
              parent="menu_rider_payroll_config"
              action="base_setup.action_general_configuration"
              sequence="10"
              groups="way4tech_rider_payroll.group_rider_payroll_manager"/>
</odoo>
