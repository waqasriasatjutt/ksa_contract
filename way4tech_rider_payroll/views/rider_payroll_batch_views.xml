<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_rider_payroll_batch_form" model="ir.ui.view">
        <field name="name">rider.payroll.batch.form</field>
        <field name="model">rider.payroll.batch</field>
        <field name="arch" type="xml">
            <form string="Rider Payroll Batch">
                <header>
                    <button name="action_validate" string="Validate" type="object"
                            class="btn-primary"
                            invisible="state not in ('draft', 'imported')"
                            groups="way4tech_rider_payroll.group_rider_payroll_manager"/>
                    <button name="action_post" string="Post &amp; Generate Entries" type="object"
                            class="btn-primary"
                            invisible="state != 'validated'"
                            groups="way4tech_rider_payroll.group_rider_payroll_manager"
                            confirm="This will create journal entries for company riders and vendor bills for freelancers. Continue?"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('posted', 'cancelled')"
                            groups="way4tech_rider_payroll.group_rider_payroll_manager"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,imported,validated,posted"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_journal_entries" type="object"
                                class="oe_stat_button" icon="fa-book"
                                invisible="move_count == 0">
                            <field name="move_count" widget="statinfo" string="Entries"/>
                        </button>
                        <button name="action_view_vendor_bills" type="object"
                                class="oe_stat_button" icon="fa-file-text-o"
                                invisible="bill_count == 0">
                            <field name="bill_count" widget="statinfo" string="Bills"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="General Information">
                            <field name="client_id" options="{'no_create': True}"/>
                            <field name="date"/>
                            <field name="period_start"/>
                            <field name="period_end"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Accounting Configuration">
                            <field name="journal_id" options="{'no_create': True}"/>
                            <field name="salary_account_id" options="{'no_create': True}"/>
                            <field name="salary_payable_account_id" options="{'no_create': True}"/>
                            <field name="analytic_account_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Rider Lines" name="rider_lines">
                            <field name="line_ids" widget="one2many" mode="list"
                                   context="{'default_batch_id': id}">
                                <list string="Rider Lines" editable="bottom"
                                      decoration-danger="has_error or net_payable &lt; 0"
                                      decoration-warning="rider_type == 'freelancer' and not vendor_id"
                                      decoration-muted="state == 'posted'">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="rider_type" widget="badge"
                                           decoration-info="rider_type == 'employee'"
                                           decoration-warning="rider_type == 'freelancer'"/>
                                    <field name="employee_id" optional="show"
                                           column_invisible="True"/>
                                    <field name="vendor_id" optional="show"
                                           column_invisible="True"/>
                                    <field name="fixed_salary"/>
                                    <field name="order_earnings"/>
                                    <field name="bonus" optional="show"/>
                                    <field name="petrol" optional="show"/>
                                    <field name="deduction" optional="show"/>
                                    <field name="advance_deduction" optional="show"/>
                                    <field name="fine" optional="show"/>
                                    <field name="gross_earnings" optional="show"/>
                                    <field name="total_deductions" optional="show"/>
                                    <field name="net_payable" sum="Total Net Payable"/>
                                    <field name="analytic_account_id" optional="hide"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'posted'"
                                           decoration-warning="state == 'validated'"
                                           decoration-muted="state == 'draft'"/>
                                    <field name="note" optional="show"/>
                                    <field name="has_error" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                        <page string="Summary" name="summary">
                            <group>
                                <group string="Headcount">
                                    <field name="rider_count"/>
                                    <field name="employee_count"/>
                                    <field name="freelancer_count"/>
                                </group>
                                <group string="Financial Summary">
                                    <field name="total_fixed_salary"/>
                                    <field name="total_order_earnings"/>
                                    <field name="total_bonus"/>
                                    <field name="total_petrol"/>
                                    <field name="total_deductions"/>
                                    <field name="total_net_payable"/>
                                </group>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Internal notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_rider_payroll_batch_list" model="ir.ui.view">
        <field name="name">rider.payroll.batch.list</field>
        <field name="model">rider.payroll.batch</field>
        <field name="arch" type="xml">
            <list string="Rider Payroll Batches"
                  decoration-success="state == 'posted'"
                  decoration-warning="state == 'validated'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="date"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="client_id"/>
                <field name="rider_count"/>
                <field name="total_net_payable"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'posted'"
                       decoration-warning="state in ('validated', 'imported')"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_rider_payroll_batch_search" model="ir.ui.view">
        <field name="name">rider.payroll.batch.search</field>
        <field name="model">rider.payroll.batch</field>
        <field name="arch" type="xml">
            <search string="Rider Payroll Batches">
                <field name="name"/>
                <field name="client_id"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Imported" name="imported" domain="[('state', '=', 'imported')]"/>
                <filter string="Validated" name="validated" domain="[('state', '=', 'validated')]"/>
                <filter string="Posted" name="posted" domain="[('state', '=', 'posted')]"/>
                <separator/>
<!--                <filter string="This Month" name="this_month"-->
<!--                        domain="[('date', '&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d')),-->
<!--                                 ('date', '&lt;=', (context_today() + relativedelta(day=31)).strftime('%Y-%m-%d'))]"/>-->
<!--                <group expand="0" string="Group By">-->
<!--                    <filter string="Client" name="group_client" context="{'group_by': 'client_id'}"/>-->
<!--                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>-->
<!--                    <filter string="Month" name="group_month" context="{'group_by': 'date:month'}"/>-->
<!--                </group>-->
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_rider_payroll_batch" model="ir.actions.act_window">
        <field name="name">Rider Payroll Batches</field>
        <field name="res_model">rider.payroll.batch</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Rider Payroll Batch
            </p>
            <p>
                Import rider salary sheets from Excel or create batches manually.
                The system automatically generates payslip journal entries for company
                riders and vendor bills for freelancers.
            </p>
        </field>
    </record>
</odoo>
