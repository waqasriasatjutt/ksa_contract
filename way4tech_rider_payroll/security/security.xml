<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Security Groups -->
        <record id="group_rider_payroll_user" model="res.groups">
            <field name="name">Rider Payroll / User</field>
            <field name="category_id" ref="base.module_category_human_resources_payroll"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_rider_payroll_manager" model="res.groups">
            <field name="name">Rider Payroll / Manager</field>
            <field name="category_id" ref="base.module_category_human_resources_payroll"/>
            <field name="implied_ids" eval="[(4, ref('group_rider_payroll_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
