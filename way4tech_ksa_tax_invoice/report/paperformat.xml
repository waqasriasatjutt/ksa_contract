<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_ksa_tax_invoice" model="report.paperformat">
        <field name="name">ATCO A4 (KSA Letterhead)</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <!-- margin_top stays small: the Tax Invoice letterhead repeats via the
             master-table thead in the report body (see tax_invoice_report.xml),
             which lives in the content flow, so no reserved top band is needed —
             this is just the breathing space above it. Item 1 (2026-08):
             margin_bottom widened from 20 to 30 for the footer image band.
             2026-10-03: 6mm read as ~17pt of blank page above the letterhead,
             which the client measured against a reference invoice that starts
             at the top. 2026-10-08: 2mm was too close to the edge for an
             office printer, so 5mm, and the same 5mm top / 6mm sides are used
             by every report including the landscape ones. -->
        <field name="margin_top">5</field>
        <field name="margin_bottom">30</field>
        <field name="margin_left">6</field>
        <field name="margin_right">6</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>
</odoo>
