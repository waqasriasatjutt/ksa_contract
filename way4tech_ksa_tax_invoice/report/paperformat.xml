<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_ksa_tax_invoice" model="report.paperformat">
        <field name="name">ATCO A4 (KSA Letterhead)</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <!-- margin_top stays small: the letterhead now repeats via a table
             thead at the top of the body flow (see external_layout.xml), NOT the
             header slot, so it needs no reserved top band — this is just the
             breathing space above it. Item 1 (2026-08): margin_bottom widened
             from 20 to 30 so the footer image / dynamic footer has room without
             clipping. -->
        <field name="margin_top">6</field>
        <field name="margin_bottom">30</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">2</field>
        <field name="dpi">90</field>
    </record>
</odoo>
