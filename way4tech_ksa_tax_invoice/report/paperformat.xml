<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_ksa_tax_invoice" model="report.paperformat">
        <field name="name">ATCO A4 (KSA Letterhead)</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <!-- Item 2 (2026-08): the letterhead moved from inline-in-body to the
             repeating header slot, so margin_top now reserves a band tall enough
             to hold it on every page (was 6, when the header lived in the body).
             margin_bottom likewise widened to hold the footer image / dynamic
             footer without clipping (was 20). -->
        <field name="margin_top">46</field>
        <field name="margin_bottom">30</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">2</field>
        <field name="dpi">90</field>
    </record>
</odoo>
