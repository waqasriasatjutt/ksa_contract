<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_ksa_tax_invoice" model="report.paperformat">
        <field name="name">ATCO A4 (KSA Letterhead)</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <!-- margin_top stays small: the Tax Invoice letterhead repeats via the
             master-table thead in the report body (see tax_invoice_report.xml),
             which lives in the content flow, so no reserved top band is needed —
             this is just the breathing space above it. Item 1 (2026-08):
             margin_bottom widened from 20 to 30 for the footer image band. -->
        <field name="margin_top">6</field>
        <field name="margin_bottom">30</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">2</field>
        <field name="dpi">90</field>
    </record>
</odoo>
