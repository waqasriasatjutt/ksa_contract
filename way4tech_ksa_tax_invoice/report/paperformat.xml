<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_ksa_tax_invoice" model="report.paperformat">
        <field name="name">ATCO A4 (KSA Letterhead)</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <!-- Item 2 (2026-08): the letterhead is a position:fixed block pinned to
             the page top and repeated on every page (see external_layout.xml).
             margin_top reserves the band it occupies so the flowing body starts
             below it on every page (no overlap); sized for the taller dynamic
             3-part header (was 6 with the old page-1-only inline header). Item 1:
             margin_bottom widened from 20 to 30 for the footer image band. -->
        <field name="margin_top">56</field>
        <field name="margin_bottom">30</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">2</field>
        <field name="dpi">90</field>
    </record>
</odoo>
