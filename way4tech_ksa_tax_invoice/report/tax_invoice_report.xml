<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="ksa_tax_invoice_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="doc" t-value="o"/>
                <t t-set="company" t-value="o.company_id"/>
                <t t-set="disable_atco_address_layout" t-value="True"/>
                <t t-set="layout_document_title" t-value="''"/>
                <t t-call="web.external_layout">
                    <t t-set="cp" t-value="company.partner_id"/>
                    <t t-set="bp" t-value="o.partner_id"/>
                    <t t-set="bank" t-value="cp.bank_ids[:1]"/>
                    <t t-set="m" t-value="lambda v: '{:,.2f}'.format(v or 0.0)"/>
                    <!-- Convert Western digits 0-9 to Eastern-Arabic ٠-٩ for values
                         rendered in the Arabic data columns (VAT, CRN, Postal Code,
                         Building No, Additional No). English column stays 0-9. -->
                    <t t-set="ar_digits" t-value="lambda s: (s or '').replace('0','٠').replace('1','١').replace('2','٢').replace('3','٣').replace('4','٤').replace('5','٥').replace('6','٦').replace('7','٧').replace('8','٨').replace('9','٩') if s else ''"/>
                    <div class="page ksa-inv">
                        <style>
                            .ksa-inv { font-family: 'DejaVu Sans', Arial, sans-serif; font-size: 8.5px; color:#1a1a1a; width:100%; line-height:1.5; }
                            .ksa-inv table { border-collapse: collapse; width:100%; }
                            .ksa-inv td, .ksa-inv th { border:1px solid #d0cdcd; padding:5px 8px; vertical-align:middle; height:16px; }
                            .ksa-inv td:empty:after { content:"\00a0"; white-space:pre; }
                            .ksa-red { color:#8a1c1c; }
                            .ksa-b { font-weight:bold; }
                            .ksa-ar { direction:rtl; text-align:right; letter-spacing:normal; }
                            .ksa-title { background:#8a1c1c; color:#fff; text-align:center; font-size:15px; font-weight:bold; padding:10px 8px; }
                            .ksa-title .en { letter-spacing:2px; }
                            .ksa-title .ar { margin-left:22px; }
                            .ksa-sec { background:#f4e9e9; color:#8a1c1c; font-weight:bold; border:1px solid #8a1c1c; padding:8px 10px; font-size:10px; line-height:1.4; overflow:hidden; }
                            /* Slate-blue section header for Vendor / Customer blocks. */
                            .ksa-sec-slate { background:#475569; color:#ffffff; font-weight:bold; border:1px solid #334155; padding:7px 10px; font-size:10px; line-height:1.4; overflow:hidden; letter-spacing:0.3px; }
                            /* Side-by-side wrapper for Vendor + Customer blocks. Uses a table
                               (not flex) — wkhtmltopdf 0.12 does not support flex layout. */
                            .ksa-vc-wrap { width:100%; border-collapse:separate; border-spacing:6px 0; margin-top:3px; }
                            .ksa-vc-wrap > tbody > tr > td { width:50%; vertical-align:top; padding:0; border:0; }
                            .ksa-vc-wrap .vc-block table { border-collapse:collapse; width:100%; }
                            .ksa-vc-wrap .vc-block td, .ksa-vc-wrap .vc-block th { border:1px solid #d0cdcd; padding:4px 6px; height:15px; vertical-align:middle; }
                            .ksa-inv .lbl { color:#8a1c1c; font-weight:bold; white-space:nowrap; }
                            .ksa-inv .noborder td { border:0; padding:3px 4px; }
                            .ksa-th { background:#8a1c1c; color:#fff; font-weight:bold; text-align:center; font-size:7.5px; line-height:1.4; }
                            .ksa-lines td { padding:9px 8px; vertical-align:middle; }
                            .ksa-lines th { padding:8px 7px; }
                            .ksa-lines tr.zebra td { background:#faf6f6; }
                            /* Full-width note row rendered when a line has display_type='line_note'.
                               Sits directly beneath the item line it was added to, spanning all 10 columns. */
                            .ksa-lines tr.ksa-note-row td.ksa-note {
                                background:#fff8f8;
                                color:#333;
                                font-style:italic;
                                text-align:left;
                                padding:8px 12px;
                                border-top:1px dashed #d0cdcd;
                                white-space:pre-wrap;
                            }
                            .ksa-right { text-align:right; }
                            .ksa-center { text-align:center; }
                        </style>

                        <!-- ══ TITLE ══ (kept here because ATCO letterhead does not include "TAX INVOICE" wording) -->
                        <div class="ksa-title"><span class="en">TAX&#160;&#160;INVOICE</span><span class="ar">فاتورة ضريبية</span></div>

                        <!-- ══ INVOICE NO ══ -->
                        <table style="margin-top:3px;"><tr>
                            <td class="ksa-red ksa-b" style="border:0;">Invoice No: <span t-esc="o.name"/></td>
                            <td class="ksa-red ksa-b ksa-ar" style="border:0;">رقم الفاتورة</td>
                        </tr></table>

                        <!-- ══ VENDOR + CUSTOMER SIDE-BY-SIDE GRID ══
                             Two blocks placed as a 2-column outer table. Each block has a
                             slate-blue section header and a 4-column bilingual grid:
                               EN label | EN value | AR value | AR label. -->
                        <table class="ksa-vc-wrap">
                            <tr>
                                <td>
                                    <div class="vc-block">
                                        <div class="ksa-sec-slate"><span>Vendor Details</span><span style="float:right;">المورد</span></div>
                                        <table>
                                            <tr><td class="lbl" style="width:22%;">Name:</td><td style="width:28%;" t-esc="company.name"/><td style="width:28%;" class="ksa-ar" t-esc="company.x_name_ar or cp.x_name_ar or company.name"/><td class="lbl ksa-ar" style="width:22%;">الاسم</td></tr>
                                            <tr><td class="lbl">Street:</td><td t-esc="cp.street or ''"/><td class="ksa-ar" t-esc="cp.x_street_ar or cp.street or ''"/><td class="lbl ksa-ar">اسم الشارع</td></tr>
                                            <tr><td class="lbl">Building No:</td><td t-esc="cp.x_building_no or ''"/><td class="ksa-ar" t-esc="ar_digits(cp.x_building_no or '')"/><td class="lbl ksa-ar">رقم المبنى</td></tr>
                                            <tr><td class="lbl">City:</td><td t-esc="cp.city or ''"/><td class="ksa-ar" t-esc="cp.x_city_ar or cp.city or ''"/><td class="lbl ksa-ar">المدينة</td></tr>
                                            <tr><td class="lbl">District:</td><td t-esc="cp.x_district or cp.state_id.name or ''"/><td class="ksa-ar" t-esc="cp.x_district_ar or cp.state_id.name or ''"/><td class="lbl ksa-ar">الحي</td></tr>
                                            <tr><td class="lbl">Addl. No:</td><td t-esc="cp.x_additional_no or ''"/><td class="ksa-ar" t-esc="ar_digits(cp.x_additional_no or '')"/><td class="lbl ksa-ar">الرقم الإضافي</td></tr>
                                            <tr><td class="lbl">Postal Code:</td><td t-esc="cp.zip or ''"/><td class="ksa-ar" t-esc="ar_digits(cp.zip or '')"/><td class="lbl ksa-ar">الرمز البريدي</td></tr>
                                            <tr><td class="lbl">Country:</td><td t-esc="cp.country_id.name or ''"/><td class="ksa-ar" t-esc="cp.x_country_ar or cp.country_id.name or ''"/><td class="lbl ksa-ar">البلد</td></tr>
                                            <tr><td class="lbl">VAT:</td><td class="ksa-b" t-esc="cp.vat or ''"/><td class="ksa-ar ksa-b" t-esc="ar_digits(cp.vat or '')"/><td class="lbl ksa-ar">الرقم الضريبي</td></tr>
                                            <tr><td class="lbl">CRN:</td><td class="ksa-b" t-esc="cp.company_registry or ''"/><td class="ksa-ar ksa-b" t-esc="ar_digits(cp.company_registry or '')"/><td class="lbl ksa-ar">السجل التجاري</td></tr>
                                        </table>
                                    </div>
                                </td>
                                <td>
                                    <div class="vc-block">
                                        <div class="ksa-sec-slate"><span>Customer Details</span><span style="float:right;">تفاصيل شركة العميل</span></div>
                                        <table>
                                            <tr><td class="lbl" style="width:22%;">Name:</td><td style="width:28%;" t-esc="bp.name or ''"/><td style="width:28%;" class="ksa-ar" t-esc="bp.x_name_ar or bp.name or ''"/><td class="lbl ksa-ar" style="width:22%;">الاسم</td></tr>
                                            <tr><td class="lbl">Street:</td><td t-esc="bp.street or ''"/><td class="ksa-ar" t-esc="bp.x_street_ar or bp.street or ''"/><td class="lbl ksa-ar">اسم الشارع</td></tr>
                                            <tr><td class="lbl">Building No:</td><td t-esc="bp.x_building_no or ''"/><td class="ksa-ar" t-esc="ar_digits(bp.x_building_no or '')"/><td class="lbl ksa-ar">رقم المبنى</td></tr>
                                            <tr><td class="lbl">City:</td><td t-esc="bp.city or ''"/><td class="ksa-ar" t-esc="bp.x_city_ar or bp.city or ''"/><td class="lbl ksa-ar">المدينة</td></tr>
                                            <tr><td class="lbl">District:</td><td t-esc="bp.x_district or bp.state_id.name or ''"/><td class="ksa-ar" t-esc="bp.x_district_ar or bp.state_id.name or ''"/><td class="lbl ksa-ar">الحي</td></tr>
                                            <tr><td class="lbl">Addl. No:</td><td t-esc="bp.x_additional_no or ''"/><td class="ksa-ar" t-esc="ar_digits(bp.x_additional_no or '')"/><td class="lbl ksa-ar">الرقم الإضافي</td></tr>
                                            <tr><td class="lbl">Postal Code:</td><td t-esc="bp.zip or ''"/><td class="ksa-ar" t-esc="ar_digits(bp.zip or '')"/><td class="lbl ksa-ar">الرمز البريدي</td></tr>
                                            <tr><td class="lbl">Country:</td><td t-esc="bp.country_id.name or ''"/><td class="ksa-ar" t-esc="bp.x_country_ar or bp.country_id.name or ''"/><td class="lbl ksa-ar">البلد</td></tr>
                                            <tr><td class="lbl">VAT:</td><td class="ksa-b" t-esc="bp.vat or ''"/><td class="ksa-ar ksa-b" t-esc="ar_digits(bp.vat or '')"/><td class="lbl ksa-ar">الرقم الضريبي</td></tr>
                                            <tr><td class="lbl">CRN:</td><td class="ksa-b" t-esc="bp.company_registry or ''"/><td class="ksa-ar ksa-b" t-esc="ar_digits(bp.company_registry or '')"/><td class="lbl ksa-ar">السجل التجاري</td></tr>
                                        </table>
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <!-- ══ META ══ -->
                        <table style="margin-top:3px; text-align:center;">
                            <tr>
                                <td class="lbl">Invoice Date<div class="ksa-ar">تاريخ الفاتورة</div></td>
                                <td class="lbl">Supply Date<div class="ksa-ar">تاريخ التسليم</div></td>
                                <td class="lbl">Contract / PO No<div class="ksa-ar">رقم أمر الشراء</div></td>
                                <td class="lbl">Due Date<div class="ksa-ar">تاريخ الاستحقاق</div></td>
                                <td class="lbl">Invoice Period<div class="ksa-ar">فترة الفاتورة</div></td>
                                <td class="lbl">Project / Reference No<div class="ksa-ar">رقم المرجع</div></td>
                            </tr>
                            <tr>
                                <td t-esc="o.invoice_date.strftime('%m/%d/%Y') if o.invoice_date else ''"/>
                                <td t-esc="o.delivery_date.strftime('%m/%d/%Y') if o.delivery_date else ''"/>
                                <td t-esc="o.way4tech_po_id.name or ''"/>
                                <td t-esc="o.invoice_date_due.strftime('%m/%d/%Y') if o.invoice_date_due else ''"/>
                                <td t-esc="o.ksa_invoice_period or ''"/>
                                <td t-esc="o.way4tech_project_id.name or ''"/>
                            </tr>
                        </table>

                        <!-- ══ LINES ══ -->
                        <table class="ksa-lines" style="margin-top:5px;">
                            <tr>
                                <th class="ksa-th">#</th>
                                <th class="ksa-th">NATURE OF GOODS OR SERVICE<div class="ksa-ar">تفاصيل السلع أو الخدمات</div></th>
                                <th class="ksa-th">QTY<div class="ksa-ar">الكمية</div></th>
                                <th class="ksa-th">UNIT<div class="ksa-ar">وحدة</div></th>
                                <th class="ksa-th">UNIT PRICE<div class="ksa-ar">سعر الوحدة</div></th>
                                <th class="ksa-th">DISCOUNT<div class="ksa-ar">الخصومات</div></th>
                                <th class="ksa-th">SUBTOTAL EXCL. VAT<div class="ksa-ar">غير شامل الضريبة</div></th>
                                <th class="ksa-th">TAX %<div class="ksa-ar">نسبة الضريبة</div></th>
                                <th class="ksa-th">TAX AMOUNT<div class="ksa-ar">مبلغ الضريبة</div></th>
                                <th class="ksa-th">SUBTOTAL INCL. VAT<div class="ksa-ar">شامل الضريبة</div></th>
                            </tr>
                            <!-- Product lines first — sequence order preserved. -->
                            <t t-set="idx" t-value="0"/>
                            <t t-foreach="o.invoice_line_ids.filtered(lambda l: l.display_type not in ('line_section', 'line_note'))" t-as="l">
                                <t t-set="idx" t-value="idx + 1"/>
                                <t t-set="rate" t-value="(l.tax_ids and l.tax_ids[0].amount) or 0.0"/>
                                <tr t-att-class="'zebra' if idx % 2 == 0 else ''">
                                    <td class="ksa-center" t-esc="idx"/>
                                    <td><span class="ksa-b" t-esc="l.product_id.name or ''"/><div t-esc="l.name or ''"/></td>
                                    <td class="ksa-center" t-esc="'{:g}'.format(l.quantity)"/>
                                    <td class="ksa-center" t-esc="l.product_uom_id.name or ''"/>
                                    <td class="ksa-right" t-esc="m(l.price_unit)"/>
                                    <td class="ksa-right" t-esc="m(l.price_unit * l.quantity * (l.discount or 0.0) / 100.0)"/>
                                    <td class="ksa-right" t-esc="m(l.price_subtotal)"/>
                                    <td class="ksa-center" t-esc="'{:g}%'.format(rate)"/>
                                    <td class="ksa-right" t-esc="m(l.price_total - l.price_subtotal)"/>
                                    <td class="ksa-right" t-esc="m(l.price_total)"/>
                                </tr>
                            </t>
                            <!-- All notes at the bottom, grouped, in their original (sequence) order. -->
                            <t t-foreach="o.invoice_line_ids.filtered(lambda l: l.display_type == 'line_note')" t-as="l">
                                <tr class="ksa-note-row"><td colspan="10" class="ksa-note"><t t-out="l.name or ''"/></td></tr>
                            </t>
                        </table>

                        <!-- ══ QR + TOTALS ══ -->
                        <table class="noborder" style="margin-top:4px;"><tr>
                            <td style="width:22%; border:0; text-align:center; vertical-align:middle;">
                                <img t-if="o.ksa_qr_image" t-att-src="'data:image/png;base64,%s' % o.ksa_qr_image" style="width:120px; height:120px;"/>
                            </td>
                            <td style="width:78%; border:0;">
                                <table>
                                    <tr><td class="lbl" style="width:40%;">Total Amount (SAR):</td><td class="ksa-right ksa-b" style="width:20%;" t-esc="m(o.amount_untaxed)"/><td class="lbl ksa-ar">المبلغ الإجمالي (ريال سعودي)</td></tr>
                                    <tr><td class="lbl">Total Discount (SAR):</td><td class="ksa-right" t-esc="m(sum(o.invoice_line_ids.mapped(lambda l: l.price_unit * l.quantity * (l.discount or 0.0) / 100.0)))"/><td class="lbl ksa-ar">إجمالي الخصم (ريال سعودي)</td></tr>
                                    <tr><td class="lbl">Invoice Taxable Amount (SAR):</td><td class="ksa-right" t-esc="m(o.amount_untaxed)"/><td class="lbl ksa-ar">المبلغ الخاضع للضريبة</td></tr>
                                    <tr><td class="lbl">VAT Total Amount (SAR):</td><td class="ksa-right" t-esc="m(o.amount_tax)"/><td class="lbl ksa-ar">إجمالي ضريبة القيمة المضافة</td></tr>
                                    <tr><td class="lbl ksa-b">Gross Total (Incl. of VAT) (SAR):</td><td class="ksa-right ksa-b" t-esc="m(o.amount_total)"/><td class="lbl ksa-ar">إجمالي قيمة الفاتورة</td></tr>
                                    <tr><td class="lbl ksa-b">Balance Due (SAR):</td><td class="ksa-right ksa-b" t-esc="m(o.amount_residual)"/><td class="lbl ksa-ar">إجمالي المبلغ المستحق</td></tr>
                                </table>
                            </td>
                        </tr></table>

                        <!-- ══ AMOUNT IN WORDS ══ -->
                        <table style="margin-top:2px;"><tr><td style="border:0;"><span class="ksa-b">Amount in words : </span><span t-esc="o.ksa_amount_words"/> only.</td></tr></table>

                        <div style="text-align:center; margin:4px 0; font-style:italic;">*This is a computer generated document, no Signature required.</div>

                        <!-- ══ PAYEE / BANK ══ (kept in body: bank details are payment info, not letterhead) -->
                        <div class="ksa-sec" style="margin-top:2px;"><span>Payee Name: <span t-esc="company.name"/></span><span style="float:right;">اسم المستفيد من الحساب</span></div>
                        <table style="text-align:center;">
                            <tr>
                                <th class="ksa-th">Account Number<div class="ksa-ar">رقم الحساب</div></th>
                                <th class="ksa-th">Bank<div class="ksa-ar">المصرف</div></th>
                                <th class="ksa-th">Branch<div class="ksa-ar">فرع</div></th>
                                <th class="ksa-th">IBAN<div class="ksa-ar">رقم الآيبان</div></th>
                                <th class="ksa-th">Swift<div class="ksa-ar">رقم السويفت</div></th>
                            </tr>
                            <tr>
                                <td t-esc="bank.acc_number or ''"/>
                                <td t-esc="bank.bank_id.name or ''"/>
                                <td t-esc="bank.bank_id.city or ''"/>
                                <td t-esc="bank.acc_number or ''"/>
                                <td t-esc="bank.bank_id.bic or ''"/>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
