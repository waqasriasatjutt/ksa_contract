<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="external_layout_atco" name="KSA Bilingual Letterhead (ATCO)">
        <t t-set="cp" t-value="company.partner_id"/>
        <t t-set="name_ar" t-value="company.x_name_ar or company.name"/>
        <t t-set="ar_digits" t-value="lambda s: (s or '').replace('0','٠').replace('1','١').replace('2','٢').replace('3','٣').replace('4','٤').replace('5','٥').replace('6','٦').replace('7','٧').replace('8','٨').replace('9','٩')"/>

        <div t-attf-class="header o_company_#{company.id}_layout">
            <style>
                .atco-h { font-family:'DejaVu Sans',Arial,sans-serif; color:#1a1a1a; width:100%; padding-bottom:6px; }
                .atco-h table.h { width:100%; border-collapse:collapse; }
                .atco-h table.h td { border:0; padding:0; vertical-align:middle; }
                .atco-h .name-en { font-size:17px; font-weight:bold; color:#111; display:inline-block; border-bottom:5px solid #8a1c1c; padding:2px 6px 2px 0; }
                .atco-h .name-ar { font-size:17px; font-weight:bold; color:#111; display:inline-block; border-bottom:5px solid #8a1c1c; padding:2px 0 2px 6px; direction:rtl; }
                .atco-h .meta { font-size:11px; margin-top:4px; line-height:1.5; }
                .atco-h .meta-ar { font-size:11px; margin-top:4px; line-height:1.5; direction:rtl; text-align:right; }
                .atco-h .logo img { max-height:70px; max-width:100%; }
            </style>
            <div class="atco-h">
                <table class="h">
                    <tr>
                        <td style="width:38%; text-align:left;">
                            <div class="name-en" t-esc="company.name"/>
                            <div class="meta">
                                <div><b>Vat No.:</b> <span t-esc="cp.vat or ''"/></div>
                                <div><b>C.R.</b> <span t-esc="cp.company_registry or ''"/></div>
                            </div>
                        </td>
                        <td class="logo" style="width:24%; text-align:center;">
                            <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" alt="logo"/>
                        </td>
                        <td style="width:38%; text-align:right;">
                            <div class="name-ar" t-esc="name_ar"/>
                            <div class="meta-ar">
                                <div>الرقم الضريبي : <span t-esc="ar_digits(cp.vat or '')"/></div>
                                <div>س.ت : <span t-esc="ar_digits(cp.company_registry or '')"/></div>
                            </div>
                        </td>
                    </tr>
                </table>
            </div>
        </div>

        <div t-attf-class="article o_report_layout_atco o_company_#{company.id}_layout"
             t-att-data-oe-model="o and o._name"
             t-att-data-oe-id="o and o.id"
             t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-call="web.address_layout"/>
            <h2 t-out="layout_document_title"/>
            <t t-out="0"/>
        </div>

        <div t-attf-class="footer o_company_#{company.id}_layout">
            <style>
                .atco-f { font-family:'DejaVu Sans',Arial,sans-serif; color:#333; font-size:10px; width:100%; padding-top:4px; }
                .atco-f table.f { width:100%; border-collapse:collapse; }
                .atco-f table.f td { border:0; padding:0; vertical-align:middle; }
                .atco-f .aramco img { max-height:36px; max-width:120px; }
                .atco-f .vc { font-size:10px; color:#333; margin-top:2px; }
                .atco-f .page-no { font-size:9px; color:#888; text-align:center; margin-top:2px; }
            </style>
            <div class="atco-f">
                <table class="f">
                    <tr>
                        <td style="width:40%; text-align:left;">
                            <t t-if="cp.zip or cp.city">
                                <span style="color:#8a1c1c;">&#9679;</span> <b>P.O. Box <t t-esc="cp.zip or ''"/></b> <t t-esc="cp.city or ''"/>
                                <t t-if="cp.zip"> <t t-esc="cp.zip or ''"/></t>
                            </t>
                            <div t-if="cp.country_id">Kingdom of <span t-esc="cp.country_id.name"/></div>
                        </td>
                        <td style="width:30%; text-align:center;">
                            <t t-if="company.email">
                                <span style="color:#8a1c1c;">&#9993;</span> <span t-esc="company.email"/>
                            </t>
                        </td>
                        <td class="aramco" style="width:30%; text-align:right;">
                            <img t-if="company.x_aramco_logo" t-att-src="image_data_uri(company.x_aramco_logo)" alt="aramco"/>
                            <div class="vc" t-if="company.x_aramco_vendor_code">
                                <b>Vendor Code </b><span t-esc="company.x_aramco_vendor_code"/>
                            </div>
                        </td>
                    </tr>
                </table>
                <div t-if="report_type == 'pdf'" class="page-no">Page <span class="page"/> / <span class="topage"/></div>
            </div>
        </div>
    </template>

    <record id="report_layout_atco" model="report.layout">
        <field name="view_id" ref="external_layout_atco"/>
        <field name="name">KSA Bilingual (ATCO)</field>
    </record>
</odoo>
