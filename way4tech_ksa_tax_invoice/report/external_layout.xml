<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="external_layout_atco">
        <t t-set="cp" t-value="company.partner_id"/>
        <t t-set="name_ar" t-value="company.x_name_ar or company.name"/>
        <t t-set="ar_digits" t-value="lambda s: (s or '').replace('0','٠').replace('1','١').replace('2','٢').replace('3','٣').replace('4','٤').replace('5','٥').replace('6','٦').replace('7','٧').replace('8','٨').replace('9','٩')"/>

        <div t-attf-class="article o_report_layout_atco o_company_#{company.id}_layout"
             t-att-data-oe-model="o and o._name"
             t-att-data-oe-id="o and o.id"
             t-att-data-oe-lang="o and o.env.context.get('lang')">
            <style type="text/css">
                /* ATCO letterhead rendered INLINE at the top of the body
                   (page 1 only) — bypasses wkhtmltopdf's --header-html slot
                   entirely so paperformat margin_top can be near-zero. */
                table.atco-hdr, table.atco-hdr > tbody > tr, table.atco-hdr > tbody > tr > td {
                    border: 0 !important;
                    box-shadow: none !important;
                    background: #ffffff !important;
                }
                .atco-hdr {
                    width: 100%;
                    border-collapse: collapse !important;
                    table-layout: fixed;
                    font-family: 'Helvetica', 'Arial', sans-serif;
                    color: #1a1a1a;
                    margin: 0 0 4px 0;
                    padding: 0;
                }
                .atco-hdr td {
                    vertical-align: top;
                    padding: 8px 0 8px 0;
                }
                .atco-hdr .atco-col-left {
                    width: 36%;
                    padding-left: 12px;
                    padding-right: 10px;
                    text-align: left;
                }
                .atco-hdr .atco-col-center {
                    /* Item 2a (2026-08): widened from 20% -> 28% and given
                       horizontal padding so the (enlarged) logo has real room
                       and keeps a clear gap from the English/Arabic names on
                       either side. table-layout:fixed keeps each column bounded,
                       so a bigger logo can never bleed into the name cells. */
                    width: 28%;
                    padding-left: 16px;
                    padding-right: 16px;
                    text-align: center;
                    vertical-align: middle;
                }
                .atco-hdr .atco-col-right {
                    width: 36%;
                    padding-left: 10px;
                    padding-right: 12px;
                    text-align: right;
                    direction: rtl;
                    unicode-bidi: embed;
                }
                .atco-hdr .atco-name {
                    display: inline-block;
                    font-size: 20px;
                    font-weight: bold;
                    color: #111111;
                    line-height: 1.2;
                    padding: 0 0 6px 0;
                    margin: 0;
                    border-bottom: 5px solid #8a1c1c !important;
                }
                .atco-hdr .atco-name-ar {
                    display: inline-block;
                    font-size: 20px;
                    font-weight: bold;
                    color: #111111;
                    line-height: 1.25;
                    padding: 0 0 6px 0;
                    margin: 0;
                    border-bottom: 5px solid #8a1c1c !important;
                    direction: rtl;
                    unicode-bidi: embed;
                    font-family: 'Amiri', 'Tahoma', 'Arial', sans-serif;
                }
                .atco-hdr .atco-meta {
                    margin-top: 6px;
                    font-size: 12px;
                    line-height: 1.5;
                    color: #333333;
                }
                .atco-hdr .atco-meta-ar {
                    direction: rtl;
                    unicode-bidi: embed;
                    text-align: right;
                    font-family: 'Amiri', 'Tahoma', 'Arial', sans-serif;
                }
                .atco-hdr .atco-meta div { margin: 0; padding: 0; }
                .atco-hdr .atco-lbl { font-weight: bold; color: #1a1a1a; }
                .atco-hdr .atco-logo {
                    /* Item 2a (2026-08): enlarged (was 110x140) for real
                       presence. Still capped by the center cell width
                       (28% - padding) so it stays proportionate, centered and
                       never overlaps the names; height cap keeps a tall/square
                       logo from touching the header's top/bottom edges. */
                    max-height: 125px;
                    max-width: 170px;
                    height: auto;
                    width: auto;
                    display: inline-block;
                    vertical-align: middle;
                }
                .atco-sep {
                    display: block;
                    border-top: 1.2px solid #111111 !important;
                    height: 0;
                    margin: 3px 0 8px 0;
                    padding: 0;
                    width: 100%;
                    font-size: 0;
                    line-height: 0;
                }
                /* Part 2a: single pre-cropped header image, full page width. */
                .atco-hdr-img {
                    display: block;
                    width: 100%;
                    height: auto;
                    margin: 0 0 4px 0;
                }
            </style>

            <!-- Letterhead top block (inline in body — appears at very top of page 1) -->
            <!-- Part 2a: a company that has uploaded a single cropped header image
                 shows ONLY that image; otherwise the dynamic 3-part layout below
                 renders exactly as before (no change for such companies). -->
            <div t-if="company.x_invoice_header_image">
                <img t-att-src="image_data_uri(company.x_invoice_header_image)"
                     alt="header" class="atco-hdr-img"/>
            </div>
            <table t-if="not company.x_invoice_header_image"
                   class="atco-hdr" cellpadding="0" cellspacing="0" border="0">
                <tr>
                    <td class="atco-col-left">
                        <div class="atco-name"><span t-esc="company.name"/></div>
                        <div class="atco-meta">
                            <div><span class="atco-lbl">Vat No. :</span> <span t-esc="cp.vat or ''"/></div>
                            <div><span class="atco-lbl">C.R.</span> <span t-esc="cp.company_registry or ''"/></div>
                        </div>
                    </td>
                    <td class="atco-col-center">
                        <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" alt="logo" class="atco-logo"/>
                    </td>
                    <td class="atco-col-right">
                        <div class="atco-name-ar"><span t-esc="name_ar"/></div>
                        <div class="atco-meta atco-meta-ar">
                            <div><span class="atco-lbl">الرقم الضريبي :</span> <span t-esc="ar_digits(cp.vat or '')"/></div>
                            <div><span class="atco-lbl">س.ت :</span> <span t-esc="ar_digits(cp.company_registry or '')"/></div>
                        </div>
                    </td>
                </tr>
            </table>
            <div class="atco-sep"></div>

            <t t-if="not disable_atco_address_layout" t-call="web.address_layout"/>
            <h2 t-if="layout_document_title" t-out="layout_document_title"/>
            <t t-out="0"/>
        </div>

        <div t-attf-class="footer o_company_#{company.id}_layout">
            <style type="text/css">
                table.atco-ftr, table.atco-ftr > tbody > tr, table.atco-ftr > tbody > tr > td {
                    border: 0 !important;
                    box-shadow: none !important;
                    background: #ffffff !important;
                }
                .atco-ftr-sep {
                    display: block;
                    border-top: 1.2px solid #111111 !important;
                    height: 0;
                    margin: 0 0 8px 0;
                    padding: 0;
                    width: 100%;
                    font-size: 0;
                    line-height: 0;
                }
                .atco-ftr {
                    width: 100%;
                    border-collapse: collapse !important;
                    table-layout: fixed;
                    font-family: 'Helvetica', 'Arial', sans-serif;
                    color: #1a1a1a;
                    margin: 0;
                    padding: 0;
                }
                .atco-ftr td { vertical-align: top; padding: 0; }
                .atco-ftr .atco-ftr-left {
                    width: 40%;
                    padding-left: 20px;
                    padding-right: 12px;
                    text-align: left;
                    font-size: 12px;
                    line-height: 1.5;
                }
                .atco-ftr .atco-ftr-center {
                    width: 30%;
                    text-align: center;
                    font-size: 12px;
                    line-height: 1.5;
                    vertical-align: middle;
                }
                .atco-ftr .atco-ftr-right {
                    width: 30%;
                    padding-left: 12px;
                    padding-right: 20px;
                    text-align: right;
                    font-size: 11.5px;
                    line-height: 1.35;
                }
                .atco-ftr .atco-ico {
                    color: #8a1c1c;
                    font-size: 12px;
                    font-weight: bold;
                    margin-right: 4px;
                }
                .atco-ftr .atco-ftr-l1 { font-weight: bold; color: #111111; }
                .atco-ftr .atco-ftr-l2 { color: #333333; font-size: 11.5px; padding-left: 14px; }
                .atco-ftr .atco-mail { font-weight: bold; color: #111111; }
                .atco-aramco-logo {
                    max-height: 30px;
                    height: auto;
                    width: auto;
                    max-width: 100px;
                    display: block;
                    margin: 0 0 0 auto;
                }
                .atco-vendor {
                    font-weight: bold;
                    color: #111111;
                    font-size: 11.5px;
                    margin-top: 2px;
                }
                .atco-pgnum {
                    text-align: center;
                    font-size: 9.5px;
                    color: #777777;
                    padding-top: 3px;
                    font-family: 'Helvetica', 'Arial', sans-serif;
                }
            </style>

            <div class="atco-ftr-sep"></div>
            <table class="atco-ftr" cellpadding="0" cellspacing="0" border="0">
                <tr>
                    <td class="atco-ftr-left">
                        <div class="atco-ftr-l1">
                            <span class="atco-ico">&#9679;</span>
                            P.O. Box <span t-esc="cp.zip or ''"/> <span t-esc="cp.city or ''"/>
                        </div>
                        <div class="atco-ftr-l2" t-if="cp.country_id">
                            <span t-esc="cp.country_id.name"/>
                        </div>
                    </td>
                    <td class="atco-ftr-center">
                        <span t-if="company.email">
                            <span class="atco-ico">&#9993;</span>
                            <span class="atco-mail"><span t-esc="company.email"/></span>
                        </span>
                    </td>
                    <td class="atco-ftr-right">
                        <img t-if="company.x_aramco_logo" t-att-src="image_data_uri(company.x_aramco_logo)" alt="aramco" class="atco-aramco-logo"/>
                        <div class="atco-vendor" t-if="company.x_aramco_vendor_code">
                            Vendor Code <span t-esc="company.x_aramco_vendor_code"/>
                        </div>
                    </td>
                </tr>
            </table>
            <div class="atco-pgnum">
                Page <span class="page"/> of <span class="topage"/>
            </div>
        </div>
    </template>

    <record id="report_layout_atco" model="report.layout">
        <field name="view_id" ref="external_layout_atco"/>
        <field name="name">ATCO Bilingual Letterhead</field>
        <field name="sequence">10</field>
    </record>

</odoo>
