<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_ksa_letterhead" model="ir.ui.view">
        <field name="name">res.company.form.ksa.letterhead</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="KSA Bilingual Letterhead">
                    <field name="x_name_ar" placeholder="مؤسسة أبراج الزين للمقاولات"/>
                    <field name="x_aramco_vendor_code" placeholder="10110430"/>
                    <field name="x_aramco_logo" widget="image" options="{'size': [0, 60]}"/>
                    <!-- Part 2a: single pre-cropped header image (logo + both names).
                         When set, it replaces the dynamic header on the Tax Invoice. -->
                    <field name="x_invoice_header_image" widget="image"
                           options="{'size': [0, 120]}"/>
                    <!-- Item 3: footer image, same pattern as the header image. -->
                    <field name="x_invoice_footer_image" widget="image"
                           options="{'size': [0, 120]}"/>
                    <!-- Part 2b: the shared-IBAN field is retired; IBAN is now per
                         bank account (see the Bank Account form). Field kept on the
                         model, hidden here, pending confirmation to delete fully. -->
                </group>
            </xpath>
        </field>
    </record>

    <!-- Part 2b (2026-08): IBAN entered per bank account, next to Account Number. -->
    <record id="view_partner_bank_form_ksa_iban" model="ir.ui.view">
        <field name="name">res.partner.bank.form.ksa.iban</field>
        <field name="model">res.partner.bank</field>
        <!-- Regression fix (2026-08): the account module locks Account Number +
             Account Holder with readonly="lock_trust_fields" (Odoo's anti-fraud
             lock on TRUSTED accounts, engaged when "Send Money" is ON). Our
             earlier readonly="0" on base.view_partner_bank_form lost that
             attribute race. Inherit from the ACCOUNT view itself so our override
             applies strictly AFTER it and wins. -->
        <field name="inherit_id" ref="account.view_partner_bank_form_inherit_account"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <!-- Per the client's explicit request to restore editability on these
                 two fields, force Account Number editable + saveable, overriding
                 the trust lock. FLAGGED to the client: this removes that fraud
                 safeguard (a user editing must still have Contact-Creation write
                 access, else the whole form stays read-only). -->
            <field name="acc_number" position="attributes">
                <attribute name="readonly">0</attribute>
                <attribute name="force_save">1</attribute>
            </field>
            <field name="acc_number" position="after">
                <field name="x_iban" placeholder="SA00 0000 0000 0000 0000 0000"/>
            </field>
        </field>
    </record>
</odoo>
