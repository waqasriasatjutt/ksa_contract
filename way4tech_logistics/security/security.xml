<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">

    <!-- Module category — groups this app's privileges under one section in the user form -->
    <record id="module_category_way4tech_logistics" model="ir.module.category">
        <field name="name">Way4Tech Logistics</field>
        <field name="sequence">50</field>
    </record>

    <!-- Privilege — the selector row shown in the user Access Rights tab -->
    <record id="privilege_logistics_access" model="res.groups.privilege">
        <field name="name">Way4Tech Logistics</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_way4tech_logistics"/>
        <field name="placeholder">No Access</field>
    </record>

    <!-- User group — basic access -->
    <record id="group_logistics_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_logistics_access"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Manager group — full access, implies User -->
    <record id="group_logistics_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_logistics_access"/>
        <field name="implied_ids" eval="[(4, ref('group_logistics_user'))]"/>
    </record>

    <!-- ===================================================
         Multi-company record rules — global (no groups), matching Odoo standard.
         Applied with AND logic to every user accessing these models.
         '| company_id = False' follows Odoo's own core module pattern.
         =================================================== -->

    <record id="rule_platform_config_company" model="ir.rule">
        <field name="name">Platform Config: multi-company</field>
        <field name="model_id" ref="model_way4tech_platform_config"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
