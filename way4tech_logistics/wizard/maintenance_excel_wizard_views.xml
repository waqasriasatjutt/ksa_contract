<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Maintenance Excel Export -->
    <record id="view_maintenance_excel_export_form" model="ir.ui.view">
        <field name="name">way4tech.maintenance.excel.export.form</field>
        <field name="model">way4tech.maintenance.excel.export</field>
        <field name="arch" type="xml">
            <form string="Export Maintenance to Excel">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Filter by date range or vehicle (optional), then click
                        <strong>Generate Excel</strong>.
                    </div>
                    <group>
                        <group string="Filters (optional)">
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="vehicle_id"/>
                        </group>
                    </group>
                    <group invisible="not file_data">
                        <field name="file_name" readonly="1"/>
                        <field name="file_data" filename="file_name" readonly="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_export" type="object"
                            string="Generate Excel"
                            class="btn-primary"/>
                    <button special="cancel" string="Close" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_maintenance_excel_export" model="ir.actions.act_window">
        <field name="name">Export Maintenance to Excel</field>
        <field name="res_model">way4tech.maintenance.excel.export</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_maintenance_excel_export_form"/>
        <field name="target">new</field>
    </record>

    <!-- Maintenance Excel Import -->
    <record id="view_maintenance_excel_import_form" model="ir.ui.view">
        <field name="name">way4tech.maintenance.excel.import.form</field>
        <field name="model">way4tech.maintenance.excel.import</field>
        <field name="arch" type="xml">
            <form string="Import Maintenance from Excel">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Upload an .xlsx file with these columns (Row 1 = headers):<br/>
                        <strong>A</strong>=Date, <strong>B</strong>=License Plate,
                        <strong>C</strong>=Category (Preventive/Corrective/Accident Repair/Tyres/Other),
                        <strong>D</strong>=Vendor, <strong>E</strong>=Amount, <strong>F</strong>=Notes
                    </div>
                    <group invisible="import_log">
                        <field name="file_name" invisible="1"/>
                        <field name="excel_file" filename="file_name"/>
                    </group>
                    <group invisible="not import_log">
                        <field name="created_count" readonly="1"/>
                        <field name="skipped_count" readonly="1"/>
                        <field name="import_log" readonly="1" widget="text"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_import" type="object"
                            string="Import"
                            class="btn-primary"
                            invisible="import_log"/>
                    <button special="cancel" string="Close" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_maintenance_excel_import" model="ir.actions.act_window">
        <field name="name">Import Maintenance from Excel</field>
        <field name="res_model">way4tech.maintenance.excel.import</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_maintenance_excel_import_form"/>
        <field name="target">new</field>
    </record>

</odoo>
