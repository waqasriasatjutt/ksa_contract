<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================
         Truck / Client Profitability Report Wizard — Form View
         =================================================== -->
    <record id="view_truck_profitability_wizard_form" model="ir.ui.view">
        <field name="name">way4tech.truck.profitability.wizard.form</field>
        <field name="model">way4tech.truck.profitability.wizard</field>
        <field name="arch" type="xml">
            <form string="Profitability Report">
                <group>
                    <group string="Period">
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group string="Options">
                        <field name="report_type"/>
                        <field name="state_filter"/>
                    </group>
                </group>
                <group string="Optional Filters">
                    <field name="truck_ids" widget="many2many_tags"
                           help="Leave empty to include all trucks."/>
                    <field name="client_ids" widget="many2many_tags"
                           help="Leave empty to include all clients."/>
                </group>
                <footer>
                    <button name="action_print_report"
                            type="object"
                            string="Print PDF Report"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ===================================================
         Wizard Action (window action to open wizard)
         =================================================== -->
    <record id="action_truck_profitability_wizard" model="ir.actions.act_window">
        <field name="name">Profitability Report</field>
        <field name="res_model">way4tech.truck.profitability.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
