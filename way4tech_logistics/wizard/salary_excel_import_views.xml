<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================
         Wizard Form View
         =================================================== -->
    <record id="view_salary_excel_import_form" model="ir.ui.view">
        <field name="name">way4tech.salary.excel.import.form</field>
        <field name="model">way4tech.salary.excel.import</field>
        <field name="arch" type="xml">
            <form string="Import Salary from Excel">
                <group>
                    <field name="import_id" invisible="context.get('default_import_id')"/>
                    <field name="excel_file" widget="binary" filename="file_name"/>
                    <field name="file_name" invisible="1"/>
                </group>
                <div class="alert alert-info" role="alert">
<!-- 2026-10-08: this table is generated from the one column
                         definition the template and the reader also use, so the
                         instructions can no longer describe a different sheet
                         from the one the system reads. -->
                    <field name="format_html" nolabel="1" readonly="1"/>
                </div>
                <footer>
                    <button
                        name="action_import"
                        type="object"
                        string="Import"
                        class="btn-primary"
                    />
                    <button
                        name="action_download_template"
                        type="object"
                        string="Download Template"
                        class="btn-secondary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ===================================================
         Action to open wizard
         =================================================== -->
    <record id="action_salary_excel_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Salary from Excel</field>
        <field name="res_model">way4tech.salary.excel.import</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_salary_excel_import_form"/>
        <field name="target">new</field>
        <field name="context">{'default_import_id': active_id}</field>
    </record>

</odoo>
