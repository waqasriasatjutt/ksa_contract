<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employee_margin_report_wizard_form" model="ir.ui.view">
        <field name="name">way4tech.employee.margin.report.wizard.form</field>
        <field name="model">way4tech.employee.margin.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Rider / Driver Margin Report">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="employee_ids" widget="many2many_tags"
                               placeholder="Leave empty for all drivers / riders"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_report" string="Print PDF"
                            type="object" class="btn-primary"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_employee_margin_report_wizard" model="ir.actions.act_window">
        <field name="name">Rider / Driver Margin Report</field>
        <field name="res_model">way4tech.employee.margin.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
