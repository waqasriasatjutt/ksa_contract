<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employee_category_report_wizard_form" model="ir.ui.view">
        <field name="name">way4tech.employee.category.report.wizard.form</field>
        <field name="model">way4tech.employee.category.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Employee Category-wise Report">
                <group>
                    <group>
                        <field name="employee_id"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="include_salary"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_report" string="Print PDF"
                            type="object" class="btn-primary"/>
                    <button name="action_send_email" string="Send Email"
                            type="object" class="btn-secondary"/>
                    <button name="action_generate_whatsapp_link" string="WhatsApp Link"
                            type="object" class="btn-success"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_employee_category_report_wizard" model="ir.actions.act_window">
        <field name="name">Employee Category Report</field>
        <field name="res_model">way4tech.employee.category.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
