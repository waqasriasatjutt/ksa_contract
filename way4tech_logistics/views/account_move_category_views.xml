<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit account.move form to add:
         1. Entry Category field (mandatory)
         2. Approval status badge + Approve/Reject buttons
         3. Previous related entry info box -->
    <record id="view_account_move_way4tech_inherit" model="ir.ui.view">
        <field name="name">account.move.form.way4tech</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- Add Approve / Reject buttons in header (visible to managers when pending) -->
            <xpath expr="//header/button[1]" position="before">
                <button name="action_way4tech_approve"
                        string="Approve &amp; Post"
                        type="object"
                        class="btn-success"
                        groups="way4tech_logistics.group_logistics_manager"
                        invisible="way4tech_approval_state != 'pending'"/>
                <button name="action_way4tech_reject"
                        string="Reject"
                        type="object"
                        class="btn-danger"
                        groups="way4tech_logistics.group_logistics_manager"
                        invisible="way4tech_approval_state != 'pending'"/>
            </xpath>

            <!-- Add approval state to statusbar -->
            <xpath expr="//field[@name='state']" position="after">
                <field name="way4tech_approval_state" widget="badge"
                       decoration-warning="way4tech_approval_state == 'pending'"
                       decoration-success="way4tech_approval_state == 'approved'"
                       decoration-danger="way4tech_approval_state == 'rejected'"
                       invisible="way4tech_approval_state == 'na'"/>
            </xpath>

            <!-- Add Entry Category field after the journal field in the top section -->
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="way4tech_category_id"
                       string="Entry Category"
                       placeholder="Select category (required)..."
                       options="{'no_create': true}"
                       widget="many2one"
                       required="0"/>
                <field name="way4tech_po_id"
                       string="Client PO"
                       invisible="move_type != 'out_invoice'"
                       options="{'no_create': true}"/>
            </xpath>

            <!-- Previous expense info box (shown when a vendor/partner is set) -->
            <xpath expr="//sheet" position="before">
                <div class="alert alert-info d-flex align-items-center mb-0"
                     role="alert"
                     invisible="not way4tech_prev_expense">
                    <i class="fa fa-history me-2"/>
                    <span>
                        <strong>Previous Entry (Same Vendor): </strong>
                        <field name="way4tech_prev_expense" readonly="1" nolabel="1"
                               class="text-muted"/>
                        <button name="action_way4tech_reject"
                                string="" type="object" icon="fa-external-link"
                                class="btn btn-sm btn-link p-0 ms-2"
                                invisible="not way4tech_prev_expense_id"
                                title="Open previous entry"/>
                    </span>
                </div>
            </xpath>

            <!-- Rejection reason info bar (visible when rejected) -->
            <xpath expr="//sheet" position="before">
                <div class="alert alert-danger mb-0"
                     invisible="way4tech_approval_state != 'rejected'">
                    <strong>Entry Rejected</strong> — Reason:
                    <field name="way4tech_rejection_reason" readonly="1" nolabel="1"/>
                </div>
            </xpath>

        </field>
    </record>

    <!-- Pending Approvals action (for managers) -->
    <record id="action_pending_approvals" model="ir.actions.act_window">
        <field name="name">Pending Approvals</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('way4tech_approval_state', '=', 'pending')]</field>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No entries pending approval</p>
            <p>Entries submitted by accountants with amount > 500 SAR
               appear here for manager review.</p>
        </field>
    </record>

</odoo>
