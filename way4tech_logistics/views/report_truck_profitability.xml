<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================
         Landscape, so the eleven columns the client asked for fit at a
         readable size instead of being squeezed into portrait.
         =================================================== -->
    <record id="paperformat_profitability_landscape" model="report.paperformat">
        <field name="name">Way4Tech Profitability (A4 Landscape)</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">12</field>
        <field name="margin_bottom">12</field>
        <field name="margin_left">6</field>
        <field name="margin_right">6</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">10</field>
        <field name="dpi">90</field>
    </record>

    <!-- ===================================================
         Truck-wise Profitability — Report Action
         =================================================== -->
    <record id="action_report_truck_profitability" model="ir.actions.report">
        <field name="name">Truck-wise Profitability Report</field>
        <field name="model">way4tech.truck.profitability.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">way4tech_logistics.report_truck_profitability_doc</field>
        <field name="report_file">way4tech_logistics.report_truck_profitability_doc</field>
        <field name="paperformat_id" ref="paperformat_profitability_landscape"/>
    </record>

    <!-- ===================================================
         Customer-wise Profitability — Report Action
         =================================================== -->
    <record id="action_report_client_profitability" model="ir.actions.report">
        <field name="name">Customer-wise Profitability Report</field>
        <field name="model">way4tech.truck.profitability.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">way4tech_logistics.report_client_profitability_doc</field>
        <field name="report_file">way4tech_logistics.report_client_profitability_doc</field>
        <field name="paperformat_id" ref="paperformat_profitability_landscape"/>
    </record>

    <!-- ===================================================
         Shared sub-template: the whole report body.

         Parameters passed via t-call:
           wizard   — way4tech.truck.profitability.wizard
           data     — dict from wizard.get_report_rows()
           sym      — currency symbol
           title    — report heading
           group_th — heading of the first summary column
         =================================================== -->
    <template id="report_profitability_body">
        <div class="page">

            <!-- ── Heading ───────────────────────────────────────────── -->
            <div class="row mb-3">
                <div class="col-7">
                    <h3 class="mb-1"><t t-esc="title"/></h3>
                    <div class="text-muted" style="font-size:11px;">
                        Period <strong><t t-esc="wizard.date_from"/></strong>
                        to <strong><t t-esc="wizard.date_to"/></strong>
                        · Trips: <t t-esc="dict(wizard.fields_get(['state_filter'])['state_filter']['selection'])[wizard.state_filter]"/>
                        <t t-if="not wizard.include_maintenance"> · maintenance excluded</t>
                    </div>
                </div>
                <div class="col-5 text-end" style="font-size:11px;">
                    <div><strong><t t-esc="wizard.env.company.name"/></strong></div>
                    <div class="text-muted">
                        Printed <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %H:%M')"/>
                    </div>
                </div>
            </div>

            <!-- ── Summary on top: period totals, then one line per group ─ -->
            <table class="table table-sm table-bordered mb-1" style="font-size:10px;">
                <thead class="table-dark">
                    <tr>
                        <th><t t-esc="group_th"/></th>
                        <th class="text-end" style="width:7%;">Entries</th>
                        <th class="text-end" style="width:11%;">Revenue</th>
                        <th class="text-end" style="width:11%;">Driver Cost</th>
                        <th class="text-end" style="width:10%;">Fuel Cost</th>
                        <th class="text-end" style="width:10%;">Other Cost</th>
                        <th class="text-end" style="width:12%;">Maintenance</th>
                        <th class="text-end" style="width:11%;">Profit</th>
                        <th class="text-end" style="width:8%;">Margin%</th>
                    </tr>
                </thead>
                <tbody>
                    <tr class="fw-bold table-warning">
                        <td>PERIOD TOTAL (<t t-esc="sym"/>)</td>
                        <td class="text-end"><t t-esc="data['totals']['count']"/></td>
                        <td class="text-end"><t t-esc="'%.2f' % data['totals']['revenue']"/></td>
                        <td class="text-end"><t t-esc="'%.2f' % data['totals']['driver']"/></td>
                        <td class="text-end"><t t-esc="'%.2f' % data['totals']['fuel']"/></td>
                        <td class="text-end"><t t-esc="'%.2f' % data['totals']['other']"/></td>
                        <td class="text-end"><t t-esc="'%.2f' % data['totals']['maintenance']"/></td>
                        <td class="text-end"
                            t-attf-style="color: #{data['totals']['profit'] &gt;= 0 and 'green' or 'red'}">
                            <t t-esc="'%.2f' % data['totals']['profit']"/>
                        </td>
                        <td class="text-end"><t t-esc="'%.1f' % data['totals']['margin']"/>%</td>
                    </tr>
                    <t t-foreach="data['groups']" t-as="group">
                        <tr>
                            <td>
                                <t t-esc="group['label']"/>
                                <t t-if="group['sub_label']">
                                    <span class="text-muted"> (<t t-esc="group['sub_label']"/>)</span>
                                </t>
                            </td>
                            <td class="text-end"><t t-esc="group['totals']['count']"/></td>
                            <td class="text-end"><t t-esc="'%.2f' % group['totals']['revenue']"/></td>
                            <td class="text-end"><t t-esc="'%.2f' % group['totals']['driver']"/></td>
                            <td class="text-end"><t t-esc="'%.2f' % group['totals']['fuel']"/></td>
                            <td class="text-end"><t t-esc="'%.2f' % group['totals']['other']"/></td>
                            <td class="text-end"><t t-esc="'%.2f' % group['totals']['maintenance']"/></td>
                            <td class="text-end"
                                t-attf-style="color: #{group['totals']['profit'] &gt;= 0 and 'green' or 'red'}">
                                <t t-esc="'%.2f' % group['totals']['profit']"/>
                            </td>
                            <td class="text-end"><t t-esc="'%.1f' % group['totals']['margin']"/>%</td>
                        </tr>
                    </t>
                    <tr t-if="not data['groups']">
                        <td colspan="9" class="text-center text-muted">
                            No entries in this period.
                        </td>
                    </tr>
                </tbody>
            </table>
            <div class="text-muted mb-3" style="font-size:9px;">
                Profit = Revenue less Driver Cost, Fuel Cost, Other Cost and Maintenance.
                Other Cost carries a trip's other direct costs and, on a middleman
                trip, the third-party hire.
            </div>

            <!-- ── Below: every entry, line by line ──────────────────── -->
            <t t-foreach="data['groups']" t-as="group">
                <table class="table table-sm table-bordered mb-3" style="font-size:9px;">
                    <thead>
                        <tr class="table-secondary">
                            <th colspan="12" style="font-size:10px;">
                                <t t-esc="group['label']"/>
                                <t t-if="group['sub_label']">
                                    <span class="fw-normal text-muted"> (<t t-esc="group['sub_label']"/>)</span>
                                </t>
                                <span class="fw-normal text-muted">
                                    — <t t-esc="group['totals']['count']"/> entr<t t-esc="group['totals']['count'] == 1 and 'y' or 'ies'"/>
                                </span>
                            </th>
                        </tr>
                        <tr class="table-light">
                            <th style="width:7%;">Date</th>
                            <th style="width:13%;">Reference</th>
                            <th style="width:11%;">Truck</th>
                            <th style="width:14%;">Client</th>
                            <th style="width:9%;">Type</th>
                            <th class="text-end" style="width:8%;">Revenue</th>
                            <th class="text-end" style="width:8%;">Driver</th>
                            <th class="text-end" style="width:7%;">Fuel</th>
                            <th class="text-end" style="width:7%;">Other</th>
                            <th class="text-end" style="width:8%;">Maint.</th>
                            <th class="text-end" style="width:8%;">Profit</th>
                            <th class="text-end" style="width:6%;">Margin%</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="group['rows']" t-as="row">
                            <tr>
                                <td><t t-esc="row['date']"/></td>
                                <td><t t-esc="row['reference'] or '-'"/></td>
                                <td><t t-esc="row['truck'] or '-'"/></td>
                                <td><t t-esc="row['client'] or '-'"/></td>
                                <td><t t-esc="row['kind'] or '-'"/></td>
                                <td class="text-end"><t t-esc="'%.2f' % row['revenue']"/></td>
                                <td class="text-end"><t t-esc="'%.2f' % row['driver']"/></td>
                                <td class="text-end"><t t-esc="'%.2f' % row['fuel']"/></td>
                                <td class="text-end"><t t-esc="'%.2f' % row['other']"/></td>
                                <td class="text-end"><t t-esc="'%.2f' % row['maintenance']"/></td>
                                <td class="text-end"
                                    t-attf-style="color: #{row['profit'] &gt;= 0 and 'green' or 'red'}">
                                    <t t-esc="'%.2f' % row['profit']"/>
                                </td>
                                <td class="text-end">
                                    <t t-if="row['revenue']"><t t-esc="'%.1f' % row['margin']"/>%</t>
                                    <t t-else="">-</t>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                    <tfoot>
                        <tr class="fw-bold table-light">
                            <td colspan="5" class="text-end">Subtotal</td>
                            <td class="text-end"><t t-esc="'%.2f' % group['totals']['revenue']"/></td>
                            <td class="text-end"><t t-esc="'%.2f' % group['totals']['driver']"/></td>
                            <td class="text-end"><t t-esc="'%.2f' % group['totals']['fuel']"/></td>
                            <td class="text-end"><t t-esc="'%.2f' % group['totals']['other']"/></td>
                            <td class="text-end"><t t-esc="'%.2f' % group['totals']['maintenance']"/></td>
                            <td class="text-end"
                                t-attf-style="color: #{group['totals']['profit'] &gt;= 0 and 'green' or 'red'}">
                                <t t-esc="'%.2f' % group['totals']['profit']"/>
                            </td>
                            <td class="text-end"><t t-esc="'%.1f' % group['totals']['margin']"/>%</td>
                        </tr>
                    </tfoot>
                </table>
            </t>
        </div>
    </template>

    <!-- ===================================================
         Truck-wise Profitability Report — QWeb Template
         =================================================== -->
    <template id="report_truck_profitability_doc">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="wizard">
                <t t-call="web.external_layout">
                    <t t-set="data" t-value="wizard.get_report_rows()"/>
                    <t t-set="sym" t-value="wizard.env.company.currency_id.symbol"/>
                    <t t-set="title">Truck-wise Profitability Report</t>
                    <t t-set="group_th">Truck</t>
                    <t t-call="way4tech_logistics.report_profitability_body"/>
                </t>
            </t>
        </t>
    </template>

    <!-- ===================================================
         Customer-wise Profitability Report — QWeb Template
         =================================================== -->
    <template id="report_client_profitability_doc">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="wizard">
                <t t-call="web.external_layout">
                    <t t-set="data" t-value="wizard.get_report_rows()"/>
                    <t t-set="sym" t-value="wizard.env.company.currency_id.symbol"/>
                    <t t-set="title">Customer-wise Profitability Report</t>
                    <t t-set="group_th">Customer</t>
                    <t t-call="way4tech_logistics.report_profitability_body"/>
                </t>
            </t>
        </t>
    </template>

</odoo>
