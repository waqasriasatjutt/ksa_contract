<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Expose the same Vehicle field that vendor bill lines already use
         onto customer invoice lines. Column is toggleable (optional='hide')
         so it doesn't clutter the default line editor. Same field, same
         behavior — no new field is created. -->
    <record id="view_move_form_invoice_vehicle" model="ir.ui.view">
        <field name="name">account.move.form.invoice.vehicle</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list//field[@name='product_id']" position="after">
                <field name="vehicle_id" optional="hide" invisible="parent.move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund')"/>
            </xpath>
        </field>
    </record>
</odoo>
