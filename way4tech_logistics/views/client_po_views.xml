<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================
         Client PO Form View
         =================================================== -->
    <record id="view_client_po_form" model="ir.ui.view">
        <field name="name">way4tech.client.po.form</field>
        <field name="model">way4tech.client.po</field>
        <field name="arch" type="xml">
            <form string="Client PO">
                <header>
                    <button
                        name="action_renew_po"
                        type="object"
                        string="Renew PO"
                        class="btn-secondary"
                        invisible="state != 'near_limit' and state != 'closed'"
                        help="Create a new PO linked to the same client for renewal."
                    />
                    <field name="state" widget="statusbar" statusbar_visible="open,near_limit,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_trips"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-truck"
                        >
                            <field name="trip_count" widget="statinfo" string="Trips"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>

                    <!-- Warning alerts -->
                    <div class="alert alert-danger mb-2" role="alert"
                         invisible="state != 'closed'">
                        <strong>PO Fully Consumed.</strong>
                        This PO has reached 100% utilization and is now closed.
                        Click <strong>Renew PO</strong> to create a new one.
                    </div>
                    <div class="alert alert-warning mb-2" role="alert"
                         invisible="state != 'near_limit'">
                        <strong>PO Near Limit (80%+ consumed).</strong>
                        Utilization is <field name="utilization_pct" readonly="1" widget="float"/>%.
                        Consider renewing the PO if the project is ongoing.
                    </div>

                    <group>
                        <group string="PO Details">
                            <field name="client_id"
                                   help="The customer / client who issued this Purchase Order. &#10;&#10;Trips linked to this PO are tracked against the consumed amount. When consumed amount reaches the total PO value, the PO status automatically changes to Closed."/>
                            <field name="po_date"
                                   help="Date the client issued this Purchase Order. Used for reference and sorting."/>
                            <field name="expiry_date"
                                   help="Date this PO expires. Informational — set a reminder or renew before this date to avoid service interruption. Does not auto-close the PO."/>
                            <field name="description"
                                   help="Short description of the PO scope, e.g. 'Delivery services Q1 2026' or 'Daily truck hire — March'. Displayed in the list view and on trip records for easy reference."/>
                            <field name="company_id" groups="base.group_multi_company"
                                   help="The branch company this PO belongs to. Determines which trips are counted against this PO."/>
                        </group>
                        <group string="Balance">
                            <field name="total_amount"
                                   help="Maximum value of this Purchase Order — the total amount the client has authorised. &#10;&#10;Trips linked to this PO consume this budget. The PO closes automatically when 100% is consumed."/>
                            <field name="consumed_amount" readonly="1"
                                   help="Auto-calculated sum of revenue from all confirmed/done trips linked to this PO. Read-only — updated whenever a linked trip is saved."/>
                            <field name="remaining_balance" readonly="1" class="o_field_highlight"
                                   help="Total Amount − Consumed Amount. How much of the PO budget is still available for new trips. Read-only."/>
                            <field name="utilization_pct" readonly="1" string="Utilization %"
                                   decoration-danger="utilization_pct >= 100"
                                   decoration-warning="utilization_pct >= 80"
                                   help="Consumed Amount ÷ Total Amount × 100. &#10;&#10;• Green (open): &lt; 80% consumed &#10;• Orange (near limit): 80–99% consumed — consider renewing &#10;• Red (closed): 100%+ consumed — no further trips allowed against this PO"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" string="Notes" nolabel="1" colspan="2"
                               placeholder="Internal notes..."
                               help="Internal notes about this PO — client instructions, special terms, renewal history, or any other context that does not fit in the description."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ===================================================
         Client PO List View
         =================================================== -->
    <record id="view_client_po_list" model="ir.ui.view">
        <field name="name">way4tech.client.po.list</field>
        <field name="model">way4tech.client.po</field>
        <field name="arch" type="xml">
            <list string="Client POs"
                  decoration-danger="state == 'closed'"
                  decoration-warning="state == 'near_limit'">
                <field name="name"/>
                <field name="client_id"/>
                <field name="po_date"/>
                <field name="expiry_date" optional="show"/>
                <field name="description" optional="show"/>
                <field name="total_amount" sum="Total PO Value"/>
                <field name="consumed_amount" sum="Total Consumed"/>
                <field name="remaining_balance" sum="Total Remaining"/>
                <field name="utilization_pct" string="Used %"
                       decoration-danger="utilization_pct >= 100"
                       decoration-warning="utilization_pct >= 80"/>
                <field name="trip_count"/>
                <field name="state" widget="badge"
                    decoration-success="state == 'open'"
                    decoration-warning="state == 'near_limit'"
                    decoration-danger="state == 'closed'"
                />
            </list>
        </field>
    </record>

    <!-- ===================================================
         Client PO Search View
         =================================================== -->
    <record id="view_client_po_search" model="ir.ui.view">
        <field name="name">way4tech.client.po.search</field>
        <field name="model">way4tech.client.po</field>
        <field name="arch" type="xml">
            <search string="Search Client POs">
                <field name="name"/>
                <field name="client_id"/>
                <separator/>
                <filter string="Open" name="open" domain="[('state','=','open')]"/>
                <filter string="Near Limit" name="near_limit" domain="[('state','=','near_limit')]"/>
                <filter string="Closed" name="closed" domain="[('state','=','closed')]"/>
                <separator/>
                <filter string="Client" name="group_client" context="{'group_by': 'client_id'}"/>
                <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <!-- ===================================================
         Client PO Action
         =================================================== -->
    <record id="action_client_po" model="ir.actions.act_window">
        <field name="name">Client POs</field>
        <field name="res_model">way4tech.client.po</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_client_po_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first Client PO</p>
            <p>
                Track client Purchase Orders — total value, consumed amount per trip,
                remaining balance, and auto-close at 100% utilization.
                Warning alerts appear at 80%+ to prompt renewal.
            </p>
        </field>
    </record>

</odoo>
