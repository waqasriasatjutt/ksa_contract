<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================
         Inbound Equipment Rental — Form View
         =================================================== -->
    <record id="view_equipment_rental_inbound_form" model="ir.ui.view">
        <field name="name">way4tech.equipment.rental.inbound.form</field>
        <field name="model">way4tech.equipment.rental.inbound</field>
        <field name="arch" type="xml">
            <form string="Inbound Rental">
                <header>
                    <button name="action_confirm" type="object" string="Confirm"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_start" type="object" string="Start Rental"
                            class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_create_bill" type="object" string="Create Vendor Bill"
                            class="btn-primary"
                            invisible="bill_id or state not in ('active', 'completed')"/>
                    <button name="action_complete" type="object" string="Mark Completed"
                            class="btn-success" invisible="state != 'active'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            class="btn-secondary"
                            invisible="state in ('completed', 'cancelled')"
                            confirm="Cancel this rental?"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            class="btn-secondary"
                            invisible="state not in ('confirmed', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,active,completed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_bill" type="object"
                                class="oe_stat_button" icon="fa-pencil-square-o"
                                invisible="not bill_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Vendor Bill</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Equipment">
                            <field name="equipment_name"
                                   placeholder="e.g. CAT 320 Excavator"
                                   readonly="state not in ('draft', 'confirmed')"/>
                            <field name="equipment_category"
                                   readonly="state not in ('draft', 'confirmed')"/>
                        </group>
                        <group string="Vendor">
                            <field name="vendor_id"
                                   readonly="state not in ('draft', 'confirmed')"/>
                            <field name="contact_person"/>
                            <field name="contact_phone"/>
                        </group>
                    </group>
                    <group>
                        <group string="Rental Period">
                            <field name="rental_start"
                                   readonly="state not in ('draft', 'confirmed')"/>
                            <field name="rental_end"
                                   readonly="state == 'completed'"/>
                            <field name="rental_duration"/>
                        </group>
                        <group string="Rate &amp; Cost">
                            <field name="rate_type" widget="radio"
                                   readonly="state not in ('draft', 'confirmed')"/>
                            <field name="rate_amount"
                                   readonly="state not in ('draft', 'confirmed', 'active')"/>
                            <field name="total_cost" class="o_field_highlight"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Project Link">
                            <field name="manpower_contract_id"
                                   readonly="state not in ('draft', 'confirmed')"/>
                            <field name="analytic_account_id"/>
                        </group>
                        <group string="Billing">
                            <field name="bill_id" readonly="1"/>
                            <field name="bill_state" invisible="not bill_id"/>
                            <field name="payment_state" invisible="not bill_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Terms &amp; Notes">
                        <field name="notes" nolabel="1" colspan="2"
                               placeholder="Rental terms, delivery details, return conditions..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ===================================================
         Inbound Equipment Rental — List View
         =================================================== -->
    <record id="view_equipment_rental_inbound_list" model="ir.ui.view">
        <field name="name">way4tech.equipment.rental.inbound.list</field>
        <field name="model">way4tech.equipment.rental.inbound</field>
        <field name="arch" type="xml">
            <list string="Inbound Rentals"
                  decoration-success="state == 'completed'"
                  decoration-info="state == 'active'"
                  decoration-warning="state == 'confirmed'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="equipment_name"/>
                <field name="equipment_category"/>
                <field name="vendor_id"/>
                <field name="rental_start"/>
                <field name="rental_end"/>
                <field name="rate_type"/>
                <field name="total_cost" sum="Total Cost"/>
                <field name="bill_id" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'confirmed'"
                       decoration-success="state in ('active', 'completed')"
                />
            </list>
        </field>
    </record>

    <!-- ===================================================
         Inbound Equipment Rental — Search View
         =================================================== -->
    <record id="view_equipment_rental_inbound_search" model="ir.ui.view">
        <field name="name">way4tech.equipment.rental.inbound.search</field>
        <field name="model">way4tech.equipment.rental.inbound</field>
        <field name="arch" type="xml">
            <search string="Search Inbound Rentals">
                <field name="name"/>
                <field name="equipment_name"/>
                <field name="vendor_id"/>
                <separator/>
                <filter string="Active" name="filter_active"
                        domain="[('state', '=', 'active')]"/>
                <filter string="Confirmed" name="filter_confirmed"
                        domain="[('state', '=', 'confirmed')]"/>
                <filter string="Completed" name="filter_completed"
                        domain="[('state', '=', 'completed')]"/>
                <filter string="Not Billed" name="filter_not_billed"
                        domain="[('bill_id', '=', False), ('state', 'not in', ['draft', 'cancelled'])]"/>
                <separator/>
                <filter string="By Vendor" name="group_vendor"
                        context="{'group_by': 'vendor_id'}"/>
                <filter string="By Category" name="group_category"
                        context="{'group_by': 'equipment_category'}"/>
                <filter string="By Month" name="group_month"
                        context="{'group_by': 'rental_start:month'}"/>
            </search>
        </field>
    </record>

    <!-- ===================================================
         Inbound Equipment Rental — Action
         =================================================== -->
    <record id="action_equipment_rental_inbound" model="ir.actions.act_window">
        <field name="name">Inbound Rentals (From Vendors)</field>
        <field name="res_model">way4tech.equipment.rental.inbound</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_equipment_rental_inbound_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Record your first equipment rental from a vendor
            </p>
            <p>
                Track equipment and machinery rented FROM external vendors —
                generators, cranes, excavators, etc. Create vendor bills
                with automatic cost calculation based on rental duration and rate.
            </p>
        </field>
    </record>

</odoo>
