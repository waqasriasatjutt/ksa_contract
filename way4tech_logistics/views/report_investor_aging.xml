<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================
         Investor Aging Report — Report Action
         =================================================== -->
    <record id="action_report_investor_aging" model="ir.actions.report">
        <field name="name">Investor Aging Report</field>
        <field name="model">way4tech.investor.aging.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">way4tech_logistics.report_investor_aging_doc</field>
        <field name="report_file">way4tech_logistics.report_investor_aging_doc</field>
        <field name="print_report_name">'Investor Aging Report - %s' % (object.as_of_date)</field>
    </record>

    <!-- ===================================================
         Investor Aging Report — QWeb Template
         =================================================== -->
    <template id="report_investor_aging_doc">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="wizard">
                <t t-set="aging_data" t-value="wizard.get_aging_data()"/>
                <t t-set="totals"     t-value="wizard.get_grand_totals()"/>
                <t t-set="sym"        t-value="wizard.env.company.currency_id.symbol"/>

                <!-- ══ PAGE 1 — Aging Summary ══ -->
                <t t-call="web.external_layout">
                    <div class="page">

                        <!-- Header -->
                        <div class="row mb-4">
                            <div class="col-7">
                                <h2 class="mb-1">Investor Aging Report</h2>
                                <p class="text-muted mb-0">
                                    Outstanding profit-share amounts due to investors
                                </p>
                                <p class="text-muted mb-0">
                                    <strong>As Of:</strong> <t t-esc="wizard.as_of_date"/>
                                    &amp;nbsp;|&amp;nbsp;
                                    <strong>Status:</strong>
                                    Confirmed
                                    <t t-if="wizard.include_draft"> + Draft</t>
                                    (excluding Paid)
                                </p>
                            </div>
                            <div class="col-5 text-end">
                                <p class="mb-0">
                                    <strong><t t-esc="wizard.env.company.name"/></strong>
                                </p>
                                <p class="mb-0 text-muted" style="font-size:10px;">
                                    Printed: <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %H:%M')"/>
                                </p>
                            </div>
                        </div>

                        <!-- Aging Buckets Info Banner -->
                        <div class="row mb-3 text-center" style="font-size:11px;">
                            <div class="col-3">
                                <div class="border rounded p-2 bg-success text-white">
                                    <div class="fw-bold">Current (0–30 days)</div>
                                    <div><t t-esc="sym"/> <t t-esc="'%.2f' % totals['current']"/></div>
                                </div>
                            </div>
                            <div class="col-3">
                                <div class="border rounded p-2 bg-warning">
                                    <div class="fw-bold">31–60 Days</div>
                                    <div><t t-esc="sym"/> <t t-esc="'%.2f' % totals['days_31_60']"/></div>
                                </div>
                            </div>
                            <div class="col-3">
                                <div class="border rounded p-2 bg-danger text-white">
                                    <div class="fw-bold">61–90 Days</div>
                                    <div><t t-esc="sym"/> <t t-esc="'%.2f' % totals['days_61_90']"/></div>
                                </div>
                            </div>
                            <div class="col-3">
                                <div class="border rounded p-2" style="background:#6c1313;color:white;">
                                    <div class="fw-bold">Over 90 Days</div>
                                    <div><t t-esc="sym"/> <t t-esc="'%.2f' % totals['over_90']"/></div>
                                </div>
                            </div>
                        </div>

                        <!-- Summary aging table — one row per investor -->
                        <table class="table table-bordered table-sm">
                            <thead class="table-dark">
                                <tr>
                                    <th>Investor</th>
                                    <th class="text-end">Records</th>
                                    <th class="text-end">0–30 Days<br/><small>Current</small></th>
                                    <th class="text-end">31–60 Days</th>
                                    <th class="text-end">61–90 Days</th>
                                    <th class="text-end">91+ Days<br/><small>Overdue</small></th>
                                    <th class="text-end">Total Outstanding</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="aging_data" t-as="inv">
                                    <tr>
                                        <td>
                                            <strong><t t-esc="inv['investor'].name or '(No Investor)'"/></strong>
                                            <t t-if="inv['investor'].phone">
                                                <br/><small class="text-muted"><t t-esc="inv['investor'].phone"/></small>
                                            </t>
                                        </td>
                                        <td class="text-end"><t t-esc="inv['count']"/></td>
                                        <td class="text-end text-success fw-bold">
                                            <t t-if="inv['current']">
                                                <t t-esc="'%.2f' % inv['current']"/>
                                            </t>
                                            <t t-else="">—</t>
                                        </td>
                                        <td class="text-end" style="color:#856404;">
                                            <t t-if="inv['days_31_60']">
                                                <t t-esc="'%.2f' % inv['days_31_60']"/>
                                            </t>
                                            <t t-else="">—</t>
                                        </td>
                                        <td class="text-end text-danger">
                                            <t t-if="inv['days_61_90']">
                                                <t t-esc="'%.2f' % inv['days_61_90']"/>
                                            </t>
                                            <t t-else="">—</t>
                                        </td>
                                        <td class="text-end fw-bold" style="color:#6c1313;">
                                            <t t-if="inv['over_90']">
                                                <t t-esc="'%.2f' % inv['over_90']"/>
                                            </t>
                                            <t t-else="">—</t>
                                        </td>
                                        <td class="text-end fw-bold">
                                            <t t-esc="'%.2f' % inv['total']"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot class="fw-bold table-secondary">
                                <tr>
                                    <td>TOTAL</td>
                                    <td class="text-end"><t t-esc="totals['count']"/></td>
                                    <td class="text-end text-success">
                                        <t t-esc="'%.2f' % totals['current']"/>
                                    </td>
                                    <td class="text-end" style="color:#856404;">
                                        <t t-esc="'%.2f' % totals['days_31_60']"/>
                                    </td>
                                    <td class="text-end text-danger">
                                        <t t-esc="'%.2f' % totals['days_61_90']"/>
                                    </td>
                                    <td class="text-end" style="color:#6c1313;">
                                        <t t-esc="'%.2f' % totals['over_90']"/>
                                    </td>
                                    <td class="text-end">
                                        <t t-esc="sym"/> <t t-esc="'%.2f' % totals['total']"/>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>

                        <!-- Aging % breakdown -->
                        <t t-if="totals['total'] > 0">
                            <div class="mt-3" style="font-size:10px; color:#666;">
                                <strong>Aging Distribution:</strong>
                                Current: <t t-esc="'%.1f' % (totals['current'] / totals['total'] * 100)"/>%
                                &amp;nbsp;|&amp;nbsp;
                                31–60d: <t t-esc="'%.1f' % (totals['days_31_60'] / totals['total'] * 100)"/>%
                                &amp;nbsp;|&amp;nbsp;
                                61–90d: <t t-esc="'%.1f' % (totals['days_61_90'] / totals['total'] * 100)"/>%
                                &amp;nbsp;|&amp;nbsp;
                                91+d: <t t-esc="'%.1f' % (totals['over_90'] / totals['total'] * 100)"/>%
                            </div>
                        </t>
                    </div>
                </t>

                <!-- ══ PAGES 2+ — Detail per investor ══ -->
                <t t-foreach="aging_data" t-as="inv">
                    <t t-call="web.external_layout">
                        <div class="page">

                            <div class="row mb-3">
                                <div class="col-8">
                                    <h3 class="mb-0">
                                        <t t-esc="inv['investor'].name or '(No Investor)'"/>
                                    </h3>
                                    <p class="text-muted mb-0" style="font-size:10px;">
                                        <t t-if="inv['investor'].phone">
                                            Tel: <t t-esc="inv['investor'].phone"/>
                                            &amp;nbsp;|&amp;nbsp;
                                        </t>
                                        <t t-if="inv['investor'].email">
                                            Email: <t t-esc="inv['investor'].email"/>
                                        </t>
                                    </p>
                                </div>
                                <div class="col-4 text-end">
                                    <p class="mb-0 text-muted" style="font-size:10px;">
                                        As Of: <strong><t t-esc="wizard.as_of_date"/></strong>
                                    </p>
                                    <p class="mb-0">
                                        Total Outstanding:
                                        <strong><t t-esc="sym"/> <t t-esc="'%.2f' % inv['total']"/></strong>
                                    </p>
                                </div>
                            </div>

                            <!-- Investor KPI row -->
                            <div class="row text-center mb-3" style="font-size:11px;">
                                <div class="col-3">
                                    <div class="border rounded p-1 bg-success text-white">
                                        <div>0–30 Days</div>
                                        <div class="fw-bold"><t t-esc="'%.2f' % inv['current']"/></div>
                                    </div>
                                </div>
                                <div class="col-3">
                                    <div class="border rounded p-1 bg-warning">
                                        <div>31–60 Days</div>
                                        <div class="fw-bold"><t t-esc="'%.2f' % inv['days_31_60']"/></div>
                                    </div>
                                </div>
                                <div class="col-3">
                                    <div class="border rounded p-1 bg-danger text-white">
                                        <div>61–90 Days</div>
                                        <div class="fw-bold"><t t-esc="'%.2f' % inv['days_61_90']"/></div>
                                    </div>
                                </div>
                                <div class="col-3">
                                    <div class="border rounded p-1" style="background:#6c1313;color:white;">
                                        <div>91+ Days</div>
                                        <div class="fw-bold"><t t-esc="'%.2f' % inv['over_90']"/></div>
                                    </div>
                                </div>
                            </div>

                            <!-- Detail table for this investor -->
                            <table class="table table-sm table-bordered" style="font-size:10px;">
                                <thead class="table-secondary">
                                    <tr>
                                        <th>Reference</th>
                                        <th>Truck</th>
                                        <th>Period</th>
                                        <th>Status</th>
                                        <th class="text-end">Net Profit</th>
                                        <th class="text-end">Share %</th>
                                        <th class="text-end">Amount Due</th>
                                        <th class="text-end">Age (Days)</th>
                                        <th>Bucket</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="inv['records']" t-as="row">
                                        <tr t-attf-style="
                                            background-color: #{
                                                row['age_days'] > 90 and '#fce8e8' or
                                                row['age_days'] > 60 and '#fef3cd' or
                                                row['age_days'] > 30 and '#fff3e0' or
                                                '#e8f5e9'
                                            }">
                                            <td><t t-esc="row['record'].name"/></td>
                                            <td>
                                                <t t-esc="row['record'].truck_id.name or '-'"/>
                                                <t t-if="row['record'].truck_id.license_plate">
                                                    (<t t-esc="row['record'].truck_id.license_plate"/>)
                                                </t>
                                            </td>
                                            <td>
                                                <t t-esc="row['record'].period_start"/>
                                                →
                                                <t t-esc="row['record'].period_end"/>
                                            </td>
                                            <td>
                                                <t t-esc="dict(row['record'].fields_get(['state'])['state']['selection'])[row['record'].state]"/>
                                            </td>
                                            <td class="text-end">
                                                <t t-esc="'%.2f' % row['record'].net_profit"/>
                                            </td>
                                            <td class="text-end">
                                                <t t-esc="'%.1f' % row['record'].profit_share_rate"/>%
                                            </td>
                                            <td class="text-end fw-bold">
                                                <t t-esc="'%.2f' % row['amount']"/>
                                            </td>
                                            <td class="text-end">
                                                <t t-esc="row['age_days']"/>
                                            </td>
                                            <td>
                                                <t t-esc="row['bucket']"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                                <tfoot class="fw-bold table-light">
                                    <tr>
                                        <td colspan="6" class="text-end">Subtotal</td>
                                        <td class="text-end">
                                            <t t-esc="sym"/> <t t-esc="'%.2f' % inv['total']"/>
                                        </td>
                                        <td colspan="2"></td>
                                    </tr>
                                </tfoot>
                            </table>

                            <t t-if="inv['over_90'] > 0">
                                <div class="alert alert-danger mt-2" role="alert" style="font-size:10px;">
                                    <strong>Overdue:</strong>
                                    <t t-esc="sym"/> <t t-esc="'%.2f' % inv['over_90']"/>
                                    is more than 90 days past the period end date.
                                </div>
                            </t>

                        </div>
                    </t>
                </t>

            </t>
        </t>
    </template>

</odoo>
