<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_way4tech_vehicle_driver_assignment_form" model="ir.ui.view">
        <field name="name">way4tech.vehicle.driver.assignment.form</field>
        <field name="model">way4tech.vehicle.driver.assignment</field>
        <field name="arch" type="xml">
            <form string="Driver Assignment">
                <header>
                    <button name="action_mark_returned" type="object"
                            string="Mark as Returned" class="btn-primary"
                            invisible="return_date"/>
                    <field name="state" widget="statusbar" statusbar_visible="current,returned"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="display_name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Vehicle">
                            <field name="vehicle_id" options="{'no_create': True}"/>
                        </group>
                        <group string="Driver">
                            <field name="employee_id" options="{'no_create_edit': True}"/>
                            <field name="driver_name"
                                   invisible="employee_id"
                                   placeholder="Free-text name if not in HR"/>
                            <field name="driver_iqama"/>
                        </group>
                    </group>
                    <group>
                        <group string="Dates">
                            <field name="handover_date"/>
                            <field name="return_date"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_way4tech_vehicle_driver_assignment_list" model="ir.ui.view">
        <field name="name">way4tech.vehicle.driver.assignment.list</field>
        <field name="model">way4tech.vehicle.driver.assignment</field>
        <field name="arch" type="xml">
            <list string="Driver Assignments"
                  decoration-success="state == 'current'"
                  decoration-muted="state == 'returned'">
                <field name="vehicle_id"/>
                <field name="employee_id"/>
                <field name="driver_name" optional="hide"/>
                <field name="driver_iqama"/>
                <field name="handover_date"/>
                <field name="return_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'current'"
                       decoration-muted="state == 'returned'"/>
            </list>
        </field>
    </record>

    <record id="view_way4tech_vehicle_driver_assignment_search" model="ir.ui.view">
        <field name="name">way4tech.vehicle.driver.assignment.search</field>
        <field name="model">way4tech.vehicle.driver.assignment</field>
        <field name="arch" type="xml">
            <search>
                <field name="vehicle_id"/>
                <field name="employee_id"/>
                <field name="driver_iqama"/>
                <separator/>
                <filter string="Current" name="current" domain="[('state','=','current')]"/>
                <filter string="Returned" name="returned" domain="[('state','=','returned')]"/>
                <separator/>
                <filter string="Vehicle" name="group_vehicle" context="{'group_by': 'vehicle_id'}"/>
                <filter string="Driver" name="group_driver" context="{'group_by': 'employee_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_way4tech_vehicle_driver_assignment" model="ir.actions.act_window">
        <field name="name">Driver Assignments</field>
        <field name="res_model">way4tech.vehicle.driver.assignment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_way4tech_vehicle_driver_assignment_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Assign a driver to a vehicle</p>
            <p>
                Track which driver is holding each vehicle with handover and return dates.
                Only one driver can be "current" per vehicle at a time.
            </p>
        </field>
    </record>

</odoo>
