<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================
         CR2 G5 (19.0.2.9.0) — Manpower Contract Signature Request
         Skeptic amendment 1: menu parent = menu_way4tech_manpower
         (menu_manpower_root does NOT exist in this module).
         ================================================================ -->

    <record id="view_manpower_contract_signature_request_form" model="ir.ui.view">
        <field name="name">way4tech.manpower.contract.signature.request.form</field>
        <field name="model">way4tech.manpower.contract.signature.request</field>
        <field name="arch" type="xml">
            <form string="Signature Request">
                <header>
                    <button name="action_confirm_pending" type="object"
                            string="Send for Signature" class="btn-primary"
                            invisible="state != 'draft'"
                            help="Freeze the snapshot and lock the request until the manager decides."/>
                    <button name="action_approve" type="object"
                            string="Approve" class="btn-primary"
                            invisible="state != 'pending'"
                            groups="way4tech_logistics.group_logistics_manager"/>
                    <button name="action_cancel" type="object"
                            string="Cancel" class="btn-secondary"
                            invisible="state in ('approved', 'cancelled')"/>
                    <button name="action_reset_draft" type="object"
                            string="Reset to Draft" class="btn-secondary"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,pending,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="contract_id" readonly="state != 'draft'"/>
                            <field name="month" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="signed_by"/>
                            <field name="signed_date"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Optional — rejection reasons, cross-refs, etc."/>
                        </page>
                        <page string="Snapshot (Audit)" name="snapshot"
                              invisible="not snapshot_json">
                            <field name="snapshot_json" widget="text" readonly="1" nolabel="1"
                                   help="Captured at Send for Signature. Audit trail only — no restore-on-approve behaviour."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_manpower_contract_signature_request_list" model="ir.ui.view">
        <field name="name">way4tech.manpower.contract.signature.request.list</field>
        <field name="model">way4tech.manpower.contract.signature.request</field>
        <field name="arch" type="xml">
            <list string="Signature Requests"
                  decoration-info="state == 'draft'"
                  decoration-warning="state == 'pending'"
                  decoration-success="state == 'approved'"
                  decoration-muted="state == 'cancelled'">
                <field name="contract_id"/>
                <field name="month"/>
                <field name="state" widget="badge"/>
                <field name="signed_by"/>
                <field name="signed_date"/>
                <field name="create_uid" string="Submitted By"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_manpower_contract_signature_request_search" model="ir.ui.view">
        <field name="name">way4tech.manpower.contract.signature.request.search</field>
        <field name="model">way4tech.manpower.contract.signature.request</field>
        <field name="arch" type="xml">
            <search string="Signature Requests">
                <field name="contract_id"/>
                <field name="month"/>
                <separator/>
                <filter string="Draft" name="f_draft" domain="[('state','=','draft')]"/>
                <filter string="Pending" name="f_pending" domain="[('state','=','pending')]"/>
                <filter string="Approved" name="f_approved" domain="[('state','=','approved')]"/>
                <separator/>
                <filter string="Contract" name="g_contract" context="{'group_by':'contract_id'}"/>
                <filter string="Month" name="g_month" context="{'group_by':'month'}"/>
                <filter string="State" name="g_state" context="{'group_by':'state'}"/>
            </search>
        </field>
    </record>

    <!-- CR3-FINAL P12: THE approval area. Separate from the contract on
         purpose — the contract can only send a request and read its status;
         approving happens here, by a Logistics Manager. Opens on Pending so
         the approver sees their queue immediately. -->
    <record id="action_manpower_contract_signature_request" model="ir.actions.act_window">
        <field name="name">Approvals</field>
        <field name="res_model">way4tech.manpower.contract.signature.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_manpower_contract_signature_request_search"/>
        <field name="context">{'search_default_f_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing waiting for approval</p>
            <p>
                Monthly approval requests sent from Manpower Contracts land here.
                Approving one unlocks that contract-month's Create Invoice and
                Create Bill actions.
            </p>
        </field>
    </record>

    <menuitem id="menu_manpower_signature_request"
              name="Approvals"
              parent="menu_way4tech_manpower"
              action="action_manpower_contract_signature_request"
              groups="way4tech_logistics.group_logistics_manager"
              sequence="45"/>
</odoo>
