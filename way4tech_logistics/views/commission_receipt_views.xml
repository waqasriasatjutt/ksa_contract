<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================
         CB1 — Commissioning Business record (project header)
         =================================================== -->
    <record id="view_commission_receipt_form" model="ir.ui.view">
        <field name="name">way4tech.commission.receipt.form</field>
        <field name="model">way4tech.commission.receipt</field>
        <field name="arch" type="xml">
            <form string="Commissioning Business">
                <header>
                    <button name="action_open" type="object" string="Open"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_close" type="object" string="Close"
                            invisible="state != 'open'"
                            confirm="Close this record? The End Date will be set if blank."/>
                    <button name="action_reset_draft" type="object"
                            string="Reset to Draft" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,open,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_bills" type="object"
                                class="oe_stat_button" icon="fa-file-text-o"
                                invisible="bill_count == 0">
                            <field name="bill_count" widget="statinfo" string="Bills"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-list" disabled="1">
                            <field name="settlement_count" widget="statinfo" string="Settlements"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="auto: Subcontractor - Client - Month"/></h1>
                        <h3><field name="reference" readonly="1"/></h3>
                    </div>
                    <group>
                        <group string="Parties">
                            <field name="partner_id" readonly="state == 'closed'"/>
                            <field name="subcontractor_id" readonly="state == 'closed'"/>
                            <field name="client_po_id" readonly="state == 'closed'"/>
                            <field name="salesperson_id" readonly="state == 'closed'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Reference &amp; Basis">
                            <field name="start_date" readonly="state == 'closed'"/>
                            <field name="end_date" readonly="state == 'closed'"/>
                            <field name="period"/>
                            <label for="commission_percent" string="Commission Basis"/>
                            <div class="o_row">
                                <field name="commission_is_fix"/>
                                <span invisible="commission_is_fix">%</span>
                                <field name="commission_percent" invisible="commission_is_fix" nolabel="1"/>
                                <field name="commission_fix" invisible="not commission_is_fix" nolabel="1"/>
                            </div>
                        </group>
                    </group>
                    <group>
                        <group string="Dimensions">
                            <field name="way4tech_project_id"/>
                            <field name="way4tech_category_id"/>
                            <field name="tag_ids" widget="many2many_tags"/>
                        </group>
                        <group string="Analytic">
                            <field name="analytic_distribution" widget="analytic_distribution"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Settlements" name="settlements">
                            <field name="settlement_ids" context="{'default_receipt_id': id}">
                                <list string="Settlements">
                                    <field name="date"/>
                                    <field name="full_receipt_amount" sum="Received"/>
                                    <field name="receipt_excl_vat" optional="hide"/>
                                    <field name="commission_amount" sum="Commission"/>
                                    <field name="gross_payable" sum="Gross Payable"/>
                                    <field name="advance_recovered" optional="show"/>
                                    <field name="net_payable" sum="Net"/>
                                    <field name="bill_id" optional="show"/>
                                    <field name="voucher_number" optional="show"/>
                                    <field name="state" widget="badge"
                                        decoration-info="state == 'draft'"
                                        decoration-warning="state == 'billed'"
                                        decoration-success="state == 'paid'"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="total_receipt"/>
                                <field name="total_commission"/>
                                <field name="total_gross_payable"/>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_commission_receipt_list" model="ir.ui.view">
        <field name="name">way4tech.commission.receipt.list</field>
        <field name="model">way4tech.commission.receipt</field>
        <field name="arch" type="xml">
            <list string="Commissioning Records" decoration-muted="state == 'closed'">
                <field name="reference"/>
                <field name="name"/>
                <field name="subcontractor_id"/>
                <field name="partner_id"/>
                <field name="salesperson_id" optional="show"/>
                <field name="start_date"/>
                <field name="settlement_count"/>
                <field name="total_receipt" sum="Total Received"/>
                <field name="total_commission" sum="Total Commission"/>
                <field name="total_gross_payable" sum="Total Payable"/>
                <field name="state" widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-success="state == 'open'"
                    decoration-muted="state == 'closed'"/>
            </list>
        </field>
    </record>

    <record id="view_commission_receipt_search" model="ir.ui.view">
        <field name="name">way4tech.commission.receipt.search</field>
        <field name="model">way4tech.commission.receipt</field>
        <field name="arch" type="xml">
            <search string="Search Commissioning">
                <field name="reference"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="subcontractor_id"/>
                <field name="salesperson_id"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Open" name="open" domain="[('state','=','open')]"/>
                <filter string="Closed" name="closed" domain="[('state','=','closed')]"/>
                <separator/>
                <filter string="Subcontractor" name="group_sub" context="{'group_by': 'subcontractor_id'}"/>
                <filter string="Client" name="group_client" context="{'group_by': 'partner_id'}"/>
                <filter string="Salesperson" name="group_sp" context="{'group_by': 'salesperson_id'}"/>
                <filter string="Start Month" name="group_month" context="{'group_by': 'start_date:month'}"/>
            </search>
        </field>
    </record>

    <record id="action_commission_receipt" model="ir.actions.act_window">
        <field name="name">Commissioning Business</field>
        <field name="res_model">way4tech.commission.receipt</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_commission_receipt_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first Commissioning record</p>
            <p>One record per subcontractor and client. Add settlements over time;
               each settlement selects the client invoices, splits the ex-VAT into
               your commission and the subcontractor's 95%, bills it and pays it.</p>
        </field>
    </record>

</odoo>
