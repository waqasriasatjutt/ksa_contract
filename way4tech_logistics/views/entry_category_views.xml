<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="view_entry_category_list" model="ir.ui.view">
        <field name="name">way4tech.entry.category.list</field>
        <field name="model">way4tech.entry.category</field>
        <field name="arch" type="xml">
            <list string="Entry Categories" editable="top">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="apply_to"/>
                <field name="color" widget="color_picker"/>
                <field name="active" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_entry_category_form" model="ir.ui.view">
        <field name="name">way4tech.entry.category.form</field>
        <field name="model">way4tech.entry.category</field>
        <field name="arch" type="xml">
            <form string="Entry Category">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="apply_to"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="color" widget="color_picker"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_entry_category" model="ir.actions.act_window">
        <field name="name">Entry Categories</field>
        <field name="res_model">way4tech.entry.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Entry Category
            </p>
            <p>
                Categories are required on all accounting entries before posting.
                Manage them here — add, edit, or deactivate as needed.
            </p>
        </field>
    </record>

</odoo>
