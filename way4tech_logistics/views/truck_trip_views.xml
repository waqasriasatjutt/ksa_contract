<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================
         Truck Trip Form View
         =================================================== -->
    <record id="view_truck_trip_form" model="ir.ui.view">
        <field name="name">way4tech.truck.trip.form</field>
        <field name="model">way4tech.truck.trip</field>
        <field name="arch" type="xml">
            <form string="Truck Trip">
                <header>
                    <button name="action_confirm" type="object" string="Confirm"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_done" type="object" string="Mark Done"
                            class="btn-success" invisible="state != 'confirmed'"/>
                    <button name="action_create_invoice" type="object" string="Create Invoice"
                            class="btn-secondary"
                            invisible="state not in ('confirmed', 'done') or invoice_id != False"/>
                    <button name="action_post_trip_costs" type="object" string="Post Trip Costs"
                            class="btn-secondary"
                            invisible="state not in ('confirmed', 'done') or cost_move_id != False"
                            confirm="This will post driver salary, fuel and other costs as a journal entry. Continue?"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            class="btn-secondary" invisible="state in ('done', 'cancelled')"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            class="btn-secondary" invisible="state in ('draft', 'done')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoice" type="object"
                                class="oe_stat_button" icon="fa-file-text-o"
                                invisible="invoice_id == False">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Invoice</span>
                            </div>
                        </button>
                        <button name="action_view_cost_move" type="object"
                                class="oe_stat_button" icon="fa-book"
                                invisible="cost_move_id == False">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Cost Entry</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <group>
                        <group string="Trip Details">
                            <field name="truck_id"/>
                            <field name="client_id"/>
                            <field name="po_id"
                                   domain="[('client_id', '=', client_id), ('state', '!=', 'closed')]"
                                   help="Link to a Client PO for balance tracking. Only open POs for the selected client are shown."/>
                            <field name="trip_date"/>
                            <field name="trip_type"/>
                            <field name="driver_id"/>
                            <field name="driver_iqama_number" readonly="1"
                                   invisible="not driver_iqama_number"/>
                            <field name="salesperson_id"/>
                            <field name="analytic_account_id"/>
                        </group>
                        <group string="Route">
                            <field name="origin"/>
                            <field name="destination"/>
                            <field name="distance_km"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Revenue" name="revenue">
                            <group>
                                <group string="Revenue Basis">
                                    <field name="rental_type" widget="radio"/>
                                </group>
                            </group>
                            <!-- Hours × Rate -->
                            <group invisible="rental_type != 'hours'">
                                <group string="Client Billing (Hours)">
                                    <field name="standard_hours"/>
                                    <field name="hourly_rate"/>
                                    <field name="overtime_hours"/>
                                    <field name="overtime_rate"/>
                                </group>
                                <group string="Driver OT Pay">
                                    <field name="driver_overtime_rate"
                                           help="Driver's hourly OT rate — auto-fills Driver Overtime in Costs tab."/>
                                </group>
                            </group>
                            <!-- Per Trip × Rate -->
                            <group invisible="rental_type != 'per_trip'">
                                <group string="Client Billing (Per Trip)">
                                    <field name="trip_count" string="Number of Trips"/>
                                    <field name="rate_per_trip" string="Client Rate / Trip"/>
                                </group>
                                <group string="Driver Pay (Per Trip)">
                                    <field name="driver_rate_per_trip"
                                           help="Driver's rate per trip — auto-fills Driver Basic in Costs tab."/>
                                </group>
                            </group>
                            <group>
                                <group string="Revenue Amount">
                                    <field name="revenue" class="o_field_highlight"/>
                                </group>
                            </group>
                        </page>

                        <page string="Costs" name="costs">
                            <group>
                                <group string="Driver Costs">
                                    <field name="driver_basic"
                                           help="Auto-filled from Trip Count × Driver Rate when Revenue Basis = Per Trip."/>
                                    <field name="driver_rate_per_trip"
                                           invisible="rental_type != 'per_trip'"
                                           string="Driver Rate / Trip (used for auto-calc)"/>
                                    <field name="driver_overtime_amount"
                                           help="Auto-filled from Overtime Hours × Driver OT Rate when Revenue Basis = Hours."/>
                                    <field name="driver_overtime_rate"
                                           invisible="rental_type != 'hours'"
                                           string="Driver OT Rate / Hour (used for auto-calc)"/>
                                    <field name="driver_food_allowance"/>
                                    <field name="driver_cost" readonly="1" class="o_field_highlight"/>
                                </group>
                                <group string="Other Costs">
                                    <field name="fuel_cost" string="Fuel / Diesel"/>
                                    <field name="other_cost"/>
                                    <!-- 3rd-party hire cost (Middleman trips) -->
                                    <field name="third_party_vendor_id"
                                           invisible="trip_type != 'middleman'"/>
                                    <field name="third_party_cost"
                                           invisible="trip_type != 'middleman'"/>
                                    <field name="total_cost" readonly="1" class="o_field_highlight"/>
                                </group>
                            </group>
                            <group>
                                <group string="Profitability">
                                    <field name="gross_profit" readonly="1" class="o_field_highlight"
                                           decoration-danger="gross_profit &lt; 0"/>
                                </group>
                            </group>
                        </page>

                        <page string="Project Allocation" name="project_allocation"
                              invisible="rental_type != 'flat'">
                            <p class="text-muted">
                                Split this flat-rate period across multiple projects
                                (used when the same fleet serves different projects in one month).
                            </p>
                            <field name="project_allocation_ids">
                                <list editable="bottom">
                                    <field name="project_name"/>
                                    <field name="date_from"/>
                                    <field name="date_to"/>
                                    <field name="analytic_account_id" optional="show"/>
                                    <field name="notes" optional="hide"/>
                                </list>
                            </field>
                        </page>

                        <page string="Notes" name="notes">
                            <field name="notes" nolabel="1" colspan="2"/>
                        </page>
                    </notebook>

                    <field name="invoice_id" invisible="1"/>
                    <field name="cost_move_id" invisible="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ===================================================
         Truck Trip List View
         =================================================== -->
    <record id="view_truck_trip_list" model="ir.ui.view">
        <field name="name">way4tech.truck.trip.list</field>
        <field name="model">way4tech.truck.trip</field>
        <field name="arch" type="xml">
            <list string="Truck Trips">
                <field name="name"/>
                <field name="trip_date"/>
                <field name="truck_id"/>
                <field name="truck_license_plate" string="Plate #"/>
                <field name="client_id"/>
                <field name="po_id" optional="show"/>
                <field name="trip_type"/>
                <field name="driver_id"/>
                <field name="salesperson_id" optional="show"/>
                <field name="revenue" sum="Total Revenue"/>
                <field name="total_cost" sum="Total Cost" optional="show"/>
                <field name="gross_profit" sum="Total Gross Profit" optional="show"/>
                <field name="state" widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-warning="state == 'confirmed'"
                    decoration-success="state == 'done'"
                    decoration-muted="state == 'cancelled'"
                />
            </list>
        </field>
    </record>

    <!-- ===================================================
         Truck Trip Pivot View
         =================================================== -->
    <record id="view_truck_trip_pivot" model="ir.ui.view">
        <field name="name">way4tech.truck.trip.pivot</field>
        <field name="model">way4tech.truck.trip</field>
        <field name="arch" type="xml">
            <pivot string="Truck Trip Analysis">
                <field name="truck_id" type="row"/>
                <field name="client_id" type="row"/>
                <field name="trip_date" type="col" interval="month"/>
                <field name="revenue" type="measure"/>
                <field name="total_cost" type="measure"/>
                <field name="gross_profit" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- ===================================================
         Truck Trip Graph View
         =================================================== -->
    <record id="view_truck_trip_graph" model="ir.ui.view">
        <field name="name">way4tech.truck.trip.graph</field>
        <field name="model">way4tech.truck.trip</field>
        <field name="arch" type="xml">
            <graph string="Truck Trip Revenue vs Cost" type="bar">
                <field name="truck_id" type="row"/>
                <field name="revenue" type="measure"/>
                <field name="total_cost" type="measure"/>
                <field name="gross_profit" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ===================================================
         Truck Trip Search View
         =================================================== -->
    <record id="view_truck_trip_search" model="ir.ui.view">
        <field name="name">way4tech.truck.trip.search</field>
        <field name="model">way4tech.truck.trip</field>
        <field name="arch" type="xml">
            <search string="Search Trips">
                <field name="name"/>
                <field name="truck_id"/>
                <field name="client_id"/>
                <field name="driver_id"/>
                <field name="salesperson_id"/>
                <field name="po_id"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state','=','confirmed')]"/>
                <filter string="Done" name="done" domain="[('state','=','done')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state','=','cancelled')]"/>
                <separator/>
                <filter string="Truck" name="group_truck" context="{'group_by': 'truck_id'}"/>
                <filter string="Client" name="group_client" context="{'group_by': 'client_id'}"/>
                <filter string="Salesperson" name="group_salesperson" context="{'group_by': 'salesperson_id'}"/>
                <filter string="Trip Type" name="group_type" context="{'group_by': 'trip_type'}"/>
                <filter string="Trip Date" name="group_date" context="{'group_by': 'trip_date:month'}"/>
            </search>
        </field>
    </record>

    <!-- ===================================================
         Truck Trip Action
         =================================================== -->
    <record id="action_truck_trip" model="ir.actions.act_window">
        <field name="name">Truck Trips</field>
        <field name="res_model">way4tech.truck.trip</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="search_view_id" ref="view_truck_trip_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record your first Truck Trip</p>
            <p>
                Log trips per truck. Choose the revenue basis (manual, hours×rate, per-trip, or flat rate),
                break down driver costs (basic + overtime + food allowance), and link to a Client PO for balance tracking.
            </p>
        </field>
    </record>

</odoo>
