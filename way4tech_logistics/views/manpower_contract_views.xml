<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================
         Manpower Contract Form View
         =================================================== -->
    <record id="view_manpower_contract_form" model="ir.ui.view">
        <field name="name">way4tech.manpower.contract.form</field>
        <field name="model">way4tech.manpower.contract</field>
        <field name="arch" type="xml">
            <form string="Manpower Contract">
                <header>
                    <button
                        name="action_activate"
                        type="object"
                        string="Activate"
                        class="btn-primary"
                        invisible="state != 'draft'"
                    />
                    <button
                        name="action_create_invoice"
                        type="object"
                        string="Create Invoice"
                        class="btn-primary"
                        invisible="state != 'active'"
                    />
                    <!-- CR2 G5 (19.0.2.9.0): Send for Signature button -->
                    <button
                        name="action_send_for_signature"
                        type="object"
                        string="Send for Signature"
                        class="btn-secondary"
                        invisible="state == 'cancelled' or has_pending_approval"
                        help="Open a new monthly Signature Request. Manager must approve before Create Invoice / Create Bill will run for that month."/>
                    <button
                        name="action_complete"
                        type="object"
                        string="Complete"
                        class="btn-secondary"
                        invisible="state != 'active'"
                    />
                    <button
                        name="action_cancel"
                        type="object"
                        string="Cancel"
                        class="btn-danger"
                        invisible="state in ('completed', 'cancelled')"
                    />
                    <button
                        name="action_reset_draft"
                        type="object"
                        string="Reset to Draft"
                        class="btn-secondary"
                        invisible="state == 'draft' or state == 'completed'"
                    />
                    <button
                        name="action_view_invoices"
                        type="object"
                        string="View Invoices"
                        class="btn-secondary"
                        invisible="invoice_count == 0"
                    />
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,completed,cancelled"/>
                </header>
                <sheet>
                    <!-- CR2 G5 (19.0.2.9.0): expose has_pending_approval as
                         invisible so header button's invisible attr resolves. -->
                    <field name="has_pending_approval" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_invoices"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-pencil-square-o"
                            invisible="invoice_count == 0">
                            <field name="invoice_count" widget="statinfo" string="Invoiced"/>
                        </button>
                        <!-- CR2 G4 (19.0.2.8.0): 2 new smart buttons -->
                        <button
                            name="action_view_bills"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-file-o"
                            invisible="bill_count == 0">
                            <field name="bill_count" widget="statinfo" string="Vendor Bills"/>
                        </button>
                        <button
                            name="action_view_partner_ledger"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-book"
                            invisible="not client_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Customer</span>
                                <span class="o_stat_value">Statement</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Contract Name"/>
                        </h1>
                        <h4>
                            <field name="reference" readonly="1" nolabel="1"
                                   help="Auto-generated PRO/YYYY/MM/NNNN, monthly counter based on Start Date."/>
                        </h4>
                    </div>
                    <group>
                        <group string="Contract Details">
                            <field name="client_id" readonly="state != 'draft'"
                                   help="The client company or individual who has contracted your manpower services. Used as the customer on all invoices created from this contract."/>
                            <field name="po_id"
                                   domain="[('client_id', '=', client_id), ('state', '!=', 'closed')]"
                                   help="Link to a Client PO. Invoices from this contract count against the PO balance."/>
                            <field name="salesperson_id"
                                   help="Internal HR employee acting as salesperson on this contract."/>
                            <field name="commission_type"
                                   help="CR2 G3 — how the salesperson earns commission on this contract. Rate is looked up on Payroll &amp; Accounting Setup → Sales Person Commission Rules by employee. Percentage modes are gated: Actual Profit must be &gt; 0 for a payout."/>
                            <!-- Hidden per client request (kept in view as invisible so any
                                 code that references them keeps working; underlying DB
                                 columns are preserved so no data is lost). -->
                            <field name="contract_type" invisible="1"/>
                            <field name="billing_type" invisible="1"/>
                            <field name="fixed_amount" invisible="1"/>
                            <field name="hourly_rate" invisible="1"/>
                        </group>
                        <group string="Period &amp; Settings">
                            <field name="start_date" readonly="state != 'draft'"
                                   help="Contract start date. Informational — does not restrict when invoices can be created."/>
                            <field name="end_date" readonly="state in ('completed', 'cancelled')"
                                   help="Contract end date. When reached, manually click 'Complete' to close the contract. Leave blank for open-ended contracts."/>
                            <field name="analytic_distribution"
                                   widget="analytic_distribution"
                                   options="{'account_field': 'account_id'}"
                                   readonly="state != 'draft'"
                                   help="Split contract revenue across one or more analytic accounts. Each invoice + bill generated from this contract inherits this exact distribution — same widget/behaviour as on invoice lines."/>
                            <field name="way4tech_project_id"
                                   readonly="state != 'draft'"
                                   help="Reused from customer invoices / vendor bills. Propagates onto every generated invoice + bill."/>
                            <field name="way4tech_category_id"
                                   readonly="state != 'draft'"
                                   help="Reused from customer invoices / vendor bills (e.g. 'Manpower Revenue'). Propagates onto every generated invoice + bill."/>
                            <field name="tag_ids" widget="many2many_tags"
                                   options="{'no_create': True}"
                                   help="Contract Tags. Propagate onto every generated invoice + bill (way4tech_tag_ids on the header)."/>
                            <!-- Hidden per client request. Underlying data preserved. -->
                            <field name="company_id" invisible="1"/>
                            <field name="analytic_account_id" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Billing Summary">
                            <field name="total_hours" readonly="1"
                                   invisible="billing_type != 'hourly'"
                                   help="Sum of all hours logged in the Timesheets tab. Used for Hourly Rate billing: invoice amount = total_hours × hourly_rate. Read-only."/>
                            <field name="total_invoiced" readonly="1"
                                   help="Sum of untaxed amounts across all invoices linked to this contract (ex-VAT). Read-only — updated automatically as invoices are created."/>
                        </group>
                        <group string="Project Profitability" invisible="contract_type != 'project'">
                            <field name="total_project_expenses" readonly="1"
                                   help="Sum of all project expense lines (wages, accommodation, utilities, furniture, transport, other). Updated automatically."/>
                            <field name="project_margin" readonly="1" class="o_field_highlight"
                                   help="Project Margin = Total Invoiced − Total Project Expenses. Positive means the project is profitable. For full P&amp;L including individual employee salary costs tagged to this project, check the Analytic Report."/>
                        </group>
                    </group>
                    <!-- P8 (2026-07-15): three read-only summary cards.
                         All figures computed live from invoice_ids +
                         project_expense_ids + budget_line_ids. -->
                    <group col="6" class="oe_edit_only">
                        <group string="Billing Summary" colspan="2">
                            <field name="bs_total_invoiced" readonly="1"/>
                            <field name="bs_total_project_cgs" readonly="1"/>
                            <field name="bs_total_project_exp" readonly="1"/>
                            <field name="bs_total_budget_cost" readonly="1"/>
                            <field name="bs_total_actual_cost" readonly="1"/>
                            <field name="bs_remaining_budget" readonly="1"/>
                            <field name="bs_budget_variance" readonly="1"/>
                            <field name="bs_sales_person_commission" readonly="1"/>
                        </group>
                        <group string="Project Profitability" colspan="2">
                            <field name="pp_gross_profit" readonly="1"/>
                            <field name="pp_net_profit" readonly="1"/>
                            <field name="pp_budgeted_profit" readonly="1"/>
                            <field name="pp_actual_profit" readonly="1"/>
                            <field name="pp_profit_after_commission" readonly="1"/>
                        </group>
                        <group string="KPI %" colspan="2">
                            <field name="kpi_gross_margin" readonly="1" widget="percentage"/>
                            <field name="kpi_net_margin" readonly="1" widget="percentage"/>
                            <field name="kpi_cogs_pct" readonly="1" widget="percentage"/>
                            <field name="kpi_opex_pct" readonly="1" widget="percentage"/>
                            <field name="kpi_total_cost_pct" readonly="1" widget="percentage"/>
                            <field name="kpi_roc" readonly="1" widget="percentage"/>
                            <field name="kpi_budget_variance_pct" readonly="1" widget="percentage"/>
                            <field name="kpi_budget_usage_pct" readonly="1" widget="percentage"/>
                        </group>
                    </group>
                    <notebook>
                        <!-- 1. Project Income (P4) — one row per invoice-worthy revenue item.
                             Per-line Create Invoice button mints an account.move that inherits
                             the contract's analytic + project + category + tags + PRO reference. -->
                        <page string="Project Income" name="project_income">
                            <field name="income_line_ids" readonly="state == 'cancelled'"
                                   context="{'default_contract_id': id}">
                                <list editable="bottom" decoration-muted="state == 'invoiced'">
                                    <field name="accounting_date"/>
                                    <!-- inv_month hidden from list (2026-07-17): the non-stored
                                         compute re-rendered this neighbor cell on every accounting_date
                                         pick → row re-render bounced focus back into the picker → loop. -->
                                    <field name="inv_month" column_invisible="1"/>
                                    <field name="invoice_date"/>
                                    <field name="description"/>
                                    <field name="tag_ids" widget="many2many_tags"/>
                                    <field name="sale_account_id"/>
                                    <field name="quantity"/>
                                    <field name="price"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="state" widget="badge"
                                        decoration-info="state == 'draft'"
                                        decoration-success="state == 'invoiced'"/>
                                    <button name="action_create_invoice" type="object"
                                        string="Create Invoice" icon="fa-file-text-o"
                                        invisible="state == 'invoiced'"
                                        class="btn-sm btn-secondary"/>
                                    <!-- CR2 G4: parity View-Invoice button -->
                                    <button name="action_view_invoice" type="object"
                                        string="View Invoice" icon="fa-eye"
                                        invisible="state == 'draft'"
                                        class="btn-sm btn-secondary"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <!-- 2a. CR2 G2: Project Direct Cost — was 'Project Expenses'.
                             Kept the page name='project_expenses' so any downstream
                             view inheriting via xpath //page[@name='project_expenses']
                             still resolves. Direct Cost = COGS: worker wages, client
                             commission, transportation, equipment rent, building
                             rent, utility exp. Requires customer invoice first. -->
                        <page string="Project Direct Cost" name="project_expenses">
                            <div class="alert alert-info" role="alert">
                                <strong>Direct Cost (COGS) lines:</strong>
                                Worker wages, client commission, transportation, equipment rent,
                                building rent, utility exp. Each line creates a
                                <strong>Vendor Bill</strong> when you click <em>Create Bill</em>
                                and posts to <strong>COGS</strong> on the Billing Summary.
                                <br/><strong>Note:</strong> Direct Cost bills can only be
                                posted after the contract has at least one customer invoice
                                — the bill's Payment Reference is composed from the invoice number.
                            </div>
                            <field name="direct_cost_line_ids"
                                   readonly="state == 'cancelled'"
                                   context="{'default_contract_id': id, 'category_bucket_default': 'direct'}">
                                <list editable="bottom" decoration-muted="state == 'billed'">
                                    <field name="date" string="Accounting Date"/>
                                    <field name="bill_date"/>
                                    <field name="category_id"
                                           domain="[('expense_type', '=', 'direct')]"/>
                                    <field name="tag_ids" widget="many2many_tags" optional="show"/>
                                    <field name="description"/>
                                    <field name="vendor_id"/>
                                    <field name="account_id"
                                           help="GL expense account for this cost. Auto-filled from Payroll &amp; Accounting Setup based on expense category."/>
                                    <field name="amount" sum="Total"/>
                                    <field name="state" widget="badge"
                                        decoration-info="state == 'draft'"
                                        decoration-success="state == 'billed'"/>
                                    <button name="action_create_bill" type="object"
                                            string="Create Bill" icon="fa-file-text-o"
                                            invisible="state == 'billed'"
                                            class="btn-sm btn-secondary"/>
                                    <button name="action_view_bill" type="object"
                                            string="View Bill" icon="fa-eye"
                                            invisible="state == 'draft'"
                                            class="btn-sm btn-secondary"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <!-- 2b. CR2 G2: Project Operating Exp — new sibling tab.
                             OpEx: iqama, phone, fuel, refreshment, maintenance, safety,
                             mob/demob, chamber, utility, misc. NO customer-invoice
                             prerequisite; bills can be posted freely. -->
                        <page string="Project Operating Exp" name="project_operating_exp">
                            <div class="alert alert-info" role="alert">
                                <strong>Operating Exp lines:</strong>
                                Work permit &amp; iqama, telephone &amp; internet, fuel,
                                refreshment, vehicle/building/equipment maintenance,
                                uniform &amp; safety, mob &amp; demob, chamber, utility,
                                miscellaneous. Each line creates a
                                <strong>Vendor Bill</strong> when you click <em>Create Bill</em>
                                and posts to <strong>OpEx</strong> on the Billing Summary.
                                No customer-invoice prerequisite.
                            </div>
                            <field name="operating_exp_line_ids"
                                   readonly="state == 'cancelled'"
                                   context="{'default_contract_id': id, 'category_bucket_default': 'operating'}">
                                <list editable="bottom" decoration-muted="state == 'billed'">
                                    <field name="date" string="Accounting Date"/>
                                    <field name="bill_date"/>
                                    <field name="category_id"
                                           domain="[('expense_type', '=', 'operating')]"/>
                                    <field name="tag_ids" widget="many2many_tags" optional="show"/>
                                    <field name="description"/>
                                    <field name="vendor_id"/>
                                    <field name="account_id"
                                           help="GL expense account for this cost. Auto-filled from Payroll &amp; Accounting Setup based on expense category."/>
                                    <field name="amount" sum="Total"/>
                                    <field name="state" widget="badge"
                                        decoration-info="state == 'draft'"
                                        decoration-success="state == 'billed'"/>
                                    <button name="action_create_bill" type="object"
                                            string="Create Bill" icon="fa-file-text-o"
                                            invisible="state == 'billed'"
                                            class="btn-sm btn-secondary"/>
                                    <button name="action_view_bill" type="object"
                                            string="View Bill" icon="fa-eye"
                                            invisible="state == 'draft'"
                                            class="btn-sm btn-secondary"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <!-- 3. Timesheets (P6) — dual-mode: Way 1 (start+end+per_day) OR
                             Way 2 (date+hours). Amount computed accordingly. Per-line
                             Create Invoice button mirrors the Project Income flow. -->
                        <page string="Timesheets" name="timesheets">
                            <field name="timesheet_ids"
                                   readonly="state in ('completed', 'cancelled')"
                                   context="{'default_contract_id': id}">
                                <list editable="bottom" decoration-muted="state == 'invoiced'">
                                    <!-- Way 2: single date -->
                                    <field name="date"/>
                                    <!-- Way 1: range. Cross-readonly attrs were removed
                                         (were: readonly="start_date or end_date" etc.) — the
                                         attr recomputed on every onchange, and mid-edit
                                         readonly toggles bounced the date-picker into an
                                         infinite reopen loop. Mode-exclusivity is enforced
                                         at save time via _check_one_mode + onchange clears. -->
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="employee_id"/>
                                    <field name="description"/>
                                    <field name="hours" sum="Total Hours"/>
                                    <field name="rate"/>
                                    <field name="tag_ids" widget="many2many_tags" optional="show"/>
                                    <field name="per_day_hours" string="Per Day Allowed"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="state" widget="badge"
                                        decoration-info="state == 'draft'"
                                        decoration-success="state == 'invoiced'"/>
                                    <button name="action_create_invoice" type="object"
                                        string="Create Invoice" icon="fa-file-text-o"
                                        invisible="state == 'invoiced'"
                                        class="btn-sm btn-secondary"/>
                                    <!-- CR2 G4: parity View-Invoice button -->
                                    <button name="action_view_invoice" type="object"
                                        string="View Invoice" icon="fa-eye"
                                        invisible="state == 'draft'"
                                        class="btn-sm btn-secondary"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <!-- 4. Project Budget (P7) — Budget vs Actual per expense category.
                             Actual auto-sums posted journal items matching the contract's
                             analytic AND this line's expense_account. Status: ✅ / ⛔. -->
                        <page string="Project Budget" name="project_budget">
                            <field name="budget_line_ids" readonly="state == 'cancelled'"
                                   context="{'default_contract_id': id}">
                                <list editable="bottom">
                                    <field name="category_id" string="Expense Type"/>
                                    <field name="description"/>
                                    <field name="expense_account_id"/>
                                    <field name="budget_amount" sum="Total Budget"/>
                                    <field name="actual_amount" sum="Total Actual"/>
                                    <field name="remaining" sum="Total Remaining"/>
                                    <field name="status"/>
                                    <!-- CR2 G5: draft/confirmed approval state -->
                                    <field name="state" widget="badge"
                                        decoration-info="state == 'draft'"
                                        decoration-success="state == 'confirmed'"/>
                                    <button name="action_confirm" type="object"
                                            string="Confirm" icon="fa-check"
                                            invisible="state == 'confirmed'"
                                            class="btn-sm btn-secondary"
                                            help="CR2 G5: promote from draft — line will contribute to Total Budget / Actual on Billing Summary."/>
                                    <button name="action_reset_draft" type="object"
                                            string="Reset" icon="fa-undo"
                                            invisible="state == 'draft'"
                                            class="btn-sm btn-secondary"/>
                                    <!-- month hidden from list (2026-07-17): same picker-loop
                                         pattern as inv_month above — non-stored compute on date
                                         re-renders this cell on every pick → focus bounce. -->
                                    <field name="month" column_invisible="1"/>
                                    <field name="date"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <!-- 6. CR2 G3 (19.0.2.7.0): Sales Person Commission —
                             one row per commission payout. Amount auto-computes
                             via contract._get_commission_amount() honouring the
                             contract's commission_type + the employee's rate on
                             way4tech.commission.template. Percentage modes are
                             gated on Actual Profit > 0. -->
                        <page string="Sales Person Commission" name="sales_commission">
                            <div class="alert alert-info" role="alert">
                                <strong>Sales Person Commission lines:</strong>
                                One row per commission payout. Amount is auto-computed
                                from the contract's <em>Commission Type</em> and the
                                salesperson's rate on <strong>Payroll &amp; Accounting
                                Setup → Sales Person Commission Rules</strong>. Click
                                <em>Create Bill</em> to post the vendor bill.
                                <br/><strong>Note:</strong> percentage modes require
                                <em>Actual Profit</em> above zero — no profit, no
                                commission. Once the bill is posted the amount is
                                frozen so it can't drift from the GL.
                            </div>
                            <field name="commission_line_ids"
                                   readonly="state == 'cancelled'"
                                   context="{'default_contract_id': id}">
                                <list editable="bottom" decoration-muted="state == 'billed'">
                                    <field name="date" string="Accounting Date"/>
                                    <field name="bill_month" column_invisible="1"/>
                                    <field name="expense_type" readonly="1"/>
                                    <field name="tag_ids" widget="many2many_tags" optional="show"/>
                                    <field name="employee_id"/>
                                    <field name="description"/>
                                    <field name="vendor_id"/>
                                    <field name="account_id"
                                           help="GL expense account for this commission. Auto-filled from Payroll &amp; Accounting Setup → Sales Person Commission Rules."/>
                                    <field name="amount" sum="Total"/>
                                    <field name="state" widget="badge"
                                        decoration-info="state == 'draft'"
                                        decoration-success="state == 'billed'"/>
                                    <button name="action_create_bill" type="object"
                                            string="Create Bill" icon="fa-file-text-o"
                                            invisible="state == 'billed'"
                                            class="btn-sm btn-secondary"/>
                                    <button name="action_view_bill" type="object"
                                            string="View Bill" icon="fa-eye"
                                            invisible="state == 'draft'"
                                            class="btn-sm btn-secondary"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <!-- 7. CR2 G5 (19.0.2.9.0): monthly Signature Approvals -->
                        <page string="Approvals" name="signature_approvals">
                            <div class="alert alert-info" role="alert">
                                <strong>Monthly signature workflow:</strong>
                                click <em>Send for Signature</em> above to create a draft
                                request. Confirm the draft (state=pending) → manager approves
                                (state=approved) → the month's Create-Invoice / Create-Bill
                                buttons unlock for that month. Approval is per-month; other
                                months remain unaffected.
                            </div>
                            <field name="signature_request_ids">
                                <list decoration-info="state == 'draft'"
                                      decoration-warning="state == 'pending'"
                                      decoration-success="state == 'approved'"
                                      decoration-muted="state == 'cancelled'">
                                    <field name="month"/>
                                    <field name="state" widget="badge"/>
                                    <field name="signed_by"/>
                                    <field name="signed_date"/>
                                    <field name="create_uid" string="Submitted By"/>
                                    <field name="create_date"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <div class="alert alert-info" role="alert">
                        <strong>Accounting:</strong> The income account and sales journal for invoices
                        are set in <strong>Configuration → Payroll &amp; Accounting Setup → Manpower Contracts</strong>.
                        Set the analytic account above for cost-centre reporting on invoices.
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ===================================================
         Manpower Contract List View
         =================================================== -->
    <record id="view_manpower_contract_list" model="ir.ui.view">
        <field name="name">way4tech.manpower.contract.list</field>
        <field name="model">way4tech.manpower.contract</field>
        <field name="arch" type="xml">
            <list string="Manpower Contracts">
                <field name="name"/>
                <field name="client_id"/>
                <field name="salesperson_id" optional="show"/>
                <field name="contract_type"/>
                <field name="billing_type"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="total_hours" sum="Total Hours"/>
                <field name="state" widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-success="state == 'active'"
                    decoration-primary="state == 'completed'"
                    decoration-danger="state == 'cancelled'"
                />
            </list>
        </field>
    </record>

    <!-- ===================================================
         Manpower Contract Search View
         =================================================== -->
    <record id="view_manpower_contract_search" model="ir.ui.view">
        <field name="name">way4tech.manpower.contract.search</field>
        <field name="model">way4tech.manpower.contract</field>
        <field name="arch" type="xml">
            <search string="Search Manpower Contracts">
                <field name="name"/>
                <field name="client_id"/>
                <field name="salesperson_id"/>
                <separator/>
                <filter string="Active" name="active" domain="[('state','=','active')]"/>
                <filter string="Completed" name="completed" domain="[('state','=','completed')]"/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <separator/>
                <filter string="Food Delivery" name="food_delivery" domain="[('contract_type','=','food_delivery')]"/>
                <filter string="Project Based" name="project" domain="[('contract_type','=','project')]"/>
                <separator/>
                <filter string="Client" name="group_client" context="{'group_by': 'client_id'}"/>
                <filter string="Salesperson" name="group_salesperson" context="{'group_by': 'salesperson_id'}"/>
                <filter string="Contract Type" name="group_type" context="{'group_by': 'contract_type'}"/>
                <filter string="Billing Type" name="group_billing" context="{'group_by': 'billing_type'}"/>
            </search>
        </field>
    </record>

    <!-- ===================================================
         Manpower Contract Pivot View
         =================================================== -->
    <record id="view_manpower_contract_pivot" model="ir.ui.view">
        <field name="name">way4tech.manpower.contract.pivot</field>
        <field name="model">way4tech.manpower.contract</field>
        <field name="arch" type="xml">
            <pivot string="Manpower Contract Analysis">
                <field name="client_id" type="row"/>
                <field name="salesperson_id" type="row"/>
                <field name="contract_type" type="row"/>
                <field name="start_date" type="col" interval="month"/>
                <field name="total_hours" type="measure"/>
                <field name="total_invoiced" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- ===================================================
         Manpower Contract Graph View
         =================================================== -->
    <record id="view_manpower_contract_graph" model="ir.ui.view">
        <field name="name">way4tech.manpower.contract.graph</field>
        <field name="model">way4tech.manpower.contract</field>
        <field name="arch" type="xml">
            <graph string="Manpower Revenue by Client" type="bar">
                <field name="client_id" type="row"/>
                <field name="total_invoiced" type="measure"/>
                <field name="total_hours" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ===================================================
         Manpower Contract Action
         =================================================== -->
    <record id="action_manpower_contract" model="ir.actions.act_window">
        <field name="name">Manpower Contracts</field>
        <field name="res_model">way4tech.manpower.contract</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="search_view_id" ref="view_manpower_contract_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Manpower Contract
            </p>
            <p>
                Manage client manpower billing contracts with fixed price or hourly
                rate billing. Assign employees/freelancers and generate invoices.
            </p>
        </field>
    </record>

    <!-- ===================================================
         Employees shortcut action (Manpower → Employees menu)
         =================================================== -->
    <record id="action_employees_manpower" model="ir.actions.act_window">
        <field name="name">Employees</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first Employee</p>
            <p>
                Permanent staff hired under company sponsorship.
                Employees are linked to salary import lines for monthly salary posting.
            </p>
        </field>
    </record>

</odoo>
