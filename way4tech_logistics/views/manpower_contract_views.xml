<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================
         Manpower Contract Form View
         =================================================== -->
    <record id="view_manpower_contract_form" model="ir.ui.view">
        <field name="name">way4tech.manpower.contract.form</field>
        <field name="model">way4tech.manpower.contract</field>
        <field name="arch" type="xml">
            <form string="Manpower Contract">
                <header>
                    <button
                        name="action_activate"
                        type="object"
                        string="Activate"
                        class="btn-primary"
                        invisible="state != 'draft'"
                    />
                    <button
                        name="action_create_invoice"
                        type="object"
                        string="Create Invoice"
                        class="btn-primary"
                        invisible="state != 'active'"
                    />
                    <button
                        name="action_complete"
                        type="object"
                        string="Complete"
                        class="btn-secondary"
                        invisible="state != 'active'"
                    />
                    <button
                        name="action_cancel"
                        type="object"
                        string="Cancel"
                        class="btn-danger"
                        invisible="state in ('completed', 'cancelled')"
                    />
                    <button
                        name="action_reset_draft"
                        type="object"
                        string="Reset to Draft"
                        class="btn-secondary"
                        invisible="state == 'draft' or state == 'completed'"
                    />
                    <button
                        name="action_view_invoices"
                        type="object"
                        string="View Invoices"
                        class="btn-secondary"
                        invisible="invoice_count == 0"
                    />
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,completed,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_invoices"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-pencil-square-o"
                        >
                            <field name="invoice_count" widget="statinfo" string="Invoices"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Contract Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Contract Details">
                            <field name="client_id" readonly="state != 'draft'"
                                   help="The client company or individual who has contracted your manpower services. Used as the customer on all invoices created from this contract."/>
                            <field name="po_id"
                                   domain="[('client_id', '=', client_id), ('state', '!=', 'closed')]"
                                   help="Link to a Client PO. Invoices from this contract count against the PO balance."/>
                            <field name="salesperson_id"
                                   help="Internal HR employee acting as salesperson on this contract."/>
                            <!-- Hidden per client request (kept in view as invisible so any
                                 code that references them keeps working; underlying DB
                                 columns are preserved so no data is lost). -->
                            <field name="contract_type" invisible="1"/>
                            <field name="billing_type" invisible="1"/>
                            <field name="fixed_amount" invisible="1"/>
                            <field name="hourly_rate" invisible="1"/>
                        </group>
                        <group string="Period &amp; Settings">
                            <field name="start_date" readonly="state != 'draft'"
                                   help="Contract start date. Informational — does not restrict when invoices can be created."/>
                            <field name="end_date" readonly="state in ('completed', 'cancelled')"
                                   help="Contract end date. When reached, manually click 'Complete' to close the contract. Leave blank for open-ended contracts."/>
                            <field name="analytic_distribution"
                                   widget="analytic_distribution"
                                   options="{'account_field': 'account_id'}"
                                   readonly="state != 'draft'"
                                   help="Split contract revenue across one or more analytic accounts. Each invoice + bill generated from this contract inherits this exact distribution — same widget/behaviour as on invoice lines."/>
                            <field name="way4tech_project_id"
                                   readonly="state != 'draft'"
                                   help="Reused from customer invoices / vendor bills. Propagates onto every generated invoice + bill."/>
                            <field name="way4tech_category_id"
                                   readonly="state != 'draft'"
                                   help="Reused from customer invoices / vendor bills (e.g. 'Manpower Revenue'). Propagates onto every generated invoice + bill."/>
                            <!-- Hidden per client request. Underlying data preserved. -->
                            <field name="company_id" invisible="1"/>
                            <field name="analytic_account_id" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Billing Summary">
                            <field name="total_hours" readonly="1"
                                   invisible="billing_type != 'hourly'"
                                   help="Sum of all hours logged in the Timesheets tab. Used for Hourly Rate billing: invoice amount = total_hours × hourly_rate. Read-only."/>
                            <field name="total_invoiced" readonly="1"
                                   help="Sum of untaxed amounts across all invoices linked to this contract (ex-VAT). Read-only — updated automatically as invoices are created."/>
                        </group>
                        <group string="Project Profitability" invisible="contract_type != 'project'">
                            <field name="total_project_expenses" readonly="1"
                                   help="Sum of all project expense lines (wages, accommodation, utilities, furniture, transport, other). Updated automatically."/>
                            <field name="project_margin" readonly="1" class="o_field_highlight"
                                   help="Project Margin = Total Invoiced − Total Project Expenses. Positive means the project is profitable. For full P&amp;L including individual employee salary costs tagged to this project, check the Analytic Report."/>
                        </group>
                    </group>
                    <notebook>
                        <!-- 1. Project Income — placeholder tab; content defined in a later step. -->
                        <page string="Project Income" name="project_income">
                            <div class="alert alert-secondary" role="alert">
                                <em>Project Income lines will be added here in a later step.</em>
                            </div>
                        </page>
                        <!-- 2. Project Expenses — existing tab (unchanged). -->
                        <page string="Project Expenses" name="project_expenses">
                            <div class="alert alert-info" role="alert">
                                <strong>Project Cost Tracking:</strong>
                                Add each cost the company bears for this project — worker wages,
                                accommodation, utilities, furniture, transport, or other.
                                Each line creates a proper <strong>Vendor Bill</strong> (accounts payable)
                                when you click <em>Create Vendor Bill</em> on the line.
                                All bills are tagged with the contract's analytic distribution, project, and
                                entry category so the full project P&amp;L is visible in
                                <strong>Accounting → Reporting → Analytic Report</strong>.
                            </div>
                            <field name="project_expense_ids"
                                   readonly="state == 'cancelled'"
                                   context="{'default_contract_id': id}">
                                <list editable="bottom" decoration-muted="state == 'billed'">
                                    <field name="date"/>
                                    <field name="expense_type"/>
                                    <field name="description"/>
                                    <field name="vendor_id"/>
                                    <field name="account_id"
                                           help="GL expense account for this cost. Auto-filled from Payroll &amp; Accounting Setup based on expense type."/>
                                    <field name="amount" sum="Total"/>
                                    <field name="state" widget="badge"
                                        decoration-info="state == 'draft'"
                                        decoration-success="state == 'billed'"
                                    />
                                    <button
                                        name="action_create_bill"
                                        type="object"
                                        string="Create Bill"
                                        icon="fa-file-text-o"
                                        invisible="state == 'billed'"
                                        class="btn-sm btn-secondary"
                                    />
                                    <button
                                        name="action_view_bill"
                                        type="object"
                                        string="View Bill"
                                        icon="fa-eye"
                                        invisible="state == 'draft'"
                                        class="btn-sm btn-secondary"
                                    />
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <!-- 3. Timesheets — existing tab (unchanged, alert banner dropped since billing_type is now hidden). -->
                        <page string="Timesheets" name="timesheets">
                            <field name="timesheet_ids"
                                   readonly="state in ('completed', 'cancelled')"
                                   context="{'default_contract_id': id}"
                                   help="Hours worked log. Required for Hourly Rate billing — total hours × hourly rate = invoice amount. For Fixed Price contracts, timesheets are informational only.">
                                <list editable="bottom">
                                    <field name="date"
                                           help="Date the hours were worked."/>
                                    <field name="employee_id"
                                           help="Employee who worked these hours."/>
                                    <field name="description"
                                           help="Brief description of work performed on this day."/>
                                    <field name="hours" string="Hours"
                                           help="Number of hours worked. Summed into Total Hours on the contract header, which drives Hourly Rate invoicing."
                                           sum="Total Hours"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <!-- 4. Project Budget — placeholder tab; content defined in a later step. -->
                        <page string="Project Budget" name="project_budget">
                            <div class="alert alert-secondary" role="alert">
                                <em>Project Budget lines will be added here in a later step.</em>
                            </div>
                        </page>
                    </notebook>
                    <div class="alert alert-info" role="alert">
                        <strong>Accounting:</strong> The income account and sales journal for invoices
                        are set in <strong>Configuration → Payroll &amp; Accounting Setup → Manpower Contracts</strong>.
                        Set the analytic account above for cost-centre reporting on invoices.
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ===================================================
         Manpower Contract List View
         =================================================== -->
    <record id="view_manpower_contract_list" model="ir.ui.view">
        <field name="name">way4tech.manpower.contract.list</field>
        <field name="model">way4tech.manpower.contract</field>
        <field name="arch" type="xml">
            <list string="Manpower Contracts">
                <field name="name"/>
                <field name="client_id"/>
                <field name="salesperson_id" optional="show"/>
                <field name="contract_type"/>
                <field name="billing_type"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="total_hours" sum="Total Hours"/>
                <field name="state" widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-success="state == 'active'"
                    decoration-primary="state == 'completed'"
                    decoration-danger="state == 'cancelled'"
                />
            </list>
        </field>
    </record>

    <!-- ===================================================
         Manpower Contract Search View
         =================================================== -->
    <record id="view_manpower_contract_search" model="ir.ui.view">
        <field name="name">way4tech.manpower.contract.search</field>
        <field name="model">way4tech.manpower.contract</field>
        <field name="arch" type="xml">
            <search string="Search Manpower Contracts">
                <field name="name"/>
                <field name="client_id"/>
                <field name="salesperson_id"/>
                <separator/>
                <filter string="Active" name="active" domain="[('state','=','active')]"/>
                <filter string="Completed" name="completed" domain="[('state','=','completed')]"/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <separator/>
                <filter string="Food Delivery" name="food_delivery" domain="[('contract_type','=','food_delivery')]"/>
                <filter string="Project Based" name="project" domain="[('contract_type','=','project')]"/>
                <separator/>
                <filter string="Client" name="group_client" context="{'group_by': 'client_id'}"/>
                <filter string="Salesperson" name="group_salesperson" context="{'group_by': 'salesperson_id'}"/>
                <filter string="Contract Type" name="group_type" context="{'group_by': 'contract_type'}"/>
                <filter string="Billing Type" name="group_billing" context="{'group_by': 'billing_type'}"/>
            </search>
        </field>
    </record>

    <!-- ===================================================
         Manpower Contract Pivot View
         =================================================== -->
    <record id="view_manpower_contract_pivot" model="ir.ui.view">
        <field name="name">way4tech.manpower.contract.pivot</field>
        <field name="model">way4tech.manpower.contract</field>
        <field name="arch" type="xml">
            <pivot string="Manpower Contract Analysis">
                <field name="client_id" type="row"/>
                <field name="salesperson_id" type="row"/>
                <field name="contract_type" type="row"/>
                <field name="start_date" type="col" interval="month"/>
                <field name="total_hours" type="measure"/>
                <field name="total_invoiced" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- ===================================================
         Manpower Contract Graph View
         =================================================== -->
    <record id="view_manpower_contract_graph" model="ir.ui.view">
        <field name="name">way4tech.manpower.contract.graph</field>
        <field name="model">way4tech.manpower.contract</field>
        <field name="arch" type="xml">
            <graph string="Manpower Revenue by Client" type="bar">
                <field name="client_id" type="row"/>
                <field name="total_invoiced" type="measure"/>
                <field name="total_hours" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ===================================================
         Manpower Contract Action
         =================================================== -->
    <record id="action_manpower_contract" model="ir.actions.act_window">
        <field name="name">Manpower Contracts</field>
        <field name="res_model">way4tech.manpower.contract</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="search_view_id" ref="view_manpower_contract_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Manpower Contract
            </p>
            <p>
                Manage client manpower billing contracts with fixed price or hourly
                rate billing. Assign employees/freelancers and generate invoices.
            </p>
        </field>
    </record>

    <!-- ===================================================
         Employees shortcut action (Manpower → Employees menu)
         =================================================== -->
    <record id="action_employees_manpower" model="ir.actions.act_window">
        <field name="name">Employees</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first Employee</p>
            <p>
                Permanent staff hired under company sponsorship.
                Employees are linked to salary import lines for monthly salary posting.
            </p>
        </field>
    </record>

</odoo>
