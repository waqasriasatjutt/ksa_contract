<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================
         Investor Payable Statement — Report Action
         =================================================== -->
    <record id="action_report_investor_payable" model="ir.actions.report">
        <field name="name">Investor Payable Statement</field>
        <field name="model">way4tech.investor.payable</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">way4tech_logistics.report_investor_payable_doc</field>
        <field name="report_file">way4tech_logistics.report_investor_payable_doc</field>
        <field name="binding_model_id" ref="model_way4tech_investor_payable"/>
        <field name="binding_type">report</field>
    </record>

    <!-- ===================================================
         Investor Payable Statement — QWeb Template
         =================================================== -->
    <template id="report_investor_payable_doc">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="row mb-4">
                            <div class="col-6">
                                <h2>Investor Profit Statement</h2>
                                <p class="text-muted">
                                    <strong>Reference:</strong> <t t-esc="o.name"/><br/>
                                    <strong>Period:</strong> <t t-esc="o.period_start"/> to <t t-esc="o.period_end"/><br/>
                                </p>
                            </div>
                            <div class="col-6 text-end">
                                <span t-attf-class="badge #{o.state == 'paid' and 'bg-success' or o.state == 'confirmed' and 'bg-warning' or 'bg-secondary'} fs-6">
                                    <t t-esc="dict(o.fields_get(['state'])['state']['selection'])[o.state]"/>
                                </span>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-6">
                                <strong>Truck:</strong> <t t-esc="o.truck_id.name"/>
                                (<t t-esc="o.truck_id.license_plate"/>)<br/>
                                <strong>Vehicle Model:</strong> <t t-esc="o.truck_id.model or '-'"/>
                            </div>
                            <div class="col-6">
                                <strong>Investor:</strong>
                                <address>
                                    <t t-esc="o.investor_id.name or 'N/A'"/><br/>
                                    <t t-if="o.investor_id.street"><t t-esc="o.investor_id.street"/><br/></t>
                                </address>
                            </div>
                        </div>

                        <table class="table table-bordered">
                            <thead class="table-dark">
                                <tr>
                                    <th>Description</th>
                                    <th class="text-end">Amount (<t t-esc="o.currency_id.symbol"/>)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Total Revenue from Client</td>
                                    <td class="text-end"><t t-esc="'%.2f' % o.total_revenue"/></td>
                                </tr>
                                <tr>
                                    <td>Total Maintenance / Expenses</td>
                                    <td class="text-end">(<t t-esc="'%.2f' % o.total_expenses"/>)</td>
                                </tr>
                                <tr class="fw-bold">
                                    <td>Gross Profit</td>
                                    <td class="text-end"><t t-esc="'%.2f' % o.gross_profit"/></td>
                                </tr>
                                <tr>
                                    <td>Investor Share Rate</td>
                                    <td class="text-end"><t t-esc="'%.1f' % o.profit_share_rate"/>%</td>
                                </tr>
                                <tr class="table-warning fw-bold">
                                    <td>Amount Due to Investor</td>
                                    <td class="text-end"><t t-esc="'%.2f' % o.investor_amount"/></td>
                                </tr>
                                <tr>
                                    <td>Company Gross Share</td>
                                    <td class="text-end"><t t-esc="'%.2f' % o.company_gross"/></td>
                                </tr>
                                <tr>
                                    <td>Total Indirect Expenses</td>
                                    <td class="text-end"><t t-esc="'%.2f' % o.total_indirect"/></td>
                                </tr>
                                <tr class="table-success fw-bold">
                                    <td>Company Net Profit</td>
                                    <td class="text-end"><t t-esc="'%.2f' % o.company_net"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="row mt-4">
                            <div class="col-6">
                                <t t-if="o.bill_id">
                                    <strong>Vendor Bill:</strong> <t t-esc="o.bill_id.name"/><br/>
                                </t>
                                <t t-if="o.payment_date">
                                    <strong>Payment Date:</strong> <t t-esc="o.payment_date"/><br/>
                                </t>
                            </div>
                        </div>

                        <t t-if="o.notes">
                            <div class="mt-3">
                                <strong>Notes:</strong>
                                <p><t t-esc="o.notes"/></p>
                            </div>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
