<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="view_installment_schedule_list" model="ir.ui.view">
        <field name="name">way4tech.installment.schedule.list</field>
        <field name="model">way4tech.installment.schedule</field>
        <field name="arch" type="xml">
            <list string="Installment Schedule"
                  decoration-danger="state == 'overdue'"
                  decoration-warning="state == 'due'"
                  decoration-success="state == 'paid'"
                  decoration-muted="state == 'pending'">
                <field name="vehicle_id"/>
                <field name="installment_number" string="#"/>
                <field name="due_date"/>
                <field name="amount"/>
                <field name="paid_date" optional="show"/>
                <field name="state" widget="badge"/>
                <field name="move_id" optional="hide"/>
                <field name="note" optional="hide"/>
                <button name="action_pay" string="Pay" type="object"
                        icon="fa-money" invisible="state == 'paid'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_installment_schedule_form" model="ir.ui.view">
        <field name="name">way4tech.installment.schedule.form</field>
        <field name="model">way4tech.installment.schedule</field>
        <field name="arch" type="xml">
            <form string="Installment">
                <header>
                    <button name="action_pay" string="Record Payment"
                            type="object" class="btn-primary"
                            invisible="state == 'paid'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,due,overdue,paid"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="vehicle_id"/>
                            <field name="installment_number"/>
                            <field name="due_date"/>
                            <field name="amount"/>
                        </group>
                        <group>
                            <field name="paid_date" readonly="1"/>
                            <field name="move_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Note">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_installment_schedule" model="ir.actions.act_window">
        <field name="name">Installment Schedule</field>
        <field name="res_model">way4tech.installment.schedule</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_not_paid': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No installments yet</p>
            <p>Open a vehicle, tick "Purchased on Installment", and click
               "Generate Schedule" to auto-create all monthly payment lines.</p>
        </field>
    </record>

    <!-- Search View with filters -->
    <record id="view_installment_schedule_search" model="ir.ui.view">
        <field name="name">way4tech.installment.schedule.search</field>
        <field name="model">way4tech.installment.schedule</field>
        <field name="arch" type="xml">
            <search string="Installment Schedule">
                <field name="vehicle_id"/>
                <filter string="Overdue" name="filter_overdue"
                        domain="[('state', '=', 'overdue')]"/>
                <filter string="Due Soon" name="filter_due"
                        domain="[('state', '=', 'due')]"/>
                <filter string="Not Paid" name="filter_not_paid"
                        domain="[('state', '!=', 'paid')]"/>
                <filter string="Paid" name="filter_paid"
                        domain="[('state', '=', 'paid')]"/>
                <separator/>
                <filter string="By Vehicle" name="group_vehicle"
                        context="{'group_by': 'vehicle_id'}"/>
                <filter string="By Status" name="group_status"
                        context="{'group_by': 'state'}"/>
                <filter string="By Month" name="group_due_date"
                        context="{'group_by': 'due_date:month'}"/>
            </search>
        </field>
    </record>

</odoo>
