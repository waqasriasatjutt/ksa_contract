<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================
         Commission Receipt — Report Action
         =================================================== -->
    <record id="action_report_commission_receipt" model="ir.actions.report">
        <field name="name">Commission Receipt</field>
        <field name="model">way4tech.commission.receipt</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">way4tech_logistics.report_commission_receipt_doc</field>
        <field name="report_file">way4tech_logistics.report_commission_receipt_doc</field>
        <field name="binding_model_id" ref="model_way4tech_commission_receipt"/>
        <field name="binding_type">report</field>
    </record>

    <!-- ===================================================
         Commission Receipt — QWeb Template
         =================================================== -->
    <template id="report_commission_receipt_doc">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="row mb-4">
                            <div class="col-6">
                                <h2>Commission Receipt</h2>
                                <p class="text-muted">
                                    <strong>Reference:</strong> <t t-esc="o.name"/><br/>
                                    <strong>Date:</strong> <t t-esc="o.date"/><br/>
                                    <t t-if="o.period">
                                        <strong>Period:</strong> <t t-esc="o.period"/><br/>
                                    </t>
                                </p>
                            </div>
                            <div class="col-6 text-end">
                                <span t-attf-class="badge #{o.state == 'settled' and 'bg-success' or o.state == 'invoiced' and 'bg-primary' or o.state == 'confirmed' and 'bg-warning' or 'bg-secondary'} fs-6">
                                    <t t-esc="dict(o.fields_get(['state'])['state']['selection'])[o.state]"/>
                                </span>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-6">
                                <strong>Customer:</strong>
                                <address>
                                    <t t-esc="o.partner_id.name"/><br/>
                                    <t t-if="o.partner_id.street"><t t-esc="o.partner_id.street"/><br/></t>
                                    <t t-if="o.partner_id.city"><t t-esc="o.partner_id.city"/></t>
                                    <t t-if="o.partner_id.country_id"> — <t t-esc="o.partner_id.country_id.name"/></t>
                                </address>
                            </div>
                            <div class="col-6">
                                <strong>Subcontractor:</strong>
                                <address>
                                    <t t-esc="o.subcontractor_id.name"/><br/>
                                    <t t-if="o.subcontractor_id.street"><t t-esc="o.subcontractor_id.street"/><br/></t>
                                    <t t-if="o.subcontractor_id.city"><t t-esc="o.subcontractor_id.city"/></t>
                                </address>
                            </div>
                        </div>

                        <table class="table table-bordered">
                            <thead class="table-dark">
                                <tr>
                                    <th>Description</th>
                                    <th class="text-end">Amount (<t t-esc="o.currency_id.symbol"/>)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Full Receipt Amount (incl. VAT)</td>
                                    <td class="text-end"><t t-esc="'%.2f' % o.receipt_amount"/></td>
                                </tr>
                                <tr>
                                    <td>Receipt Amount (excl. <t t-esc="'%.0f' % o.vat_rate"/>% VAT)</td>
                                    <td class="text-end"><t t-esc="'%.2f' % o.receipt_excl_vat"/></td>
                                </tr>
                                <tr>
                                    <td>Commission (<t t-esc="'%.1f' % o.commission_rate"/>% of Ex-VAT Receipt)</td>
                                    <td class="text-end"><t t-esc="'%.2f' % o.commission_amount"/></td>
                                </tr>
                                <tr>
                                    <td>VAT on Commission (<t t-esc="'%.0f' % o.vat_rate"/>%)</td>
                                    <td class="text-end"><t t-esc="'%.2f' % o.vat_amount"/></td>
                                </tr>
                                <tr class="table-warning fw-bold">
                                    <td>Total Commission Invoice</td>
                                    <td class="text-end"><t t-esc="'%.2f' % o.total_invoice_amount"/></td>
                                </tr>
                                <tr class="table-success fw-bold">
                                    <td>Subcontractor Payable (Receipt − Commission Invoice)</td>
                                    <td class="text-end"><t t-esc="'%.2f' % o.subcontractor_payable"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="row mt-4">
                            <div class="col-6">
                                <t t-if="o.invoice_id">
                                    <strong>Commission Invoice:</strong> <t t-esc="o.invoice_id.name"/><br/>
                                </t>
                                <t t-if="o.subcontractor_bill_id">
                                    <strong>Subcontractor Bill:</strong> <t t-esc="o.subcontractor_bill_id.name"/><br/>
                                </t>
                            </div>
                            <div class="col-6">
                                <t t-if="o.is_paid_to_subcontractor">
                                    <span class="badge bg-success">Subcontractor Paid</span>
                                    <t t-if="o.subcontractor_payment_date">
                                        on <t t-esc="o.subcontractor_payment_date"/>
                                    </t>
                                </t>
                            </div>
                        </div>

                        <t t-if="o.notes">
                            <div class="mt-3">
                                <strong>Notes:</strong>
                                <p><t t-esc="o.notes"/></p>
                            </div>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
