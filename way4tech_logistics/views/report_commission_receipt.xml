<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================
         CB1 §9 — Subcontractor Payment Voucher (Receipt of Payment)
         Bound to the settlement. Company (AlZain Towers) comes from the
         external layout, so the letterhead already carries AlZain, not
         Way4Tech (CB1 §13 branding).
         =================================================== -->
    <record id="action_report_commissioning_voucher" model="ir.actions.report">
        <field name="name">Payment Voucher</field>
        <field name="model">way4tech.commission.settlement</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">way4tech_logistics.report_commissioning_voucher_doc</field>
        <field name="report_file">way4tech_logistics.report_commissioning_voucher_doc</field>
        <field name="binding_model_id" ref="model_way4tech_commission_settlement"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_commissioning_voucher_doc">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="row mb-3">
                            <div class="col-8">
                                <h2 class="mb-0"><t t-esc="o.company_id.name"/></h2>
                                <h4 class="text-muted">Receipt of Payment</h4>
                            </div>
                            <div class="col-4 text-end">
                                <strong>Voucher No:</strong> <t t-esc="o.voucher_number or '-'"/><br/>
                                <strong>Date:</strong> <t t-esc="o.date"/><br/>
                                <strong>Ref:</strong> <t t-esc="o.receipt_id.reference or ''"/>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-6">
                                <strong>Subcontractor:</strong> <t t-esc="o.subcontractor_id.name"/><br/>
                                <strong>Client:</strong> <t t-esc="o.partner_id.name"/>
                            </div>
                        </div>

                        <table class="table table-sm table-bordered">
                            <thead class="table-light"><tr><th>Calculation</th><th class="text-end">Amount</th></tr></thead>
                            <tbody>
                                <tr><td>Amount After VAT (received)</td><td class="text-end"><t t-esc="'%.2f' % o.full_receipt_amount"/></td></tr>
                                <tr><td>VAT (<t t-esc="'%.0f' % o.vat_rate"/>%)</td><td class="text-end"><t t-esc="'%.2f' % (o.full_receipt_amount - o.receipt_excl_vat)"/></td></tr>
                                <tr><td>Amount Before VAT</td><td class="text-end"><t t-esc="'%.2f' % o.receipt_excl_vat"/></td></tr>
                                <tr><td>Company Commission</td><td class="text-end"><t t-esc="'%.2f' % o.commission_amount"/></td></tr>
                                <tr class="fw-bold"><td>Net Amount (Subcontractor)</td><td class="text-end"><t t-esc="'%.2f' % o.gross_payable"/></td></tr>
                            </tbody>
                        </table>

                        <table class="table table-sm table-bordered">
                            <thead class="table-light"><tr><th>Adjustments</th><th class="text-end">Amount</th></tr></thead>
                            <tbody>
                                <tr><td>Advance Recovered / Deducted</td><td class="text-end"><t t-esc="'%.2f' % o.advance_recovered"/></td></tr>
                                <tr><td>Previous Outstanding</td><td class="text-end"><t t-esc="'%.2f' % o.previous_outstanding"/></td></tr>
                                <tr><td>Outstanding Paid</td><td class="text-end"><t t-esc="'%.2f' % o.outstanding_paid"/></td></tr>
                                <tr class="fw-bold table-success"><td>Net Amount Payable</td><td class="text-end"><t t-esc="'%.2f' % o.consolidated_payable"/></td></tr>
                            </tbody>
                        </table>

                        <h5 class="mt-3">Source of Funds</h5>
                        <table class="table table-sm table-bordered">
                            <thead class="table-light"><tr><th>Client Invoice</th><th>Date</th><th class="text-end">Allocated</th></tr></thead>
                            <tbody>
                                <tr t-foreach="o.allocation_ids" t-as="a">
                                    <td><t t-esc="a.invoice_id.name"/></td>
                                    <td><t t-esc="a.invoice_date"/></td>
                                    <td class="text-end"><t t-esc="'%.2f' % a.allocated_amount"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <h5 class="mt-3">Client Exposure (pending invoices)</h5>
                        <p>
                            <strong>Count:</strong> <t t-esc="o.client_pending_count"/> &#8226;
                            <strong>Total (incl VAT):</strong> <t t-esc="'%.2f' % o.client_pending_total"/> &#8226;
                            <strong>VAT:</strong> <t t-esc="'%.2f' % o.client_pending_vat"/><br/>
                            <t t-if="o.client_pending_names"><strong>Invoices:</strong> <t t-esc="o.client_pending_names"/></t>
                        </p>

                        <div class="row mt-5">
                            <div class="col-6">
                                <p>Receiver: ____________________</p>
                                <p><t t-esc="o.subcontractor_id.name"/></p>
                            </div>
                            <div class="col-6 text-end">
                                <p>For <t t-esc="o.company_id.name"/>: ____________________</p>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
