<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================
         CB1 §9 — Subcontractor Payment Voucher (Receipt of Payment)
         Bound to the settlement. Company (AlZain Towers) comes from the
         external layout, so the letterhead already carries AlZain, not
         Way4Tech (CB1 §13 branding).
         =================================================== -->
    <record id="action_report_commissioning_voucher" model="ir.actions.report">
        <field name="name">Payment Voucher</field>
        <field name="model">way4tech.commission.settlement</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">way4tech_logistics.report_commissioning_voucher_doc</field>
        <field name="report_file">way4tech_logistics.report_commissioning_voucher_doc</field>
        <field name="binding_model_id" ref="model_way4tech_commission_settlement"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_commissioning_voucher_doc">
        <!-- 2026-09-21 layout: the letterhead images print at the full printable
             width (the ATCO layout honours atco_full_width_letterhead; their
             vertical band is unchanged) and every table shares one column grid
             so the Amount edges line up. Figures and data untouched. -->
        <t t-set="atco_full_width_letterhead" t-value="True"/>
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page w4t-vch">
                        <style>
                            .w4t-vch table.table { width:100%; table-layout:fixed; margin-bottom:10px; }
                            .w4t-vch table.table th, .w4t-vch table.table td { padding:5px 8px; vertical-align:middle; overflow:hidden; }
                            .w4t-vch .col-label { width:70%; text-align:left; }
                            .w4t-vch .col-amt { width:30%; text-align:right; white-space:nowrap; }
                            .w4t-vch .col-inv { width:45%; text-align:left; }
                            .w4t-vch .col-date { width:25%; text-align:left; white-space:nowrap; }
                            .w4t-vch h5 { margin:8px 0 6px 0; }
                        </style>
                        <div class="row mb-3">
                            <div class="col-8">
                                <h2 class="mb-0"><t t-esc="o.company_id.name"/></h2>
                                <h4 class="text-muted">Receipt of Payment</h4>
                            </div>
                            <div class="col-4 text-end">
                                <strong>Voucher No:</strong> <t t-esc="o.voucher_number or '-'"/><br/>
                                <strong>Date:</strong> <t t-esc="o.date"/><br/>
                                <strong>Ref:</strong> <t t-esc="o.receipt_id.reference or ''"/>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-6">
                                <strong>Subcontractor:</strong> <t t-esc="o.subcontractor_id.name"/><br/>
                                <strong>Client:</strong> <t t-esc="o.partner_id.name"/>
                            </div>
                        </div>

                        <table class="table table-sm table-bordered">
                            <thead class="table-light"><tr><th class="col-label">Calculation</th><th class="col-amt">Amount</th></tr></thead>
                            <tbody>
                                <tr><td class="col-label">Amount After VAT (received)</td><td class="col-amt"><t t-esc="'%.2f' % o.full_receipt_amount"/></td></tr>
                                <tr><td class="col-label">VAT (<t t-esc="'%.0f' % o.vat_rate"/>%)</td><td class="col-amt"><t t-esc="'%.2f' % (o.full_receipt_amount - o.receipt_excl_vat)"/></td></tr>
                                <tr><td class="col-label">Amount Before VAT</td><td class="col-amt"><t t-esc="'%.2f' % o.receipt_excl_vat"/></td></tr>
                                <tr><td class="col-label">Company Commission</td><td class="col-amt"><t t-esc="'%.2f' % o.commission_amount"/></td></tr>
                                <tr class="fw-bold"><td class="col-label">Net Amount (Subcontractor)</td><td class="col-amt"><t t-esc="'%.2f' % o.gross_payable"/></td></tr>
                            </tbody>
                        </table>

                        <table class="table table-sm table-bordered">
                            <thead class="table-light"><tr><th class="col-label">Adjustments</th><th class="col-amt">Amount</th></tr></thead>
                            <tbody>
                                <tr><td class="col-label">Advance Recovered / Deducted</td><td class="col-amt"><t t-esc="'%.2f' % o.advance_recovered"/></td></tr>
                                <tr><td class="col-label">Previous Outstanding</td><td class="col-amt"><t t-esc="'%.2f' % o.previous_outstanding"/></td></tr>
                                <tr><td class="col-label">Outstanding Paid</td><td class="col-amt"><t t-esc="'%.2f' % o.outstanding_paid"/></td></tr>
                                <tr class="fw-bold table-success"><td class="col-label">Net Amount Payable</td><td class="col-amt"><t t-esc="'%.2f' % o.consolidated_payable"/></td></tr>
                            </tbody>
                        </table>

                        <h5 class="mt-3">Source of Funds</h5>
                        <table class="table table-sm table-bordered">
                            <thead class="table-light"><tr><th class="col-inv">Client Invoice</th><th class="col-date">Date</th><th class="col-amt">Allocated</th></tr></thead>
                            <tbody>
                                <tr t-foreach="o.allocation_ids" t-as="a">
                                    <td class="col-inv"><t t-esc="a.invoice_id.name"/></td>
                                    <td class="col-date"><t t-esc="a.invoice_date"/></td>
                                    <td class="col-amt"><t t-esc="'%.2f' % a.allocated_amount"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <h5 class="mt-3">Client Exposure (pending invoices)</h5>
                        <p>
                            <strong>Count:</strong> <t t-esc="o.client_pending_count"/> &#8226;
                            <strong>Total (incl VAT):</strong> <t t-esc="'%.2f' % o.client_pending_total"/> &#8226;
                            <strong>VAT:</strong> <t t-esc="'%.2f' % o.client_pending_vat"/><br/>
                            <t t-if="o.client_pending_names"><strong>Invoices:</strong> <t t-esc="o.client_pending_names"/></t>
                        </p>

                        <div class="row mt-5">
                            <div class="col-6">
                                <p>Receiver: ____________________</p>
                                <p><t t-esc="o.subcontractor_id.name"/></p>
                            </div>
                            <div class="col-6 text-end">
                                <p>For <t t-esc="o.company_id.name"/>: ____________________</p>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
