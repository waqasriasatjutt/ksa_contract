<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================
         Project Expense Form View
         =================================================== -->
    <record id="view_manpower_project_expense_form" model="ir.ui.view">
        <field name="name">way4tech.manpower.project.expense.form</field>
        <field name="model">way4tech.manpower.project.expense</field>
        <field name="arch" type="xml">
            <form string="Project Expense">
                <header>
                    <button
                        name="action_create_bill"
                        type="object"
                        string="Create Vendor Bill"
                        class="btn-primary"
                        invisible="state == 'billed'"
                        confirm="This will create a vendor bill for this expense and post it to Accounts Payable. Continue?"
                    />
                    <button
                        name="action_view_bill"
                        type="object"
                        string="View Vendor Bill"
                        class="btn-secondary"
                        invisible="state == 'draft'"
                    />
                    <field name="state" widget="statusbar" statusbar_visible="draft,billed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_bill"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-file-text-o"
                            invisible="not bill_id"
                        >
                            <div class="o_stat_info">
                                <span class="o_stat_text">Vendor Bill</span>
                            </div>
                        </button>
                    </div>
                    <group>
                        <group string="Details">
                            <field name="contract_id"
                                   help="The manpower project contract this expense belongs to."/>
                            <field name="date"
                                   help="Date of the expense. Used as the invoice date on the vendor bill."/>
                            <!-- CR5 item 3: show the ACTUAL category (Fuel,
                                 Refreshment, ...). The legacy Expense Type field
                                 sat at its 'Worker Wages' default on every record,
                                 so the standalone view read it wrong; category_id
                                 is the value the contract tabs actually set. -->
                            <field name="category_id"
                                   help="The KSA expense category for this line. Selecting it auto-fills the Expense Account from Payroll &amp; Accounting Setup."/>
                            <field name="description"
                                   help="Brief description, e.g. 'Monthly wages for 12 workers — March 2026' or 'Accommodation rent — Al Jubail site'."/>
                        </group>
                        <group string="Accounting">
                            <field name="vendor_id"
                                   help="The supplier or payee. Required to create the vendor bill. For worker wages, this can be a representative worker or a generic 'Project Workers' vendor."/>
                            <field name="account_id"
                                   help="GL expense account to debit on the vendor bill line. Auto-filled from Payroll &amp; Accounting Setup based on expense type. Override here if needed."/>
                            <field name="amount"
                                   help="Total amount of this expense. Used as the vendor bill line amount."/>
                            <field name="analytic_account_id" readonly="1"
                                   help="Inherited from the contract's analytic account. Applied to the vendor bill line so this cost appears in the project Analytic Report."/>
                            <field name="currency_id" invisible="1"/>
                            <field name="bill_id" readonly="1" invisible="not bill_id"
                                   help="Vendor bill created when 'Create Vendor Bill' is clicked. Read-only."/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        <strong>Accounting:</strong>
                        When you click <em>Create Vendor Bill</em>, a vendor bill is created:
                        <strong>Dr</strong> Expense Account /
                        <strong>Cr</strong> Accounts Payable (vendor).
                        The bill is tagged with the contract analytic account for project P&amp;L reporting.
                        Pay the bill through Accounting → Vendor Bills when you actually pay the vendor.
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ===================================================
         Project Expense List View
         =================================================== -->
    <record id="view_manpower_project_expense_list" model="ir.ui.view">
        <field name="name">way4tech.manpower.project.expense.list</field>
        <field name="model">way4tech.manpower.project.expense</field>
        <field name="arch" type="xml">
            <list string="Project Expenses">
                <field name="date"/>
                <field name="contract_id"/>
                <!-- CR5 item 4: Client column (optional toggle). -->
                <field name="client_id" optional="show"/>
                <!-- CR5 item 3: actual category, not the fixed 'Worker Wages'. -->
                <field name="category_id"/>
                <field name="description"/>
                <field name="vendor_id"/>
                <field name="account_id" optional="show"/>
                <field name="amount" sum="Total"/>
                <field name="analytic_account_id" optional="show"/>
                <field name="state" widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-success="state == 'billed'"
                />
            </list>
        </field>
    </record>

    <!-- ===================================================
         Project Expense Search View
         =================================================== -->
    <record id="view_manpower_project_expense_search" model="ir.ui.view">
        <field name="name">way4tech.manpower.project.expense.search</field>
        <field name="model">way4tech.manpower.project.expense</field>
        <field name="arch" type="xml">
            <search string="Search Project Expenses">
                <field name="description"/>
                <field name="contract_id"/>
                <!-- CR5 item 4: search by Client and Category. -->
                <field name="client_id"/>
                <field name="category_id"/>
                <field name="vendor_id"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Bill Created" name="billed" domain="[('state','=','billed')]"/>
                <separator/>
                <!-- CR5 items 3 &amp; 4: group by the REAL category and by client.
                     The former quick-filters and group-by were keyed to the legacy
                     Expense Type field (fixed at 'Worker Wages' on every record),
                     so they are replaced by the Category / Client group-bys. -->
                <filter string="Contract" name="group_contract" context="{'group_by': 'contract_id'}"/>
                <filter string="Client" name="group_client" context="{'group_by': 'client_id'}"/>
                <filter string="Category" name="group_category" context="{'group_by': 'category_id'}"/>
                <filter string="Month" name="group_month" context="{'group_by': 'date:month'}"/>
            </search>
        </field>
    </record>

    <!-- ===================================================
         Project Expense Pivot View
         =================================================== -->
    <record id="view_manpower_project_expense_pivot" model="ir.ui.view">
        <field name="name">way4tech.manpower.project.expense.pivot</field>
        <field name="model">way4tech.manpower.project.expense</field>
        <field name="arch" type="xml">
            <pivot string="Project Expense Analysis">
                <field name="contract_id" type="row"/>
                <!-- CR5 item 3: pivot rows by the actual category. -->
                <field name="category_id" type="row"/>
                <field name="date" type="col" interval="month"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- ===================================================
         CR7 item 1 (2026-07-30): combined READ-ONLY Project Expenses report
         (way4tech.manpower.project.expense.report — a SQL VIEW UNIONing project
         expenses + sales-person commission lines). The Project Expenses menu
         (action below) is repointed here so Sales Person Commission finally
         shows alongside the other categories. Additive: the project.expense
         list/pivot/search/form above are left intact (the form remains the
         model's default form); only the ACTION's target model + search change.
         Everything here is view-only — creation/editing stays on the contract.
         =================================================== -->
    <record id="view_manpower_project_expense_report_list" model="ir.ui.view">
        <field name="name">way4tech.manpower.project.expense.report.list</field>
        <field name="model">way4tech.manpower.project.expense.report</field>
        <field name="arch" type="xml">
            <list string="Project Expenses" create="false" edit="false" delete="false">
                <field name="date"/>
                <field name="contract_id"/>
                <field name="client_id" optional="show"/>
                <field name="category"/>
                <field name="description"/>
                <field name="employee_id" optional="hide"/>
                <field name="vendor_id"/>
                <field name="account_id" optional="show"/>
                <field name="amount" sum="Total"/>
                <field name="analytic_account_id" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-success="state == 'billed'"
                />
            </list>
        </field>
    </record>

    <record id="view_manpower_project_expense_report_pivot" model="ir.ui.view">
        <field name="name">way4tech.manpower.project.expense.report.pivot</field>
        <field name="model">way4tech.manpower.project.expense.report</field>
        <field name="arch" type="xml">
            <pivot string="Project Expense Analysis">
                <field name="client_id" type="row"/>
                <field name="category" type="row"/>
                <field name="date" type="col" interval="month"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_manpower_project_expense_report_search" model="ir.ui.view">
        <field name="name">way4tech.manpower.project.expense.report.search</field>
        <field name="model">way4tech.manpower.project.expense.report</field>
        <field name="arch" type="xml">
            <search string="Search Project Expenses">
                <field name="description"/>
                <field name="contract_id"/>
                <field name="client_id"/>
                <field name="category"/>
                <field name="vendor_id"/>
                <field name="employee_id"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Bill Created" name="billed" domain="[('state','=','billed')]"/>
                <separator/>
                <filter string="Sales Person Commission" name="only_commission" domain="[('source_model','=','commission')]"/>
                <filter string="Other Project Expenses" name="only_expense" domain="[('source_model','=','expense')]"/>
                <separator/>
                <filter string="Contract" name="group_contract" context="{'group_by': 'contract_id'}"/>
                <filter string="Client" name="group_client" context="{'group_by': 'client_id'}"/>
                <filter string="Category" name="group_category" context="{'group_by': 'category'}"/>
                <filter string="Month" name="group_month" context="{'group_by': 'date:month'}"/>
            </search>
        </field>
    </record>

    <record id="view_manpower_project_expense_report_form" model="ir.ui.view">
        <field name="name">way4tech.manpower.project.expense.report.form</field>
        <field name="model">way4tech.manpower.project.expense.report</field>
        <field name="arch" type="xml">
            <form string="Project Expense" create="false" edit="false" delete="false">
                <header>
                    <button name="action_open_contract" type="object"
                            string="Open Contract" class="btn-primary"
                            invisible="not contract_id"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,billed"/>
                </header>
                <sheet>
                    <group>
                        <group string="Details">
                            <field name="source_model" invisible="1"/>
                            <field name="contract_id"/>
                            <field name="client_id"/>
                            <field name="category"/>
                            <field name="employee_id" invisible="source_model != 'commission'"/>
                            <field name="date"/>
                            <field name="description"/>
                        </group>
                        <group string="Accounting">
                            <field name="vendor_id"/>
                            <field name="account_id"/>
                            <field name="amount"/>
                            <field name="analytic_account_id"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="bill_id" invisible="not bill_id"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        This is a read-only overview of every project expense and
                        sales-person commission. To add or edit a line, open the
                        contract.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ===================================================
         Project Expense Action  (repointed to the combined report — CR7 item 1)
         =================================================== -->
    <record id="action_manpower_project_expense" model="ir.actions.act_window">
        <field name="name">Project Expenses</field>
        <field name="res_model">way4tech.manpower.project.expense.report</field>
        <field name="view_mode">list,pivot,form</field>
        <field name="search_view_id" ref="view_manpower_project_expense_report_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No project expenses yet
            </p>
            <p>
                A combined, read-only view of every project cost per manpower
                contract — worker wages, accommodation, utilities, furniture,
                transport, client commission and sales-person commission.
                Add or edit lines on the contract itself.
            </p>
        </field>
    </record>

</odoo>
