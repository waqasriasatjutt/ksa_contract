<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================
         Project Expense Form View
         =================================================== -->
    <record id="view_manpower_project_expense_form" model="ir.ui.view">
        <field name="name">way4tech.manpower.project.expense.form</field>
        <field name="model">way4tech.manpower.project.expense</field>
        <field name="arch" type="xml">
            <form string="Project Expense">
                <header>
                    <button
                        name="action_create_bill"
                        type="object"
                        string="Create Vendor Bill"
                        class="btn-primary"
                        invisible="state == 'billed'"
                        confirm="This will create a vendor bill for this expense and post it to Accounts Payable. Continue?"
                    />
                    <button
                        name="action_view_bill"
                        type="object"
                        string="View Vendor Bill"
                        class="btn-secondary"
                        invisible="state == 'draft'"
                    />
                    <field name="state" widget="statusbar" statusbar_visible="draft,billed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_bill"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-file-text-o"
                            invisible="not bill_id"
                        >
                            <div class="o_stat_info">
                                <span class="o_stat_text">Vendor Bill</span>
                            </div>
                        </button>
                    </div>
                    <group>
                        <group string="Details">
                            <field name="contract_id"
                                   help="The manpower project contract this expense belongs to."/>
                            <field name="date"
                                   help="Date of the expense. Used as the invoice date on the vendor bill."/>
                            <field name="expense_type"
                                   help="Type determines the default GL expense account from Payroll &amp; Accounting Setup → Manpower Contracts → Project Expense Accounts."/>
                            <field name="description"
                                   help="Brief description, e.g. 'Monthly wages for 12 workers — March 2026' or 'Accommodation rent — Al Jubail site'."/>
                        </group>
                        <group string="Accounting">
                            <field name="vendor_id"
                                   help="The supplier or payee. Required to create the vendor bill. For worker wages, this can be a representative worker or a generic 'Project Workers' vendor."/>
                            <field name="account_id"
                                   help="GL expense account to debit on the vendor bill line. Auto-filled from Payroll &amp; Accounting Setup based on expense type. Override here if needed."/>
                            <field name="amount"
                                   help="Total amount of this expense. Used as the vendor bill line amount."/>
                            <field name="analytic_account_id" readonly="1"
                                   help="Inherited from the contract's analytic account. Applied to the vendor bill line so this cost appears in the project Analytic Report."/>
                            <field name="currency_id" invisible="1"/>
                            <field name="bill_id" readonly="1" invisible="not bill_id"
                                   help="Vendor bill created when 'Create Vendor Bill' is clicked. Read-only."/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        <strong>Accounting:</strong>
                        When you click <em>Create Vendor Bill</em>, a vendor bill is created:
                        <strong>Dr</strong> Expense Account /
                        <strong>Cr</strong> Accounts Payable (vendor).
                        The bill is tagged with the contract analytic account for project P&amp;L reporting.
                        Pay the bill through Accounting → Vendor Bills when you actually pay the vendor.
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ===================================================
         Project Expense List View
         =================================================== -->
    <record id="view_manpower_project_expense_list" model="ir.ui.view">
        <field name="name">way4tech.manpower.project.expense.list</field>
        <field name="model">way4tech.manpower.project.expense</field>
        <field name="arch" type="xml">
            <list string="Project Expenses">
                <field name="date"/>
                <field name="contract_id"/>
                <field name="expense_type"/>
                <field name="description"/>
                <field name="vendor_id"/>
                <field name="account_id" optional="show"/>
                <field name="amount" sum="Total"/>
                <field name="analytic_account_id" optional="show"/>
                <field name="state" widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-success="state == 'billed'"
                />
            </list>
        </field>
    </record>

    <!-- ===================================================
         Project Expense Search View
         =================================================== -->
    <record id="view_manpower_project_expense_search" model="ir.ui.view">
        <field name="name">way4tech.manpower.project.expense.search</field>
        <field name="model">way4tech.manpower.project.expense</field>
        <field name="arch" type="xml">
            <search string="Search Project Expenses">
                <field name="description"/>
                <field name="contract_id"/>
                <field name="vendor_id"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Bill Created" name="billed" domain="[('state','=','billed')]"/>
                <separator/>
                <filter string="Worker Wages" name="wages" domain="[('expense_type','=','worker_wages')]"/>
                <filter string="Accommodation" name="accommodation" domain="[('expense_type','=','accommodation')]"/>
                <filter string="Utilities" name="utilities" domain="[('expense_type','=','utilities')]"/>
                <filter string="Furniture" name="furniture" domain="[('expense_type','=','furniture')]"/>
                <separator/>
                <filter string="Contract" name="group_contract" context="{'group_by': 'contract_id'}"/>
                <filter string="Expense Type" name="group_type" context="{'group_by': 'expense_type'}"/>
                <filter string="Month" name="group_month" context="{'group_by': 'date:month'}"/>
            </search>
        </field>
    </record>

    <!-- ===================================================
         Project Expense Pivot View
         =================================================== -->
    <record id="view_manpower_project_expense_pivot" model="ir.ui.view">
        <field name="name">way4tech.manpower.project.expense.pivot</field>
        <field name="model">way4tech.manpower.project.expense</field>
        <field name="arch" type="xml">
            <pivot string="Project Expense Analysis">
                <field name="contract_id" type="row"/>
                <field name="expense_type" type="row"/>
                <field name="date" type="col" interval="month"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- ===================================================
         Project Expense Action
         =================================================== -->
    <record id="action_manpower_project_expense" model="ir.actions.act_window">
        <field name="name">Project Expenses</field>
        <field name="res_model">way4tech.manpower.project.expense</field>
        <field name="view_mode">list,pivot,form</field>
        <field name="search_view_id" ref="view_manpower_project_expense_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Record your first Project Expense
            </p>
            <p>
                Track project-level costs: worker wages, accommodation, utilities,
                furniture, transport and other expenses per manpower contract.
                Each expense creates a vendor bill for proper accounts payable tracking.
            </p>
        </field>
    </record>

</odoo>
