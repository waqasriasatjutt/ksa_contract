<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         CR3-FINAL Part A — the approval area.
         Approval is granted HERE and nowhere else. From a contract a user
         can only send a request and read its status.
         ================================================================ -->

    <record id="view_manpower_approval_request_form" model="ir.ui.view">
        <field name="name">way4tech.manpower.approval.request.form</field>
        <field name="model">way4tech.manpower.approval.request</field>
        <field name="arch" type="xml">
            <form string="Approval Request">
                <header>
                    <!-- CR3-FINAL round 5, issue 3: THREE finalise buttons. Per-row
                         Approve/Reject in the Items list only MARK provisionally;
                         the request stays open until one of these is pressed. -->
                    <button name="action_approve" type="object" string="Approve All"
                            class="btn-primary"
                            invisible="state != 'pending'"
                            groups="way4tech_logistics.group_logistics_manager"
                            help="Approve every row and close the request."/>
                    <button name="action_partially_approve" type="object"
                            string="Partially Approve" class="btn-primary"
                            invisible="state != 'pending'"
                            groups="way4tech_logistics.group_logistics_manager"
                            help="Commit the per-row Approve/Reject markings you made. Every row must be marked, and every rejected row needs a reason."/>
                    <button name="action_reject" type="object" string="Reject All"
                            class="btn-danger"
                            invisible="state != 'pending'"
                            groups="way4tech_logistics.group_logistics_manager"
                            help="Enter the Reason field first. Every row is returned to the requester."/>
                    <button name="action_open_sign_request" type="object"
                            string="Open Sign Document" class="btn-secondary"
                            invisible="not sign_request_id"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            class="btn-secondary"
                            invisible="state in ('consumed', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,partial,approved,consumed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <div class="alert alert-info" role="alert"
                         invisible="state != 'approved'">
                        Approved. The items below may now be created — <strong>once
                        each</strong>. As soon as an item is acted on its approval is
                        consumed; anything created afterwards, or any change to an
                        approved item, needs a fresh request.
                    </div>
                    <div class="alert alert-danger" role="alert"
                         invisible="state != 'rejected'">
                        <strong>Rejected.</strong> The items below are back with the
                        requester to correct and resend.
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="state != 'partial'">
                        <strong>Partly approved.</strong> Some rows were approved and
                        some rejected — see the Decision column below. Approved rows
                        can be created; rejected rows need correcting and resending.
                    </div>
                    <group>
                        <group>
                            <field name="contract_id" readonly="1"/>
                            <field name="requested_by" readonly="1"/>
                            <!-- item 7: any ONE of these may decide it -->
                            <field name="approver_ids" widget="many2many_tags"
                                   readonly="1"/>
                            <field name="approver_id" readonly="1"
                                   invisible="not approver_id"/>
                            <field name="urgent"
                                   readonly="state not in ('pending', 'partial')"/>
                        </group>
                        <group>
                            <field name="line_count" readonly="1"/>
                            <field name="decided_on" readonly="1"/>
                            <field name="sign_request_id" readonly="1"
                                   invisible="not sign_request_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Reason (required to reject)">
                        <field name="reason" nolabel="1"
                               readonly="state != 'pending'"
                               placeholder="Why is this being returned? The requester sees this."/>
                    </group>
                    <notebook>
                        <!-- CR3-FINAL round 5, issues 3 + 6b. Per-row Approve/Reject
                             only MARK provisionally (the badge in Decision changes);
                             nothing commits until a header button. Clean table:
                             Type · Item · Amount (right-aligned) · Decision · Reason
                             · actions, with column headers and even spacing. -->
                        <page string="Items Covered" name="items">
                            <div class="alert alert-info" role="alert"
                                 invisible="state != 'pending'">
                                Mark each row with its <strong>Approve</strong> or
                                <strong>Reject</strong> button (to reject, type the
                                <strong>Reason</strong> on that row first). These are
                                provisional — nothing is committed and the request
                                stays open until you press a header button:
                                <strong>Approve All</strong>,
                                <strong>Reject All</strong>, or
                                <strong>Partially Approve</strong> (commits your
                                row-by-row markings). You can leave and come back;
                                the request stays exactly as you left it.
                            </div>
                            <field name="line_ids"
                                   readonly="state != 'pending'">
                                <list create="0" delete="0" editable="bottom"
                                      decoration-muted="consumed"
                                      decoration-success="decision == 'approved'"
                                      decoration-danger="decision == 'rejected'">
                                    <field name="item_type" string="Type" readonly="1"/>
                                    <field name="description" string="Item" readonly="1"/>
                                    <field name="amount" string="Amount" readonly="1"
                                           sum="Total"/>
                                    <field name="decision" string="Decision"
                                           widget="badge" readonly="1"
                                           decoration-success="decision == 'approved'"
                                           decoration-danger="decision == 'rejected'"/>
                                    <field name="reason" string="Reason"
                                           readonly="decision == 'approved'"
                                           placeholder="Reason (required to reject)"/>
                                    <button name="action_approve_selected"
                                            type="object" string="Approve"
                                            icon="fa-check" class="btn-sm btn-success"
                                            invisible="decision == 'approved' or consumed"
                                            groups="way4tech_logistics.group_logistics_manager"/>
                                    <button name="action_reject_selected"
                                            type="object" string="Reject"
                                            icon="fa-times" class="btn-sm btn-danger"
                                            invisible="decision == 'rejected' or consumed"
                                            groups="way4tech_logistics.group_logistics_manager"/>
                                    <field name="consumed" string="Created"
                                           widget="boolean_toggle" readonly="1"
                                           optional="hide"/>
                                    <field name="res_model" column_invisible="1"/>
                                    <field name="res_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Note" name="note">
                            <field name="note" readonly="state != 'pending'"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_manpower_approval_request_list" model="ir.ui.view">
        <field name="name">way4tech.manpower.approval.request.list</field>
        <field name="model">way4tech.manpower.approval.request</field>
        <field name="arch" type="xml">
            <list string="Approvals"
                  decoration-warning="state == 'pending'"
                  decoration-success="state == 'approved'"
                  decoration-info="state == 'partial'"
                  decoration-danger="state == 'rejected'"
                  decoration-muted="state in ('consumed', 'cancelled')">
                <field name="name"/>
                <field name="contract_id"/>
                <field name="line_count" string="Items"/>
                <field name="requested_by"/>
                <field name="approver_ids" widget="many2many_tags" optional="show"/>
                <field name="approver_id" string="Decided By" optional="hide"/>
                <field name="urgent" optional="show"/>
                <field name="create_date" string="Requested"/>
                <field name="decided_on" optional="hide"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_manpower_approval_request_search" model="ir.ui.view">
        <field name="name">way4tech.manpower.approval.request.search</field>
        <field name="model">way4tech.manpower.approval.request</field>
        <field name="arch" type="xml">
            <search string="Approvals">
                <field name="name"/>
                <field name="contract_id"/>
                <field name="requested_by"/>
                <field name="approver_ids"/>
                <separator/>
                <filter string="Awaiting Me" name="f_mine"
                        domain="[('approver_ids', 'in', [uid]), ('state', 'in', ['pending','partial'])]"/>
                <filter string="Urgent" name="f_urgent" domain="[('urgent', '=', True)]"/>
                <separator/>
                <filter string="Pending" name="f_pending" domain="[('state','=','pending')]"/>
                <filter string="Partly Approved" name="f_partial" domain="[('state','=','partial')]"/>
                <filter string="Approved" name="f_approved" domain="[('state','=','approved')]"/>
                <filter string="Rejected" name="f_rejected" domain="[('state','=','rejected')]"/>
                <filter string="Consumed" name="f_consumed" domain="[('state','=','consumed')]"/>
                <separator/>
                <filter string="Contract" name="g_contract" context="{'group_by':'contract_id'}"/>
                <filter string="Status" name="g_state" context="{'group_by':'state'}"/>
                <filter string="Approver" name="g_approver" context="{'group_by':'approver_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_manpower_approval_request" model="ir.actions.act_window">
        <field name="name">Approvals</field>
        <field name="res_model">way4tech.manpower.approval.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_manpower_approval_request_search"/>
        <field name="context">{'search_default_f_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing waiting for approval</p>
            <p>
                Requests sent from Manpower Contracts land here. Approving one lets
                exactly the items it covers be created, once each. It never unlocks
                another contract, another item or a later month.
            </p>
        </field>
    </record>


    <!-- Send-for-Approval wizard -->
    <record id="view_manpower_approval_wizard_form" model="ir.ui.view">
        <field name="name">way4tech.manpower.approval.wizard.form</field>
        <field name="model">way4tech.manpower.approval.wizard</field>
        <field name="arch" type="xml">
            <form string="Send for Approval">
                <field name="contract_id" invisible="1"/>
                <field name="res_model" invisible="1"/>
                <field name="res_id" invisible="1"/>
                <field name="mode" invisible="1"/>
                <group>
                    <field name="approver_id" readonly="1"/>
                    <field name="urgent"/>
                    <field name="note" placeholder="Optional context for the approver…"/>
                </group>
                <notebook>
                    <page string="Pending" name="pending">
                        <div class="alert alert-info" role="status">
                            Tick the items to send, then <strong>Send Selected</strong>.
                            Send all, one, or any subset — now or later, in any
                            combination. The approver still decides in
                            <strong>Manpower → Approvals</strong>; approval covers
                            exactly the items sent, once each.
                        </div>
                        <separator string="Items needing approval"/>
                        <field name="pending_line_ids" nolabel="1">
                            <list editable="bottom" create="false" delete="false">
                                <field name="selected" widget="boolean_toggle" string="Send"/>
                                <field name="item_type" readonly="1"/>
                                <field name="item_name" readonly="1"/>
                                <field name="amount" sum="Total" readonly="1"/>
                                <field name="res_model" column_invisible="1"/>
                                <field name="res_id" column_invisible="1"/>
                            </list>
                        </field>
                        <separator string="Already awaiting a decision"/>
                        <field name="pending_request_ids" nolabel="1" readonly="1">
                            <list decoration-warning="state == 'pending'"
                                  decoration-info="state == 'partial'">
                                <field name="name"/>
                                <field name="line_count" string="Items"/>
                                <field name="requested_by"/>
                                <field name="create_date" string="Requested"/>
                                <field name="state" widget="badge"/>
                            </list>
                        </field>
                    </page>
                    <page string="Approved" name="approved">
                        <field name="approved_request_ids" nolabel="1" readonly="1">
                            <list decoration-success="state == 'approved'">
                                <field name="name"/>
                                <field name="line_count" string="Items"/>
                                <field name="approver_id" string="Decided By"/>
                                <field name="decided_on"/>
                                <field name="state" widget="badge"/>
                            </list>
                        </field>
                    </page>
                    <page string="Rejected" name="rejected">
                        <field name="rejected_request_ids" nolabel="1" readonly="1">
                            <list decoration-danger="state == 'rejected'">
                                <field name="name"/>
                                <field name="line_count" string="Items"/>
                                <field name="approver_id" string="Decided By"/>
                                <field name="decided_on"/>
                                <field name="state" widget="badge"/>
                            </list>
                        </field>
                    </page>
                    <page string="Consumed" name="consumed">
                        <field name="consumed_request_ids" nolabel="1" readonly="1">
                            <list decoration-muted="state in ('consumed', 'cancelled')">
                                <field name="name"/>
                                <field name="line_count" string="Items"/>
                                <field name="approver_id" string="Decided By"/>
                                <field name="decided_on"/>
                                <field name="state" widget="badge"/>
                            </list>
                        </field>
                    </page>
                    <page string="Orphaned" name="orphaned">
                        <div class="alert alert-warning" role="status">
                            Requests whose underlying item, invoice or bill was
                            deleted after approval. Kept for audit only — they never
                            sit in Pending and never block or unlock anything.
                        </div>
                        <field name="orphaned_request_ids" nolabel="1" readonly="1">
                            <list decoration-muted="state in ('consumed', 'cancelled')">
                                <field name="name"/>
                                <field name="line_count" string="Items"/>
                                <field name="requested_by"/>
                                <field name="create_date" string="Requested"/>
                                <field name="state" widget="badge"/>
                            </list>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button name="action_send" type="object"
                            string="Send Selected for Approval"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Close" class="btn-secondary" special="cancel"
                            data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
