<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add is_freelancer toggle to standard partner form (Sales & Purchase tab) -->
    <record id="view_partner_freelancer_flag" model="ir.ui.view">
        <field name="name">res.partner.freelancer.flag</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales_purchases']" position="inside">
                <group string="Freelancer">
                    <field name="is_freelancer" widget="boolean_toggle"
                           help="Enable to mark this vendor as a freelancer. They will appear in Manpower → Freelancers."/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- ── Freelancer List View ── -->
    <record id="view_freelancer_list" model="ir.ui.view">
        <field name="name">res.partner.freelancer.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Freelancers">
                <field name="name"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="is_freelancer" invisible="1"/>
            </list>
        </field>
    </record>

    <!-- ── Freelancer Search View ── -->
    <record id="view_freelancer_search" model="ir.ui.view">
        <field name="name">res.partner.freelancer.search</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search string="Search Freelancers">
                <field name="name" string="Name" filter_domain="[('name', 'ilike', self)]"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <separator/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <!-- ── Freelancer Action ── -->
    <record id="action_freelancer" model="ir.actions.act_window">
        <field name="name">Freelancers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_freelancer', '=', True)]</field>
        <field name="context">{'default_is_freelancer': True, 'default_supplier_rank': 1}</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_freelancer_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('base.view_partner_form')}),
        ]"/>
        <field name="search_view_id" ref="view_freelancer_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first Freelancer
            </p>
            <p>
                Freelancers are vendors engaged on a temporary or daily basis.
                Create them here or use <strong>Import</strong> to load from Excel.
                Once created, they can be assigned to salary import lines.
            </p>
        </field>
    </record>

    <!-- ── Employees Action (permanent staff via hr.employee) ── -->
    <record id="action_employees_manpower" model="ir.actions.act_window">
        <field name="name">Employees</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first Employee
            </p>
            <p>
                Permanent staff hired under company sponsorship.
                Employees are linked to salary import lines for monthly salary posting.
            </p>
        </field>
    </record>

</odoo>
