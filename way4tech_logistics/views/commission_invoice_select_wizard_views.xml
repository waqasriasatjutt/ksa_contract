<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_commission_invoice_select_wizard_form" model="ir.ui.view">
        <field name="name">way4tech.commission.invoice.select.wizard.form</field>
        <field name="model">way4tech.commission.invoice.select.wizard</field>
        <field name="arch" type="xml">
            <form string="Select Client Invoices">
                <field name="settlement_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <group>
                    <field name="partner_id" readonly="1"/>
                </group>
                <field name="line_ids">
                    <list string="Invoices" create="false" delete="false" editable="bottom">
                        <field name="selected" widget="boolean_toggle"/>
                        <!-- invoice_id must NOT be readonly: the web client omits
                             readonly x2many values on save, which dropped the
                             required invoice link and raised "Missing required
                             value". Writable = it round-trips reliably. -->
                        <field name="invoice_id" readonly="0"/>
                        <field name="invoice_date" readonly="1"/>
                        <field name="invoice_total" readonly="1"/>
                        <field name="received" readonly="1"/>
                        <field name="pending" readonly="1"/>
                        <field name="project" readonly="1"/>
                        <field name="currency_id" column_invisible="1"/>
                    </list>
                </field>
                <group class="oe_subtotal_footer">
                    <field name="selected_count"/>
                    <field name="selected_total"/>
                    <field name="selected_pending"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm Selection" class="btn-primary"/>
                    <!-- Fixes6 item 4 (2026-09): an object button, not
                         special="cancel". Opening this picker saves the
                         settlement, so a plain close left an empty ghost row
                         behind; action_cancel removes that row when it is still
                         completely untouched. -->
                    <button name="action_cancel" type="object" string="Cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
