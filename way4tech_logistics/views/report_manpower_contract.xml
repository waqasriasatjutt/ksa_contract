<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================
         Manpower Contract Statement — Report Action
         =================================================== -->
    <record id="action_report_manpower_contract" model="ir.actions.report">
        <field name="name">Manpower Contract Statement</field>
        <field name="model">way4tech.manpower.contract</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">way4tech_logistics.report_manpower_contract_doc</field>
        <field name="report_file">way4tech_logistics.report_manpower_contract_doc</field>
        <field name="binding_model_id" ref="model_way4tech_manpower_contract"/>
        <field name="binding_type">report</field>
    </record>

    <!-- ===================================================
         Manpower Contract Statement — QWeb Template
         =================================================== -->
    <template id="report_manpower_contract_doc">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">

                        <!-- Header -->
                        <div class="row mb-3">
                            <div class="col-8">
                                <h2>Manpower Contract Statement</h2>
                                <p class="text-muted mb-1">
                                    <strong>Contract:</strong> <t t-esc="o.name"/>
                                </p>
                                <p class="text-muted mb-0">
                                    <strong>Client:</strong> <t t-esc="o.client_id.name"/>&#160;&#160;
                                    <strong>Type:</strong> <t t-esc="dict(o._fields['contract_type'].selection).get(o.contract_type, o.contract_type)"/>&#160;&#160;
                                    <strong>Billing:</strong> <t t-esc="dict(o._fields['billing_type'].selection).get(o.billing_type, o.billing_type)"/>
                                </p>
                            </div>
                            <div class="col-4 text-right">
                                <span t-attf-class="badge #{
                                    'bg-secondary' if o.state == 'draft' else
                                    'bg-success' if o.state == 'active' else
                                    'bg-primary' if o.state == 'completed' else
                                    'bg-danger'
                                }" style="font-size:13px;padding:6px 14px">
                                    <t t-esc="dict(o._fields['state'].selection).get(o.state, o.state).upper()"/>
                                </span>
                            </div>
                        </div>

                        <!-- Contract Details -->
                        <div class="row mb-3">
                            <div class="col-6">
                                <table class="table table-sm" style="font-size:13px">
                                    <tbody>
                                        <tr>
                                            <td class="text-muted" style="width:45%">Start Date</td>
                                            <td><t t-esc="o.start_date"/></td>
                                        </tr>
                                        <tr>
                                            <td class="text-muted">End Date</td>
                                            <td><t t-esc="o.end_date or '—'"/></td>
                                        </tr>
                                        <t t-if="o.analytic_account_id">
                                            <tr>
                                                <td class="text-muted">Analytic Account</td>
                                                <td><t t-esc="o.analytic_account_id.name"/></td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                            <div class="col-6">
                                <table class="table table-sm" style="font-size:13px">
                                    <tbody>
                                        <t t-if="o.billing_type == 'fixed'">
                                            <tr>
                                                <td class="text-muted" style="width:55%">Fixed Monthly Amount</td>
                                                <td class="text-right">
                                                    <t t-esc="o.fixed_amount" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                                </td>
                                            </tr>
                                        </t>
                                        <t t-if="o.billing_type == 'hourly'">
                                            <tr>
                                                <td class="text-muted" style="width:55%">Hourly Rate</td>
                                                <td class="text-right">
                                                    <t t-esc="o.hourly_rate" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td class="text-muted">Total Hours Logged</td>
                                                <td class="text-right"><t t-esc="'%.2f' % o.total_hours"/> hrs</td>
                                            </tr>
                                        </t>
                                        <tr>
                                            <td class="text-muted">Total Invoiced</td>
                                            <td class="text-right">
                                                <t t-esc="o.total_invoiced" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="text-muted">Invoice Count</td>
                                            <td class="text-right"><t t-esc="o.invoice_count"/></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Assigned Manpower -->
                        <t t-if="o.line_ids">
                            <h4 style="border-bottom:2px solid #003366;padding-bottom:4px;color:#003366">Assigned Manpower</h4>
                            <table class="table table-sm table-bordered" style="font-size:12px">
                                <thead style="background:#003366;color:#fff">
                                    <tr>
                                        <th>#</th>
                                        <th>Employee</th>
                                        <th>Role</th>
                                        <th>Start</th>
                                        <th>End</th>
                                        <th class="text-right">Daily Cost</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="o.line_ids" t-as="line">
                                        <tr>
                                            <td><t t-esc="line_index + 1"/></td>
                                            <td><t t-esc="line.employee_id.name if line.employee_id else '—'"/></td>
                                            <td><t t-esc="line.role or '—'"/></td>
                                            <td><t t-esc="line.start_date or '—'"/></td>
                                            <td><t t-esc="line.end_date or '—'"/></td>
                                            <td class="text-right">
                                                <t t-esc="line.daily_cost" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>

                        <!-- Timesheets -->
                        <t t-if="o.timesheet_ids">
                            <h4 style="border-bottom:2px solid #003366;padding-bottom:4px;color:#003366;margin-top:16px">Timesheet Log</h4>
                            <table class="table table-sm table-bordered" style="font-size:12px">
                                <thead style="background:#003366;color:#fff">
                                    <tr>
                                        <th>Date</th>
                                        <th>Employee</th>
                                        <th>Description</th>
                                        <th class="text-right">Hours</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="o.timesheet_ids" t-as="ts">
                                        <tr>
                                            <td><t t-esc="ts.date"/></td>
                                            <td><t t-esc="ts.employee_id.name if ts.employee_id else '—'"/></td>
                                            <td><t t-esc="ts.description or '—'"/></td>
                                            <td class="text-right"><t t-esc="'%.2f' % ts.hours"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                                <tfoot>
                                    <tr style="font-weight:bold;background:#f5f5f5">
                                        <td colspan="3" class="text-right">Total Hours</td>
                                        <td class="text-right"><t t-esc="'%.2f' % o.total_hours"/></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </t>

                        <!-- Notes -->
                        <t t-if="o.notes">
                            <div class="mt-3">
                                <strong>Notes:</strong>
                                <p style="white-space:pre-line"><t t-esc="o.notes"/></p>
                            </div>
                        </t>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
