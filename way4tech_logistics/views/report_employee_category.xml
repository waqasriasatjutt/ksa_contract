<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_employee_category" model="ir.actions.report">
        <field name="name">Employee Category Report</field>
        <field name="model">way4tech.employee.category.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">way4tech_logistics.report_employee_category_template</field>
        <field name="report_file">way4tech_logistics.report_employee_category_template</field>
        <field name="binding_model_id" ref="model_way4tech_employee_category_report_wizard"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

    <template id="report_employee_category_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="wizard">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="row mb-4">
                            <div class="col-6">
                                <h3>Employee Category-wise Report</h3>
                                <p class="text-muted mb-0">
                                    Employee: <strong><t t-esc="wizard.employee_id.name"/></strong>
                                </p>
                                <p class="text-muted mb-0">
                                    Job Title: <t t-esc="wizard.employee_id.job_title or '—'"/>
                                </p>
                            </div>
                            <div class="col-6 text-end">
                                <p class="text-muted mb-0">
                                    Period: <strong>
                                        <t t-esc="wizard.date_from"/> — <t t-esc="wizard.date_to"/>
                                    </strong>
                                </p>
                                <p class="text-muted mb-0">
                                    Company: <t t-esc="wizard.company_id.name"/>
                                </p>
                                <p class="text-muted mb-0">
                                    Generated: <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y')"/>
                                </p>
                            </div>
                        </div>

                        <t t-set="rows" t-value="wizard.get_report_data()[0]"/>
                        <t t-set="grand_total" t-value="wizard.get_report_data()[1]"/>

                        <table class="table table-sm table-bordered o_main_table">
                            <thead>
                                <tr style="background-color:#2c7be5;color:white;">
                                    <th class="text-start">Category</th>
                                    <th class="text-center">Count</th>
                                    <th class="text-end">Total (SAR)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="rows" t-as="row">
                                    <tr>
                                        <td><t t-esc="row['category']"/></td>
                                        <td class="text-center">
                                            <t t-esc="row.get('count', '—')"/>
                                        </td>
                                        <td class="text-end">
                                            <t t-esc="'%.2f' % row['total']"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr style="font-weight:bold;background:#f8f9fa;">
                                    <td colspan="2">Grand Total</td>
                                    <td class="text-end">
                                        <t t-esc="'%.2f' % grand_total"/>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>

                        <p class="text-muted mt-3" style="font-size:11px;">
                            This report includes posted employee deductions and advance transactions
                            for the selected period.
                        </p>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
