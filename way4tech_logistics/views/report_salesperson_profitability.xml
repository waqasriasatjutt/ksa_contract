<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================
         Salesperson Profitability — Wizard View
         =================================================== -->
    <record id="view_salesperson_profitability_wizard_form" model="ir.ui.view">
        <field name="name">way4tech.salesperson.profitability.wizard.form</field>
        <field name="model">way4tech.salesperson.profitability.wizard</field>
        <field name="arch" type="xml">
            <form string="Salesperson Profitability Report">
                <group>
                    <group string="Date Range">
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group string="Filters">
                        <field name="salesperson_ids" widget="many2many_tags"/>
                    </group>
                </group>
                <footer>
                    <button
                        name="action_print_report"
                        type="object"
                        string="Print PDF"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ===================================================
         Salesperson Profitability — Window Action (opens wizard)
         =================================================== -->
    <record id="action_salesperson_profitability_wizard" model="ir.actions.act_window">
        <field name="name">Salesperson Profitability Report</field>
        <field name="res_model">way4tech.salesperson.profitability.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ===================================================
         Salesperson Profitability — Report Action (PDF)
         =================================================== -->
    <record id="action_report_salesperson_profitability" model="ir.actions.report">
        <field name="name">Salesperson Profitability Report</field>
        <field name="model">way4tech.salesperson.profitability.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">way4tech_logistics.report_salesperson_profitability_doc</field>
        <field name="report_file">way4tech_logistics.report_salesperson_profitability_doc</field>
    </record>

    <!-- ===================================================
         Salesperson Profitability — QWeb Template
         =================================================== -->
    <template id="report_salesperson_profitability_doc">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="wizard">
                <t t-set="rows"   t-value="wizard.get_report_data()"/>
                <t t-set="totals" t-value="wizard.get_grand_totals()"/>
                <t t-set="sym"    t-value="wizard.env.company.currency_id.symbol"/>
                <t t-call="web.external_layout">
                    <div class="page">

                        <!-- Header -->
                        <div class="row mb-4">
                            <div class="col-8">
                                <h2>Salesperson Profitability Report</h2>
                                <p class="text-muted mb-0">
                                    Period: <strong><t t-esc="wizard.date_from"/> — <t t-esc="wizard.date_to"/></strong>
                                </p>
                            </div>
                            <div class="col-4 text-end">
                                <p class="mb-0">Company: <strong><t t-esc="wizard.env.company.name"/></strong></p>
                                <p class="mb-0">Printed: <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %H:%M')"/></p>
                            </div>
                        </div>

                        <!-- Summary Table -->
                        <h4 style="border-bottom:2px solid #003366;padding-bottom:4px;color:#003366">Summary</h4>
                        <table class="table table-bordered mb-4" style="font-size:11px;">
                            <thead class="table-dark">
                                <tr>
                                    <th rowspan="2">Salesperson</th>
                                    <th colspan="4" class="text-center">Truck Trips</th>
                                    <th colspan="3" class="text-center">Manpower Contracts</th>
                                </tr>
                                <tr>
                                    <th class="text-end">Trips</th>
                                    <th class="text-end">Revenue (<t t-esc="sym"/>)</th>
                                    <th class="text-end">Cost (<t t-esc="sym"/>)</th>
                                    <th class="text-end">Profit (<t t-esc="sym"/>)</th>
                                    <th class="text-end">Contracts</th>
                                    <th class="text-end">Invoiced (<t t-esc="sym"/>)</th>
                                    <th class="text-end">Margin (<t t-esc="sym"/>)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="rows" t-as="row">
                                    <tr>
                                        <td><strong><t t-esc="row['salesperson_name']"/></strong></td>
                                        <td class="text-end"><t t-esc="row['trip_count']"/></td>
                                        <td class="text-end"><t t-esc="'%.2f' % row['trip_revenue']"/></td>
                                        <td class="text-end"><t t-esc="'%.2f' % row['trip_cost']"/></td>
                                        <td class="text-end"
                                            t-attf-style="color: #{row['trip_profit'] >= 0 and 'green' or 'red'}">
                                            <t t-esc="'%.2f' % row['trip_profit']"/>
                                        </td>
                                        <td class="text-end"><t t-esc="row['contract_count']"/></td>
                                        <td class="text-end"><t t-esc="'%.2f' % row['contract_invoiced']"/></td>
                                        <td class="text-end"
                                            t-attf-style="color: #{row['contract_margin'] >= 0 and 'green' or 'red'}">
                                            <t t-esc="'%.2f' % row['contract_margin']"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot class="fw-bold table-warning">
                                <tr>
                                    <td>GRAND TOTAL</td>
                                    <td class="text-end"><t t-esc="totals['trip_count']"/></td>
                                    <td class="text-end"><t t-esc="'%.2f' % totals['trip_revenue']"/></td>
                                    <td class="text-end"><t t-esc="'%.2f' % totals['trip_cost']"/></td>
                                    <td class="text-end"
                                        t-attf-style="color: #{totals['trip_profit'] >= 0 and 'green' or 'red'}">
                                        <t t-esc="'%.2f' % totals['trip_profit']"/>
                                    </td>
                                    <td class="text-end"><t t-esc="totals['contract_count']"/></td>
                                    <td class="text-end"><t t-esc="'%.2f' % totals['contract_invoiced']"/></td>
                                    <td class="text-end"
                                        t-attf-style="color: #{totals['contract_margin'] >= 0 and 'green' or 'red'}">
                                        <t t-esc="'%.2f' % totals['contract_margin']"/>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>

                    </div>
                </t>

                <!-- Detailed section per salesperson -->
                <t t-foreach="rows" t-as="row">
                    <t t-call="web.external_layout">
                        <div class="page" style="page-break-after: always;">

                            <h3 class="mb-1"><t t-esc="row['salesperson_name']"/></h3>

                            <!-- Trips detail -->
                            <t t-if="row['trips']">
                                <h5 style="color:#003366;margin-top:12px">Truck Trips</h5>
                                <table class="table table-sm table-bordered mb-3" style="font-size:10px;">
                                    <thead class="table-secondary">
                                        <tr>
                                            <th>Date</th>
                                            <th>Reference</th>
                                            <th>Truck</th>
                                            <th>Client</th>
                                            <th class="text-end">Revenue</th>
                                            <th class="text-end">Cost</th>
                                            <th class="text-end">Profit</th>
                                            <th class="text-end">Margin%</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="row['trips']" t-as="trip">
                                            <tr>
                                                <td><t t-esc="trip.trip_date"/></td>
                                                <td><t t-esc="trip.name"/></td>
                                                <td><t t-esc="trip.truck_id.name or '-'"/></td>
                                                <td><t t-esc="trip.client_id.name or '-'"/></td>
                                                <td class="text-end"><t t-esc="'%.2f' % trip.revenue"/></td>
                                                <td class="text-end"><t t-esc="'%.2f' % trip.total_cost"/></td>
                                                <td class="text-end"
                                                    t-attf-style="color: #{trip.gross_profit >= 0 and 'green' or 'red'}">
                                                    <t t-esc="'%.2f' % trip.gross_profit"/>
                                                </td>
                                                <td class="text-end">
                                                    <t t-esc="'%.1f' % (trip.gross_profit / trip.revenue * 100 if trip.revenue else 0)"/>%
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                    <tfoot class="fw-bold table-light">
                                        <tr>
                                            <td colspan="4" class="text-end">Subtotal</td>
                                            <td class="text-end"><t t-esc="'%.2f' % row['trip_revenue']"/></td>
                                            <td class="text-end"><t t-esc="'%.2f' % row['trip_cost']"/></td>
                                            <td class="text-end"
                                                t-attf-style="color: #{row['trip_profit'] >= 0 and 'green' or 'red'}">
                                                <t t-esc="'%.2f' % row['trip_profit']"/>
                                            </td>
                                            <td class="text-end"><t t-esc="'%.1f' % row['trip_margin_pct']"/>%</td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </t>

                            <!-- Contracts detail -->
                            <t t-if="row['contracts']">
                                <h5 style="color:#003366;margin-top:12px">Manpower Contracts</h5>
                                <table class="table table-sm table-bordered mb-3" style="font-size:10px;">
                                    <thead class="table-secondary">
                                        <tr>
                                            <th>Contract</th>
                                            <th>Client</th>
                                            <th>Type</th>
                                            <th>Billing</th>
                                            <th class="text-end">Invoiced</th>
                                            <th class="text-end">Expenses</th>
                                            <th class="text-end">Margin</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="row['contracts']" t-as="c">
                                            <tr>
                                                <td><t t-esc="c.name"/></td>
                                                <td><t t-esc="c.client_id.name or '-'"/></td>
                                                <td><t t-esc="c.contract_type or '-'"/></td>
                                                <td><t t-esc="c.billing_type or '-'"/></td>
                                                <td class="text-end"><t t-esc="'%.2f' % c.total_invoiced"/></td>
                                                <td class="text-end"><t t-esc="'%.2f' % c.total_project_expenses"/></td>
                                                <td class="text-end"
                                                    t-attf-style="color: #{c.project_margin >= 0 and 'green' or 'red'}">
                                                    <t t-esc="'%.2f' % c.project_margin"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                    <tfoot class="fw-bold table-light">
                                        <tr>
                                            <td colspan="4" class="text-end">Subtotal</td>
                                            <td class="text-end"><t t-esc="'%.2f' % row['contract_invoiced']"/></td>
                                            <td class="text-end"><t t-esc="'%.2f' % row['contract_expenses']"/></td>
                                            <td class="text-end"
                                                t-attf-style="color: #{row['contract_margin'] >= 0 and 'green' or 'red'}">
                                                <t t-esc="'%.2f' % row['contract_margin']"/>
                                            </td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </t>

                        </div>
                    </t>
                </t>

            </t>
        </t>
    </template>

</odoo>
