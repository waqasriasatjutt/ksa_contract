<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="view_cashflow_alert_form" model="ir.ui.view">
        <field name="name">way4tech.cashflow.alert.config.form</field>
        <field name="model">way4tech.cashflow.alert.config</field>
        <field name="arch" type="xml">
            <form string="Cash Flow Alert Configuration">
                <header>
                    <button name="action_send_now" string="Send Report Now"
                            type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group string="Company &amp; Recipients">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                            <field name="recipient_user_ids" widget="many2many_tags"/>
                            <field name="extra_emails"
                                   placeholder="owner@company.com, cfo@company.com"/>
                        </group>
                        <group string="Schedule">
                            <field name="frequency"/>
                            <p class="text-muted" colspan="2">
                                The cron job runs daily — the frequency setting controls
                                how often the report is actually sent (daily/weekly/monthly).
                                Use "Send Report Now" to trigger manually anytime.
                            </p>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_cashflow_alert_list" model="ir.ui.view">
        <field name="name">way4tech.cashflow.alert.config.list</field>
        <field name="model">way4tech.cashflow.alert.config</field>
        <field name="arch" type="xml">
            <list string="Cash Flow Alert Configs">
                <field name="company_id"/>
                <field name="active"/>
                <field name="frequency"/>
                <field name="extra_emails"/>
                <button name="action_send_now" string="Send Now"
                        type="object" icon="fa-paper-plane"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_cashflow_alert" model="ir.actions.act_window">
        <field name="name">Cash Flow Alerts</field>
        <field name="res_model">way4tech.cashflow.alert.config</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Set up your Cash Flow Alert
            </p>
            <p>
                Configure automatic daily/weekly financial summary emails
                (bank balances, receivable, payable) sent to the owner or managers.
            </p>
        </field>
    </record>

</odoo>
