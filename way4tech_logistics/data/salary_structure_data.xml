<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">

    <!-- ===================================================
         Salary Rule Categories — no company_id so they are shared across all branches
         =================================================== -->

    <record id="category_rider_earnings" model="hr.salary.rule.category">
        <field name="name">Rider Earnings</field>
        <field name="code">RIDER_EARN</field>
    </record>

    <record id="category_rider_deductions" model="hr.salary.rule.category">
        <field name="name">Rider Deductions</field>
        <field name="code">RIDER_DED_CAT</field>
    </record>

    <record id="category_rider_net" model="hr.salary.rule.category">
        <field name="name">Rider Net</field>
        <field name="code">RIDER_NET_CAT</field>
    </record>

    <!-- ===================================================
         Salary Rules — EARNINGS
         InputLine uses __getattr__ — must use dot notation: inputs.CODE
         inputs.CODE returns the hr.payslip.input record (truthy) if found,
         or 0.0 (falsy) if not found. Never use inputs['CODE'] or 'CODE' in inputs.
         =================================================== -->

    <record id="rule_rider_basic" model="hr.salary.rule">
        <field name="name">Basic Salary</field>
        <field name="code">RIDER_BASIC</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="category_rider_earnings"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = inputs.RIDER_BASIC_INPUT.amount if inputs.RIDER_BASIC_INPUT else 0.0</field>
        <field name="appears_on_payslip">True</field>
    </record>

    <record id="rule_rider_order_adj" model="hr.salary.rule">
        <field name="name">Order Adjustment</field>
        <field name="code">RIDER_ORDER_ADJ</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="category_rider_earnings"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = inputs.ORDER_ADJ.amount if inputs.ORDER_ADJ else 0.0</field>
        <field name="appears_on_payslip">True</field>
    </record>

    <record id="rule_rider_bonus" model="hr.salary.rule">
        <field name="name">Bonus</field>
        <field name="code">RIDER_BONUS_RULE</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="category_rider_earnings"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = inputs.RIDER_BONUS.amount if inputs.RIDER_BONUS else 0.0</field>
        <field name="appears_on_payslip">True</field>
    </record>

    <record id="rule_rider_petrol" model="hr.salary.rule">
        <field name="name">Petrol Allowance</field>
        <field name="code">RIDER_PETROL_RULE</field>
        <field name="sequence">40</field>
        <field name="category_id" ref="category_rider_earnings"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = inputs.RIDER_PETROL.amount if inputs.RIDER_PETROL else 0.0</field>
        <field name="appears_on_payslip">True</field>
    </record>

    <!-- ===================================================
         Salary Rules — PERFORMANCE DEDUCTIONS
         =================================================== -->

    <record id="rule_on_time_ded" model="hr.salary.rule">
        <field name="name">On-Time Deduction</field>
        <field name="code">ONTIME_DED_RULE</field>
        <field name="sequence">50</field>
        <field name="category_id" ref="category_rider_deductions"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = -(inputs.ONTIME_DED.amount if inputs.ONTIME_DED else 0.0)</field>
        <field name="appears_on_payslip">True</field>
