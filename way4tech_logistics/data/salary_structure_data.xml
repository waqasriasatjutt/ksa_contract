    <record id="rule_rider_net" model="hr.salary.rule">
        <field name="name">Net Salary</field>
        <field name="code">RIDER_NET</field>
        <field name="sequence">100</field>
        <field name="category_id" ref="category_rider_net"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = categories.RIDER_EARN + categories.RIDER_DED_CAT</field>
        <field name="appears_on_payslip">True</field>
    </record>

    <!-- ===================================================
         Salary Structure — no company_id: shared across all branch companies
         =================================================== -->

    <record id="structure_rider_payroll" model="hr.payroll.structure">
        <field name="name">Rider Payroll</field>
        <field name="code">RIDER</field>
        <field name="rule_ids" eval="[
            (6, 0, [
                ref('rule_rider_basic'),
                ref('rule_rider_order_adj'),
                ref('rule_rider_bonus'),
                ref('rule_rider_petrol'),
                ref('rule_on_time_ded'),
                ref('rule_food_dmg_ded'),
                ref('rule_miss_day_pen'),
                ref('rule_order_rej_ded'),
                ref('rule_misc_ded'),
                ref('rule_adv_ded'),
                ref('rule_fuel_ded'),
                ref('rule_sim_ded'),
                ref('rule_loan_ded'),
                ref('rule_traffic_ded'),
                ref('rule_rent_ded'),
                ref('rule_rider_net'),
            ])
        ]"/>
    </record>

