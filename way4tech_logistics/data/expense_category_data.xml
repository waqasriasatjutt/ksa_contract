<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Canonical KSA expense categories used by Project Expenses, Project
         Budget, and Payroll & Accounting Setup. Codes are stable identifiers
         used by code — do not rename after ship.

         CR2 G2 (19.0.2.6.0): each category now carries an `expense_type`
         bucket that decides which Project Expense tab it feeds on a Manpower
         Contract (Direct Cost vs Operating Exp). The Billing Summary CGS/OpEx
         split is driven by this field. For existing DBs (already-installed
         records — noupdate="1" blocks re-seeding), migrations/19.0.2.6.0/
         post-migration.py backfills expense_type per this same mapping. -->

    <!-- ============ DIRECT COST bucket (6 items) ============ -->
    <record id="expense_cat_worker_wages" model="way4tech.expense.category">
        <field name="code">worker_wages</field>
        <field name="name">Worker Wages</field>
        <field name="sequence">10</field>
        <field name="expense_type">direct</field>
    </record>
    <record id="expense_cat_commission_exp" model="way4tech.expense.category">
        <field name="code">commission_exp</field>
        <field name="name">Client Commission</field>
        <field name="sequence">20</field>
        <field name="expense_type">direct</field>
    </record>
    <record id="expense_cat_transportation" model="way4tech.expense.category">
        <field name="code">transportation</field>
        <field name="name">Transportation</field>
        <field name="sequence">30</field>
        <field name="expense_type">direct</field>
    </record>
    <record id="expense_cat_equipment_rent_exp" model="way4tech.expense.category">
