<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Monthly cron: auto-create investor payable records for the previous calendar month.
         Runs on the 1st of each month. Creates one draft record per active investor-owned
         truck, then calls action_compute_from_trips() to fill revenue and expenses. -->
    <record id="cron_auto_investor_payables" model="ir.cron">
        <field name="name">Way4Tech: Auto-Generate Monthly Investor Payables</field>
        <field name="model_id" ref="model_way4tech_investor_payable"/>
        <field name="state">code</field>
        <field name="code">model._auto_generate_monthly_payables()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">months</field>
        <field name="active">True</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="nextcall">2026-05-01 00:05:00</field>
    </record>

    <!-- Daily cron: send cash flow summary emails to configured recipients. -->
    <record id="cron_cashflow_alerts" model="ir.cron">
        <field name="name">Way4Tech: Daily Cash Flow Alert Email</field>
        <field name="model_id" ref="model_way4tech_cashflow_alert_config"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_cashflow_reports()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="nextcall">2026-04-03 08:00:00</field>
    </record>

    <!-- Weekly cron: send installment due/overdue reminders to managers. -->
    <record id="cron_installment_reminders" model="ir.cron">
        <field name="name">Way4Tech: Weekly Installment Due Reminders</field>
        <field name="model_id" ref="model_way4tech_installment_schedule"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_due_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field name="active">True</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="nextcall">2026-04-07 08:00:00</field>
    </record>

    <!-- Monthly cron: auto-post due asset depreciation lines. -->
    <record id="cron_asset_depreciation" model="ir.cron">
        <field name="name">Way4Tech: Monthly Asset Depreciation Posting</field>
        <field name="model_id" ref="model_way4tech_asset_register"/>
        <field name="state">code</field>
        <field name="code">model._cron_post_monthly_depreciation()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">months</field>
        <field name="active">True</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="nextcall">2026-05-01 00:10:00</field>
    </record>

</odoo>
