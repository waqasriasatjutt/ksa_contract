<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="param_wt_otp_enabled" model="ir.config_parameter">
            <field name="key">wt_whatsapp_otp.enabled</field>
            <field name="value">False</field>
        </record>

        <record id="param_wt_whatsapp_token" model="ir.config_parameter">
            <field name="key">wt_whatsapp_otp.token</field>
            <field name="value"></field>
        </record>

        <record id="param_wt_whatsapp_phone_id" model="ir.config_parameter">
            <field name="key">wt_whatsapp_otp.phone_id</field>
            <field name="value"></field>
        </record>

        <record id="param_wt_otp_template" model="ir.config_parameter">
            <field name="key">wt_whatsapp_otp.otp_template</field>
            <field name="value">phone_otp</field>
        </record>

        <record id="param_wt_otp_expiry_minutes" model="ir.config_parameter">
            <field name="key">wt_whatsapp_otp.expiry_minutes</field>
            <field name="value">10</field>
        </record>

    </data>
</odoo>
